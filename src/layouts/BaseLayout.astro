---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { GSC_META_VERIFICATION, BING_META_VERIFICATION, YANDEX_META_VERIFICATION, CLOUDFLARE_ANALYTICS_TOKEN } from '../config';

export interface Props {
  title: string;
  description: string;
  keywords?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  articleMeta?: { publishedTime?: string; modifiedTime?: string; author?: string; section?: string };
  schemaType?: 'WebApplication' | 'Article' | 'FAQPage' | 'WebPage';
  breadcrumbItems?: { name: string; item?: string }[];
  /**
   * If true, emit `<meta name="robots" content="noindex,nofollow">` so search
   * engines don't index this page. Used for /r/[id] result pages — they're
   * shareable but not search-discoverable, per privacy policy.
   */
  noindex?: boolean;
}

const {
  title,
  description,
  keywords,
  ogImage,
  ogType = 'website',
  articleMeta,
  schemaType = 'WebApplication',
  breadcrumbItems,
  noindex = false
} = Astro.props;

const SITE = 'https://9bench.com';
const fullTitle = title.includes('9bench') ? title : `${title} — 9bench`;
const canonicalUrl = new URL(Astro.url.pathname, SITE).toString();
const ogImageUrl = ogImage || `${SITE}/og`;
const dateModified = '2026-04-30';

// ── KEYWORD STRATEGY (SEO + AEO + GEO) ───────────────────────────────
// Default keyword set covers high-volume search terms + AI-citation-friendly
// phrases. Pages can override with their own keyword string.
const defaultKeywords = [
  // Direct intent
  'browser hardware benchmark',
  'test cpu performance online',
  'online gpu benchmark',
  'free hardware benchmark',
  'check pc speed online',
  'is my pc fast',
  'is my laptop slow',
  'instant computer benchmark',
  // Tool-specific
  'webgpu benchmark',
  'webassembly performance test',
  'sha-256 cpu benchmark browser',
  // UserBenchmark alternative
  'userbenchmark alternative',
  'better than userbenchmark',
  'unbiased pc benchmark',
  // Comparative
  'how fast is my computer',
  'compare cpu gpu ram',
  'benchmark without download',
  'benchmark no install',
  // Audience
  'r/pcmasterrace benchmark tool',
  'gaming pc benchmark online'
].join(', ');
const finalKeywords = keywords || defaultKeywords;

// ── Schema.org strategy: conditional primary type + Person (EEAT) ────
const webAppNode = {
  '@type': 'WebApplication',
  '@id': `${SITE}#app`,
  name: '9bench',
  alternateName: ['9bench browser benchmark', 'Nine Bench Hardware Test'],
  url: SITE,
  applicationCategory: 'UtilityApplication',
  applicationSubCategory: 'Hardware Benchmark',
  operatingSystem: 'Any (browser-based)',
  description: 'The honest browser-based hardware benchmark. Tests CPU, GPU, and RAM in 15 seconds.',
  browserRequirements: 'Requires WebGPU + WebAssembly + Web Workers (Chrome 113+, Firefox 147+, Safari 26+, Edge 113+)',
  featureList: [
    'WebGPU compute shader GPU benchmark (GFLOPS)',
    'CPU single-core SHA-256 hash chain',
    'CPU multi-core parallel via Web Workers',
    'RAM bandwidth + random-access latency',
    'Global percentile ranking via Cloudflare D1',
    'No download or installation required',
    'No account or login',
    'Privacy-first: data stays in browser unless submitted',
    'Persistent shareable result URLs',
    'Open methodology'
  ],
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock'
  },
  author: { '@id': `${SITE}#author` },
  publisher: { '@id': `${SITE}#org` },
  isAccessibleForFree: true,
  inLanguage: 'en-US'
};

const personNode = {
  '@type': 'Person',
  '@id': `${SITE}#author`,
  name: 'Atilla Kürük',
  url: 'https://toololis.com/atilla/',
  sameAs: [
    'https://www.linkedin.com/in/atilla-k-2b28b32a3/',
    'https://github.com/Xley9',
    'https://toololis.com/atilla/'
  ],
  jobTitle: 'Solo software builder',
  knowsAbout: ['Web performance', 'Browser benchmarking', 'WebGPU', 'WebAssembly', 'Hardware diagnostics']
};

const orgNode = {
  '@type': 'Organization',
  '@id': `${SITE}#org`,
  name: '9bench',
  url: SITE,
  logo: {
    '@type': 'ImageObject',
    url: `${SITE}/icon-512.png`,
    width: 512,
    height: 512
  },
  foundingDate: '2026',
  description: 'The honest browser-based hardware benchmark. Tests CPU, GPU, and RAM in 15 seconds using WebGPU + WebAssembly.',
  sameAs: ['https://toololis.com', 'https://github.com/Xley9/9bench']
};

const websiteNode = {
  '@type': 'WebSite',
  '@id': `${SITE}#website`,
  url: SITE,
  name: '9bench',
  description: 'The honest browser-based hardware benchmark.',
  publisher: { '@id': `${SITE}#org` },
  inLanguage: 'en-US'
  // No SearchAction: the site has no search interface. /r/{id} permalinks
  // are not a query endpoint — advertising them as one would be bogus markup.
};

// Speakable — tells voice assistants which parts of the page to read aloud
const speakableNode = {
  '@type': 'WebPage',
  '@id': canonicalUrl,
  name: fullTitle,
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: ['h1', 'h2', 'meta[name=description]', '.seo-body', '.seo-faq']
  },
  dateModified
};

// BreadcrumbList — always present (homepage = root only, subpages add items)
const breadcrumbNode = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '9bench', item: SITE },
    ...(breadcrumbItems || []).map((b, i) => ({
      '@type': 'ListItem',
      position: i + 2,
      name: b.name,
      ...(b.item ? { item: b.item } : {})
    }))
  ]
};

// Only include WebApplication on app pages (home, top, compare, history, results)
const appPages = ['WebApplication'];
const graphNodes = [
  ...(appPages.includes(schemaType) ? [webAppNode] : []),
  personNode, orgNode, websiteNode, speakableNode, breadcrumbNode
];

const baseSchema = {
  '@context': 'https://schema.org',
  '@graph': graphNodes
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0A0A0A" />
    <meta name="color-scheme" content="dark" />

    <!-- ── No-flash accent (Cyan default · Orange via toggle) ──
         Runs BEFORE <body> paint to prevent flash of wrong color.
         Persisted in localStorage as '9bench-accent' = 'cyan' | 'orange'.
         Cyan is the default — Orange is opt-in for users who prefer warm. -->
    <script is:inline>
      (function () {
        try {
          var a = localStorage.getItem('9bench-accent');
          if (a === 'orange') document.documentElement.setAttribute('data-accent', 'orange');
        } catch (e) {}
      })();
    </script>

    <!-- ── Editorial brand fonts: JetBrains Mono + Inter ──
         Self-hosted via /fonts/ would be faster (Toololis pattern), but
         9bench has different font weights than Toololis (700, 800 needed
         for big editorial type). Keep Google Fonts for now; migrate
         to self-hosted in Phase F if PageSpeed shows render-block. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700;800&family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Title + description (SEO) -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={finalKeywords} />

    <!-- Canonical -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Hreflang -->
    <link rel="alternate" hreflang="en" href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />

    <!-- Robots / AI crawl -->
    {noindex ? (
      <>
        <meta name="robots" content="noindex, nofollow" />
        <meta name="googlebot" content="noindex, nofollow" />
        <meta name="bingbot" content="noindex, nofollow" />
      </>
    ) : (
      <>
        <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
        <meta name="googlebot" content="index, follow, max-snippet:-1, max-image-preview:large" />
        <meta name="bingbot" content="index, follow" />
      </>
    )}

    <!-- Author + Publisher -->
    <meta name="author" content="Atilla Kürük" />
    <meta name="publisher" content="9bench" />
    <meta name="last-modified" content={dateModified} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="9bench" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="9bench — The honest browser-based hardware benchmark" />
    <meta property="og:image:type" content="image/png" />
    {articleMeta?.publishedTime && <meta property="article:published_time" content={articleMeta.publishedTime} />}
    {articleMeta?.modifiedTime && <meta property="article:modified_time" content={articleMeta.modifiedTime} />}
    {articleMeta?.author && <meta property="article:author" content={articleMeta.author} />}
    {articleMeta?.section && <meta property="article:section" content={articleMeta.section} />}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content="9bench result card" />
    <!-- twitter:creator intentionally omitted — no verified X handle to attribute -->

    <!-- Favicons + Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/icon-512.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <!-- Sitemap link (for AI crawlers + feed readers) -->
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    <!-- DNS Prefetch -->
    <!-- (Removed googletagmanager / google-analytics — swapped to
         Cloudflare Web Analytics, cookieless, no consent banner needed
         under EU ePrivacy / German TTDSG § 25.) -->
    <link rel="dns-prefetch" href="https://static.cloudflareinsights.com" />

    <!-- Search Console Verifications -->
    {GSC_META_VERIFICATION && <meta name="google-site-verification" content={GSC_META_VERIFICATION} />}
    {BING_META_VERIFICATION && <meta name="msvalidate.01" content={BING_META_VERIFICATION} />}
    {YANDEX_META_VERIFICATION && <meta name="yandex-verification" content={YANDEX_META_VERIFICATION} />}

    <!-- Schema.org JSON-LD (rich, SEO + AEO + GEO) -->
    <script type="application/ld+json" set:html={JSON.stringify(baseSchema)} />

    <!-- Per-page additional schema slot -->
    <slot name="head" />

    <!--
      Cloudflare Web Analytics — cookieless, no consent banner needed.
      Privacy-first replacement for GA4 (removed 2026-04-29).
      Edge auto-injection IS active and collecting (verified 2026-07-10:
      beacon.min.js appears in HTML served to real browser User-Agents;
      Cloudflare skips injection for bot/CLI UAs, which is why curl
      doesn't show it). CLOUDFLARE_ANALYTICS_TOKEN in src/config.ts must
      therefore stay EMPTY — setting it would render a second beacon and
      double-count every visit. The conditional below exists only as a
      fallback if auto-injection is ever turned off.
    -->
    {CLOUDFLARE_ANALYTICS_TOKEN && (
      <script
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: CLOUDFLARE_ANALYTICS_TOKEN })}
      />
    )}
  </head>
  <body class="theme-bg">
    <Header />
    <slot />
    <Footer />
  </body>
</html>
