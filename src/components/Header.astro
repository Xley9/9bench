---
import AccentToggle from './bench/AccentToggle.astro';

const path = Astro.url.pathname;
function isActive(p: string) {
  if (p === '/' && path === '/') return true;
  if (p !== '/' && path.startsWith(p)) return true;
  return false;
}
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="site-logo" aria-label="9bench home">
      <span class="site-logo__mark" aria-hidden="true">9</span>
      <span class="site-logo__name">9bench</span>
    </a>

    <nav class="site-nav" aria-label="Primary">
      <a href="/"            class:list={['site-nav__link', isActive('/')            && 'is-active']}>Test</a>
      <a href="/top"         class:list={['site-nav__link', isActive('/top')         && 'is-active']}>Top</a>
      <a href="/compare"     class:list={['site-nav__link', isActive('/compare')     && 'is-active']}>Compare</a>
      <a href="/articles"    class:list={['site-nav__link', isActive('/articles')    && 'is-active']}>Articles</a>
      <a href="/methodology" class:list={['site-nav__link', isActive('/methodology') && 'is-active']}>How</a>
      <a href="/faq"         class:list={['site-nav__link', isActive('/faq')         && 'is-active']}>FAQ</a>
    </nav>

    <div class="site-header__right">
      <AccentToggle />
      <button class="site-nav-burger" id="site-nav-burger" aria-label="Open menu">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
          <line x1="4" y1="7" x2="20" y2="7"/>
          <line x1="4" y1="12" x2="20" y2="12"/>
          <line x1="4" y1="17" x2="20" y2="17"/>
        </svg>
      </button>
    </div>
  </div>

  <div class="site-nav-drawer" id="site-nav-drawer" hidden>
    <a href="/">Test</a>
    <a href="/top">Top scores</a>
    <a href="/compare">Compare two</a>
    <a href="/articles">Articles</a>
    <a href="/history">My history</a>
    <a href="/methodology">Methodology</a>
    <a href="/faq">FAQ</a>
    <a href="/about">About</a>
    <a href="/privacy">Privacy</a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(10, 10, 10, 0.88);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 12px 0;
  }

  /* Logo: small accent square + mono name (matches Toololis brand-family logic) */
  .site-logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--fg);
  }
  .site-logo__mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    background: var(--accent);
    color: #000;
    font-family: var(--sans);
    font-weight: 800;
    font-size: 16px;
    line-height: 1;
  }
  .site-logo__name {
    font-family: var(--sans);
    font-weight: 800;
    font-size: 16px;
    letter-spacing: -0.01em;
  }

  /* Nav links — small uppercase mono */
  .site-nav {
    display: none;
    gap: 8px;
  }
  .site-nav__link {
    padding: 6px 12px;
    color: var(--fg-2);
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: color 0.15s, border-color 0.15s;
  }
  .site-nav__link:hover     { color: var(--fg); }
  .site-nav__link.is-active { color: var(--accent); border-color: var(--accent); }

  @media (min-width: 768px) { .site-nav { display: flex; } }

  /* Right cluster: accent toggle + burger */
  .site-header__right {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .site-nav-burger {
    background: transparent;
    border: 1px solid var(--line);
    color: var(--fg);
    padding: 6px 8px;
    cursor: pointer;
    transition: border-color 0.15s;
  }
  .site-nav-burger:hover { border-color: var(--accent); color: var(--accent); }
  @media (min-width: 768px) { .site-nav-burger { display: none; } }

  /* Drawer (mobile only) */
  .site-nav-drawer {
    display: none;
    flex-direction: column;
    background: var(--bg-2);
    border-bottom: 1px solid var(--line);
  }
  .site-nav-drawer.is-open { display: flex; }
  .site-nav-drawer a {
    padding: 12px 20px;
    color: var(--fg);
    text-decoration: none;
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border-bottom: 1px solid var(--line-2);
  }
  .site-nav-drawer a:hover    { background: var(--bg-3); color: var(--accent); }
  .site-nav-drawer a:last-child { border-bottom: none; }
  @media (min-width: 768px) { .site-nav-drawer { display: none !important; } }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const burger = document.getElementById('site-nav-burger');
    const drawer = document.getElementById('site-nav-drawer');
    if (burger && drawer) {
      burger.addEventListener('click', () => drawer.classList.toggle('is-open'));
      drawer.querySelectorAll('a').forEach(a => {
        a.addEventListener('click', () => drawer.classList.remove('is-open'));
      });
    }
  });
</script>
