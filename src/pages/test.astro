---
/**
 * /test — V1 Terminal benchmark execution screen.
 *
 * Auto-starts runFullBench on mount. Shows live progress through the
 * three test phases (GPU → CPU → RAM), then submits to /api/submit and
 * redirects to /r/[hash]/ for the result page.
 *
 * UI: V1 Terminal (matched to drop spec) — status bar, progress bar,
 * 3 live graph blocks (GPU/CPU/RAM), console log, truth disclaimer.
 *
 * Without WebGPU the run continues: the GPU block is marked "not measured"
 * and the score is composed from CPU + RAM with renormalized weights (see
 * bench/runner.ts). Only a missing Web Workers or Web Crypto implementation
 * is fatal — those are what the CPU test is actually built on.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import TruthDisclaimer from '../components/bench/TruthDisclaimer.astro';
---

<BaseLayout
  title="Testing your hardware — 9bench"
  description="9bench is benchmarking your CPU, GPU, and RAM in real time. ~15 seconds, all in your browser."
  noindex={true}
>
  <main class="container test-running">

    <!-- ── Pre-test consent screen (GDPR Art. 6(1)(a) explicit consent) ── -->
    <!-- Visible by default. The actual benchmark UI below is hidden until
         the user clicks "Start Test". The checkbox state determines whether
         we submit the result to D1 — uncheck to keep everything local. -->
    <section class="test-intro" id="test-intro">
      <h1 class="test-intro__title">Ready to test your hardware?</h1>
      <p class="test-intro__lead">
        15-second benchmark: CPU, RAM, and — where WebGPU is available — GPU.
        Runs entirely in your browser. No download, no signup.
      </p>

      <div class="consent-box">
        <label class="consent-box__row">
          <input type="checkbox" id="consent-submit" checked />
          <span class="consent-box__label">
            Submit my anonymous result to the global ranking
          </span>
        </label>
        <p class="consent-box__detail">
          What gets submitted: score breakdown, GPU name (if exposed by your browser),
          CPU core count, AI capability snapshot, a short
          <code>Browser-Major / OS / Arch</code> string, timestamp.
          No IP address, no cookies, no fingerprints.
          <a href="/privacy/" class="consent-box__link">Privacy details →</a>
        </p>
        <p class="consent-box__detail consent-box__detail--muted">
          Uncheck to run the benchmark without storing anything — you'll see your
          result locally on this page.
        </p>
      </div>

      <button type="button" id="start-btn" class="test-intro__start-btn">
        ▶ START 15-SECOND TEST
      </button>
    </section>

    <!-- ── Benchmark UI (hidden until Start clicked) ───────────────── -->
    <div id="test-ui" hidden>

    <!-- ── Status bar ───────────────────────────────────────────────── -->
    <div class="status-bar" id="status-bar">
      <span class="status-bar__pulse" aria-hidden="true"></span>
      <span class="status-bar__primary" id="status-primary">● BENCHMARK IN PROGRESS</span>
      <span class="status-bar__sep">·</span>
      <span class="status-bar__secondary" id="status-secondary">STARTING · DO NOT SWITCH TABS</span>
      <span class="status-bar__pct tnum" id="status-pct">00%</span>
    </div>

    <!-- ── Progress bar ─────────────────────────────────────────────── -->
    <div class="progress-track">
      <div class="progress-track__fill" id="progress-fill"></div>
    </div>

    <!-- ── No-WebGPU notice (revealed by JS when the probe finds none) ── -->
    <aside class="nogpu-notice" id="nogpu-notice" hidden>
      <p class="nogpu-notice__head">// GPU TEST SKIPPED — WEBGPU UNAVAILABLE</p>
      <p class="nogpu-notice__body">
        WebGPU needs a recent browser <em>and</em> a GPU driver the browser trusts.
        Plenty of Android phones, Linux desktops and older Macs run current Chrome
        or Firefox and still have it switched off by the vendor. Nothing you did.
      </p>
      <p class="nogpu-notice__body">
        Running CPU + RAM anyway. You get a CPU + RAM score — the weights are
        rebalanced over the two parts we could actually measure. It is not
        comparable to a full CPU+GPU+RAM score and it is not on the leaderboard.
      </p>
      <p class="nogpu-notice__body">
        <a href="/methodology/#changelog">methodology → v3.2</a>
      </p>
    </aside>

    <!-- ── Three live blocks (GPU / CPU / RAM) ──────────────────────── -->
    <div class="live-blocks">
      <article class="live-block" data-block="gpu">
        <header class="live-block__head">
          <span class="live-block__icon" aria-hidden="true">🎮</span>
          <div class="live-block__titles">
            <h3 class="live-block__label">GPU · COMPUTE</h3>
            <p class="live-block__sub">1024×1024 FP32 MATMUL · WEBGPU (IF AVAILABLE)</p>
          </div>
          <span class="live-block__pct" data-pct>0%</span>
        </header>
        <div class="live-block__body">
          <div class="live-block__graph" data-graph>
            <canvas data-canvas></canvas>
            <div class="live-block__graph-meta">
              <span class="live-block__graph-stage">MATMUL_512</span>
              <span class="live-block__graph-tag">○ IDLE</span>
            </div>
            <div class="live-block__graph-value">
              <span class="tnum" data-value>—</span>
              <span class="live-block__graph-unit">GFLOPS</span>
            </div>
          </div>
          <div class="live-block__variance">
            <div><span>MIN</span> <span class="tnum" data-min>—</span></div>
            <div><span>AVG</span> <span class="tnum" data-avg>—</span></div>
            <div><span>MAX</span> <span class="tnum" data-max>—</span></div>
          </div>
        </div>
      </article>

      <article class="live-block" data-block="cpu">
        <header class="live-block__head">
          <span class="live-block__icon" aria-hidden="true">⚙️</span>
          <div class="live-block__titles">
            <h3 class="live-block__label">CPU · 1C + MC</h3>
            <p class="live-block__sub">SHA-256 · WEB WORKERS</p>
          </div>
          <span class="live-block__pct" data-pct>0%</span>
        </header>
        <div class="live-block__body">
          <div class="live-block__graph" data-graph>
            <canvas data-canvas></canvas>
            <div class="live-block__graph-meta">
              <span class="live-block__graph-stage">SHA256_W12</span>
              <span class="live-block__graph-tag">○ IDLE</span>
            </div>
            <div class="live-block__graph-value">
              <span class="tnum" data-value>—</span>
              <span class="live-block__graph-unit">HASH/s · MC</span>
            </div>
          </div>
          <div class="live-block__variance">
            <div><span>MIN</span> <span class="tnum" data-min>—</span></div>
            <div><span>AVG</span> <span class="tnum" data-avg>—</span></div>
            <div><span>MAX</span> <span class="tnum" data-max>—</span></div>
          </div>
        </div>
      </article>

      <article class="live-block live-block--warn" data-block="ram">
        <header class="live-block__head">
          <span class="live-block__icon" aria-hidden="true">💾</span>
          <div class="live-block__titles">
            <h3 class="live-block__label">RAM · BANDWIDTH</h3>
            <p class="live-block__sub">256 MB · SEQ + RANDOM</p>
          </div>
          <span class="live-block__pct" data-pct>0%</span>
        </header>
        <div class="live-block__body">
          <div class="live-block__graph" data-graph>
            <canvas data-canvas></canvas>
            <div class="live-block__graph-meta">
              <span class="live-block__graph-stage">SEQ_READ_64K</span>
              <span class="live-block__graph-tag">○ IDLE</span>
            </div>
            <div class="live-block__graph-value">
              <span class="tnum" data-value>—</span>
              <span class="live-block__graph-unit">GB/s · READ</span>
            </div>
          </div>
          <div class="live-block__variance">
            <div><span>MIN</span> <span class="tnum" data-min>—</span></div>
            <div><span>AVG</span> <span class="tnum" data-avg>—</span></div>
            <div><span>MAX</span> <span class="tnum" data-max>—</span></div>
          </div>
        </div>
      </article>
    </div>

    <!-- ── Console log ─────────────────────────────────────────────── -->
    <div class="console-log" id="console-log" aria-live="polite" aria-atomic="false">
      <div class="console-log__line"><span class="ts">[--:--]</span> waiting for browser capability check…</div>
    </div>

    <!-- ── Truth Disclaimer ────────────────────────────────────────── -->
    <TruthDisclaimer compact />

    <!-- ── Failure card (hidden until error) ───────────────────────── -->
    <div class="error-card" id="error-card" hidden>
      <h2 class="section-h" style="font-size: 28px; margin-top: 32px;">Can't run the benchmark here</h2>
      <p id="error-message" class="text-fg-2" style="font-family: var(--mono); font-size: 13px;">—</p>
      <p style="margin-top: 24px;">
        <a href="/" class="btn-outline">← Back to home</a>
      </p>
    </div>

    </div>
    <!-- end #test-ui -->
  </main>
</BaseLayout>

<style>
  .test-running {
    padding: 24px 0 56px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  /* ── Pre-test intro / consent screen ──────────────────────────── */
  .test-intro {
    max-width: 720px;
    margin: 40px auto 0;
    padding: 32px 28px;
    border: 1px solid var(--line);
    background: var(--bg-2);
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .test-intro__title {
    font-family: var(--sans);
    font-size: 28px;
    font-weight: 800;
    margin: 0;
    line-height: 1.1;
  }
  .test-intro__lead {
    color: var(--fg-2);
    line-height: 1.55;
    margin: 0;
  }
  .consent-box {
    border: 1px solid var(--line);
    padding: 16px 18px;
    background: rgba(0, 217, 255, 0.04);
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  :root[data-accent="orange"] .consent-box {
    background: rgba(255, 107, 43, 0.04);
  }
  .consent-box__row {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    cursor: pointer;
  }
  .consent-box__row input[type="checkbox"] {
    margin-top: 3px;
    width: 18px;
    height: 18px;
    accent-color: var(--accent);
    flex: 0 0 auto;
  }
  .consent-box__label {
    font-family: var(--mono);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--fg);
  }
  .consent-box__detail {
    font-family: var(--mono);
    font-size: 11px;
    line-height: 1.55;
    color: var(--fg-2);
    margin: 0;
    padding-left: 28px;
  }
  .consent-box__detail--muted {
    color: var(--fg-3);
  }
  .consent-box__detail code {
    font-family: var(--mono);
    background: rgba(255,255,255,0.06);
    padding: 1px 5px;
    border-radius: 2px;
  }
  .consent-box__link {
    color: var(--accent);
    text-decoration: none;
  }
  .consent-box__link:hover { text-decoration: underline; }
  .test-intro__start-btn {
    align-self: stretch;
    padding: 16px 24px;
    background: var(--accent);
    color: #0A0A0A;
    border: 0;
    font-family: var(--mono);
    font-size: 16px;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
    transition: transform 0.15s, background 0.15s;
  }
  .test-intro__start-btn:hover {
    background: var(--fg);
    transform: translateY(-1px);
  }

  /* Status bar — top of screen, accent-bordered */
  .status-bar {
    border: 1px solid var(--accent);
    background: rgba(0, 217, 255, 0.04);
    padding: 14px 18px;
    display: flex;
    align-items: center;
    gap: 14px;
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.04em;
  }
  :root[data-accent="orange"] .status-bar {
    background: rgba(255, 107, 43, 0.04);
  }
  .status-bar__pulse {
    width: 10px; height: 10px;
    background: var(--accent);
    flex: 0 0 auto;
    animation: pulse 1.2s ease-in-out infinite;
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50%      { opacity: 0.3; }
  }
  .status-bar__primary {
    color: var(--accent);
    font-weight: 700;
    letter-spacing: 0.1em;
  }
  .status-bar__sep { color: var(--fg-3); }
  .status-bar__secondary { color: var(--fg-2); flex: 1; }
  .status-bar__pct {
    margin-left: auto;
    color: var(--accent);
    font-weight: 700;
    font-size: 18px;
    flex: 0 0 auto;
  }

  /* Progress bar */
  .progress-track {
    height: 4px;
    background: var(--bg-3);
    border: 1px solid var(--line);
  }
  .progress-track__fill {
    height: 100%;
    width: 0%;
    background: var(--accent);
    transition: width 0.2s ease-out;
  }

  /* Live blocks (3 column grid on desktop) */
  .live-blocks {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }
  @media (min-width: 768px) {
    .live-blocks { grid-template-columns: repeat(3, 1fr); }
  }
  .live-block {
    border: 1px solid var(--line);
    background: var(--bg-2);
    display: flex;
    flex-direction: column;
  }
  .live-block__head {
    padding: 14px 16px;
    border-bottom: 1px solid var(--line);
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .live-block__icon {
    color: var(--accent);
    font-size: 20px;
    flex: 0 0 auto;
  }
  .live-block--warn .live-block__icon { color: var(--warn); }
  .live-block__titles { flex: 1; min-width: 0; }
  .live-block__label {
    font-family: var(--mono);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--fg);
    margin: 0;
  }
  .live-block__sub {
    font-family: var(--mono);
    font-size: 10px;
    color: var(--fg-3);
    letter-spacing: 0.04em;
    margin: 2px 0 0 0;
  }
  .live-block__pct {
    margin-left: auto;
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    color: var(--accent);
    flex: 0 0 auto;
  }
  .live-block--warn .live-block__pct { color: var(--warn); }

  /* "Not measured" — deliberately grey, NOT --warn. Nothing failed here;
     the browser simply doesn't expose the API. Warn orange would read as
     an error the user caused. */
  .live-block--unmeasured .live-block__pct   { color: var(--fg-3); }
  .live-block--unmeasured .live-block__icon  { opacity: 0.35; filter: grayscale(1); }
  .live-block--unmeasured .live-block__label { color: var(--fg-2); }
  .live-block--unmeasured .live-block__graph-tag,
  .live-block--unmeasured .live-block__graph-stage { color: var(--fg-3); }
  .live-block--unmeasured [data-value] { color: var(--fg-3); }

  /* No-WebGPU explainer, shown above the blocks when the probe finds none */
  .nogpu-notice {
    border: 1px solid var(--line);
    border-left: 2px solid var(--fg-3);
    background: var(--bg-2);
    padding: 14px 16px;
  }
  .nogpu-notice__head {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--fg-2);
    margin: 0 0 8px 0;
  }
  .nogpu-notice__body {
    font-family: var(--sans);
    font-size: 13px;
    line-height: 1.6;
    color: var(--fg-2);
    margin: 0 0 8px 0;
  }
  .nogpu-notice__body:last-child { margin-bottom: 0; }
  .nogpu-notice__body a { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }

  .live-block__body {
    padding: 14px;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  /* Live graph */
  .live-block__graph {
    position: relative;
    height: 140px;
    border: 1px solid var(--line);
    background: var(--bg-2);
  }
  .live-block__graph canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
  .live-block__graph-meta {
    position: absolute;
    top: 10px;
    left: 12px;
    right: 12px;
    display: flex;
    justify-content: space-between;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--fg-3);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    pointer-events: none;
  }
  .live-block__graph-tag {
    color: var(--fg-3);
  }
  .live-block.is-active .live-block__graph-tag { color: var(--accent); }
  .live-block--warn.is-active .live-block__graph-tag { color: var(--warn); }
  .live-block__graph-value {
    position: absolute;
    bottom: 10px;
    left: 12px;
    font-family: var(--mono);
    color: var(--fg);
    pointer-events: none;
  }
  .live-block__graph-value [data-value] {
    font-size: 24px;
    font-weight: 700;
  }
  .live-block__graph-unit {
    font-size: 11px;
    color: var(--fg-3);
    margin-left: 6px;
  }

  /* Variance row */
  .live-block__variance {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--line-2);
    padding-top: 10px;
    margin-top: auto;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--fg-3);
    letter-spacing: 0.04em;
  }
  .live-block__variance > div { display: flex; gap: 6px; }
  .live-block__variance [data-min],
  .live-block__variance [data-avg],
  .live-block__variance [data-max] {
    color: var(--fg);
  }

  /* Console log */
  .console-log {
    border: 1px solid var(--line);
    background: var(--bg-2);
    padding: 12px 16px;
    min-height: 140px;
    max-height: 220px;
    overflow-y: auto;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--fg-2);
    line-height: 1.7;
  }
  .console-log__line {
    color: var(--fg-3);
  }
  .console-log__line.is-latest { color: var(--accent); }
  .console-log__line .ts  { color: var(--fg-4); margin-right: 6px; }
  .console-log__line .key { color: var(--accent); }

  /* Error fallback */
  .error-card {
    border: 1px solid var(--warn);
    padding: 24px;
    background: var(--bg-2);
  }
</style>

<script>
  // ─────────────────────────────────────────────────────────────────
  //  TEST RUNNER — wires our existing src/bench/runner.ts to the UI.
  //  Phases (matches BenchResult.scores ordering):
  //    1. GPU compute  (~30% of total time)
  //    2. CPU single + multi  (~40%)
  //    3. RAM bandwidth + latency  (~30%)
  //  After completion: POST /api/submit → redirect /r/[hash]/.
  // ─────────────────────────────────────────────────────────────────

  import { runFullBench } from '../bench/runner';

  type StageKey = 'gpu' | 'cpu' | 'ram' | 'done';

  // ── DOM refs ─────────────────────────────────────────────────────
  const $ = (sel: string) => document.querySelector(sel) as HTMLElement | null;
  const blockEls: Record<'gpu' | 'cpu' | 'ram', HTMLElement | null> = {
    gpu: document.querySelector('[data-block="gpu"]'),
    cpu: document.querySelector('[data-block="cpu"]'),
    ram: document.querySelector('[data-block="ram"]'),
  };

  function setProgress(pct: number) {
    const fill = $('#progress-fill');
    const pctEl = $('#status-pct');
    if (fill) fill.style.width = Math.min(100, Math.max(0, pct)) + '%';
    if (pctEl) pctEl.textContent = String(Math.floor(pct)).padStart(2, '0') + '%';
  }

  function setBlockActive(stage: 'gpu' | 'cpu' | 'ram', active: boolean, pct?: number) {
    const el = blockEls[stage];
    if (!el) return;
    el.classList.toggle('is-active', active);
    if (typeof pct === 'number') {
      const pctEl = el.querySelector<HTMLElement>('[data-pct]');
      if (pctEl) pctEl.textContent = Math.floor(pct) + '%';
    }
    const tagEl = el.querySelector<HTMLElement>('.live-block__graph-tag');
    if (tagEl) tagEl.textContent = active ? '● LIVE' : '○ IDLE';
  }

  /**
   * Mark a block as "we could not measure this" — distinct from both
   * "idle" and "failed". Never shows 0 or 100%: a 0 next to GFLOPS reads
   * as "your GPU scored zero", and 100% reads as "the GPU test finished".
   */
  function setBlockUnmeasured(stage: 'gpu' | 'cpu' | 'ram', reason = 'WEBGPU UNAVAILABLE') {
    const el = blockEls[stage];
    if (!el) return;
    el.classList.remove('is-active');
    el.classList.add('live-block--unmeasured');
    const pctEl = el.querySelector<HTMLElement>('[data-pct]');
    if (pctEl) pctEl.textContent = 'N/A';
    const v = el.querySelector<HTMLElement>('[data-value]');
    if (v) v.textContent = '—';
    const tagEl = el.querySelector<HTMLElement>('.live-block__graph-tag');
    if (tagEl) tagEl.textContent = '○ NOT MEASURED';
    const stageEl = el.querySelector<HTMLElement>('.live-block__graph-stage');
    if (stageEl) stageEl.textContent = '—';
    const subEl = el.querySelector<HTMLElement>('.live-block__sub');
    if (subEl) subEl.textContent = `NOT MEASURED · ${reason}`;
  }

  function setBlockValue(stage: 'gpu' | 'cpu' | 'ram', value: string) {
    const el = blockEls[stage];
    if (!el) return;
    const v = el.querySelector<HTMLElement>('[data-value]');
    if (v) v.textContent = value;
  }

  function setBlockVariance(stage: 'gpu' | 'cpu' | 'ram', min: string, avg: string, max: string) {
    const el = blockEls[stage];
    if (!el) return;
    el.querySelector<HTMLElement>('[data-min]')?.replaceChildren(document.createTextNode(min));
    el.querySelector<HTMLElement>('[data-avg]')?.replaceChildren(document.createTextNode(avg));
    el.querySelector<HTMLElement>('[data-max]')?.replaceChildren(document.createTextNode(max));
  }

  function appendLog(line: string) {
    const log = $('#console-log');
    if (!log) return;
    // Mark previous-latest as historical, append new latest
    log.querySelectorAll('.console-log__line.is-latest')
       .forEach(el => el.classList.remove('is-latest'));
    const div = document.createElement('div');
    div.className = 'console-log__line is-latest';
    const t = ((Date.now() - startedAt) / 1000).toFixed(2).padStart(5, '0');
    div.innerHTML = `<span class="ts">[${t}]</span> ${line}`;
    log.appendChild(div);
    // Auto-scroll to latest
    log.scrollTop = log.scrollHeight;
    // Cap log to last 40 lines so memory doesn't grow on long sessions
    while (log.children.length > 40) log.removeChild(log.firstChild!);
  }

  function setStatus(primary: string, secondary?: string) {
    const p = $('#status-primary');
    const s = $('#status-secondary');
    if (p) p.textContent = primary;
    if (s && secondary !== undefined) s.textContent = secondary;
  }

  function showError(message: string) {
    const card = $('#error-card');
    const msg  = $('#error-message');
    if (card) card.removeAttribute('hidden');
    if (msg)  msg.textContent = message;
    setStatus('● ERROR', message);
    document.querySelector('.status-bar')?.setAttribute('style',
      'border-color: var(--warn); background: rgba(255,87,34,0.06);');
    // Stop any running graph so a frozen waveform doesn't imply work is
    // still happening, and re-enable Start — otherwise every error is a
    // dead end that needs a page reload.
    stopGraph('gpu'); stopGraph('cpu'); stopGraph('ram');
    const sb = document.getElementById('start-btn') as HTMLButtonElement | null;
    if (sb) sb.disabled = false;
  }

  // ── Live graph drawing (lightweight canvas, no React) ────────────
  // Deterministic pseudo-random walk drives the wave. We don't try to
  // visualize actual realtime samples (those come in chunks at GPU
  // dispatch boundaries, not smooth) — the wave is "vibes" while real
  // numbers populate the value display + variance row.
  const graphState: Record<string, { t: number; running: boolean; peak: number; raf?: number }> = {
    gpu: { t: 0, running: false, peak: 0.85 },
    cpu: { t: 0, running: false, peak: 0.70 },
    ram: { t: 0, running: false, peak: 0.60 },
  };

  function startGraph(stage: 'gpu' | 'cpu' | 'ram') {
    const el = blockEls[stage];
    if (!el) return;
    const canvas = el.querySelector<HTMLCanvasElement>('[data-canvas]');
    if (!canvas) return;
    const isWarn = stage === 'ram';
    const state = graphState[stage];
    state.running = true;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    const dpr = window.devicePixelRatio || 1;
    const seedNum = stage === 'gpu' ? 4 : stage === 'cpu' ? 5 : 6;

    function size() {
      const r = canvas.getBoundingClientRect();
      canvas.width = r.width * dpr;
      canvas.height = r.height * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }
    size();
    const ro = new ResizeObserver(size);
    ro.observe(canvas);

    function draw() {
      const r = canvas.getBoundingClientRect();
      const W = r.width, H = r.height;
      ctx.clearRect(0, 0, W, H);

      // Baseline grid
      ctx.strokeStyle = 'rgba(255,255,255,0.05)';
      ctx.lineWidth = 1;
      for (let i = 0; i < 5; i++) {
        const y = (H / 4) * i + 0.5;
        ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(W, y); ctx.stroke();
      }

      // Signal
      const samples = Math.floor(W / 2);
      const data: number[] = [];
      for (let i = 0; i < samples; i++) {
        const x = i / samples;
        const s = Math.sin((x * 8 + state.t) * (1 + seedNum * 0.3)) * 0.32
                + Math.sin((x * 23 + state.t * 1.7) * (1 + seedNum * 0.5)) * 0.18
                + Math.sin((x * 51 + state.t * 0.6) * (1 + seedNum * 0.2)) * 0.10;
        data.push((0.5 + s * 0.45) * state.peak);
      }

      // Fill
      ctx.beginPath();
      ctx.moveTo(0, H);
      data.forEach((v, i) => ctx.lineTo((i / (samples - 1)) * W, H - v * H));
      ctx.lineTo(W, H);
      ctx.closePath();
      ctx.fillStyle = isWarn ? 'rgba(255,87,34,0.10)' : 'rgba(0,217,255,0.10)';
      ctx.fill();

      // Line
      ctx.beginPath();
      data.forEach((v, i) => {
        const x = (i / (samples - 1)) * W;
        const y = H - v * H;
        if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
      });
      ctx.lineWidth = 1.5;
      ctx.strokeStyle = isWarn ? '#FF5722' : (
        // Honor the current accent (cyan or orange via toggle)
        getComputedStyle(document.documentElement).getPropertyValue('--accent').trim() || '#00D9FF'
      );
      ctx.stroke();

      // Current dot
      const last = data[data.length - 1];
      ctx.fillStyle = ctx.strokeStyle;
      ctx.beginPath();
      ctx.arc(W - 2, H - last * H, 3, 0, Math.PI * 2);
      ctx.fill();

      if (state.running) state.t += 0.04;
      state.raf = requestAnimationFrame(draw);
    }
    draw();
  }

  function stopGraph(stage: 'gpu' | 'cpu' | 'ram') {
    graphState[stage].running = false;
    if (graphState[stage].raf) cancelAnimationFrame(graphState[stage].raf!);
  }

  // ── Main bench execution ────────────────────────────────────────
  const startedAt = Date.now();

  async function runBench() {
    appendLog('init  → checking browser capabilities…');

    // Phones background the tab the moment the user switches apps, and the
    // browser then throttles timers to ~1/minute. Any timing measured across
    // that is worthless. We don't abort (the user would lose the run) — we
    // just refuse to submit it to the shared pool.
    let wentHidden = document.hidden;
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) wentHidden = true;
    });

    // Hard caps — only for things the CPU/RAM tests genuinely cannot run
    // without. WebGPU is NOT one of them: without it we skip the GPU test
    // and still produce an honest CPU+RAM score (runner.ts renormalizes
    // the weights). Blocking the whole run here was a dead end for every
    // Android phone whose GPU vendor isn't on the WebGPU allowlist.
    if (typeof Worker === 'undefined') {
      showError('Web Workers are blocked, so the CPU test can\'t run. Usually a privacy extension or a hardened browser profile — try a normal window.');
      return;
    }
    if (!globalThis.crypto?.subtle) {
      showError('Web Crypto isn\'t available, so the CPU test can\'t run. It needs an https:// page — check the address bar.');
      return;
    }

    // ── v4.0 SOLO MODE: /test/?v4solo=1 ───────────────────────────
    // Runs ONLY the full-length v4.0 candidate on a cold chip and prints a
    // JSON block for a validation-pair GitHub issue. Never touches
    // /api/submit or /api/shadow — the gate's accuracy criteria consume
    // these cold runs; fleet shadow data (thermally contaminated by its
    // after-the-test placement) is only used for scaling shape and rates.
    if (new URLSearchParams(location.search).has('v4solo')) {
      if (typeof WebAssembly === 'undefined') {
        showError('The v4.0 candidate needs WebAssembly, which this browser does not expose.');
        return;
      }
      try {
        setStatus('● V4 SOLO RUN', 'FULL-LENGTH v4.0 CANDIDATE · NOT SCORED · NOT SUBMITTED');
        appendLog('v4solo → full-length v4.0 candidate · cold-chip validation run');
        appendLog('v4solo → nothing is submitted; copy the JSON below into a validation-pair issue');
        setBlockUnmeasured('gpu', 'NOT PART OF THE V4 SOLO RUN');
        setBlockUnmeasured('ram', 'NOT PART OF THE V4 SOLO RUN');
        startGraph('cpu');
        setBlockActive('cpu', true, 50);
        const { runCPUBenchV4 } = await import('../bench/cpu-test-v4');
        const solo = await runCPUBenchV4({
          singleMs: 2000, multiWindowMs: 10000, warmupMs: 300, probe: false,
          onLog: appendLog,
        });
        stopGraph('cpu');
        setBlockActive('cpu', false, 100);
        setProgress(100);
        const block = JSON.stringify({
          v4solo: 1,
          wl: solo.wl,
          intSingle: Math.round(solo.intSingle),
          fpSingle: Math.round(solo.fpSingle),
          intMulti: Math.round(solo.intMulti),
          fpMulti: Math.round(solo.fpMulti),
          workers: solo.workersSpawned,
          intWorkerRates: solo.intWorkerRates,
          fpWorkerRates: solo.fpWorkerRates,
          clockSkewMs: solo.clockSkewMs,
          verifyOk: solo.verifyOk,
          cores: navigator.hardwareConcurrency || null,
          error: solo.error ?? null,
        });
        appendLog('v4solo → RESULT (copy everything between the markers):');
        appendLog('----- BEGIN 9BENCH V4 SOLO -----');
        appendLog(block);
        appendLog('----- END 9BENCH V4 SOLO -----');
        setStatus('✓ V4 SOLO COMPLETE', 'copy the JSON from the log into a validation-pair issue');
      } catch (e: any) {
        showError('v4 solo run failed: ' + (e?.message || e));
      }
      return;
    }

    // Probe WebGPU for real before we claim anything in the UI. Checking
    // `'gpu' in navigator` is not enough: the common Android case is the
    // property being present while requestAdapter() resolves null.
    let webgpuAvailable = false;
    let webgpuReason = 'webgpu not present in this browser';
    if ('gpu' in navigator) {
      try {
        const adapter = await Promise.race([
          (navigator as any).gpu.requestAdapter(),
          new Promise(resolve => setTimeout(() => resolve(null), 3000)),
        ]);
        webgpuAvailable = !!adapter;
        if (!adapter) webgpuReason = 'no webgpu adapter for this gpu/driver';
      } catch {
        webgpuReason = 'webgpu adapter request failed';
      }
    }

    if (webgpuAvailable) {
      appendLog('init  → webgpu adapter found · web workers ready');
      startGraph('gpu');
      setBlockActive('gpu', true, 0);
      setStatus('● BENCHMARK IN PROGRESS', 'GPU MATMUL · DO NOT SWITCH TABS');
    } else {
      appendLog('init  → web workers ready · web crypto ready');
      appendLog(`init  → webgpu unavailable · gpu test skipped`);
      // Deliberately do NOT startGraph('gpu') — the RAF re-arms outside the
      // running guard, so a started-then-stopped graph freezes a realistic
      // looking waveform on screen forever. A blank canvas is the honest state.
      setBlockUnmeasured('gpu');
      $('#nogpu-notice')?.removeAttribute('hidden');
      startGraph('cpu');
      setBlockActive('cpu', true, 0);
      setStatus('● BENCHMARK IN PROGRESS', 'CPU + RAM ONLY · NO WEBGPU · DO NOT SWITCH TABS');
    }

    let result: any;
    try {
      result = await runFullBench((stage: StageKey, percent: number, message: string) => {
        // Map runner stages to our 3-block UI. We fake a smooth 0→100
        // global progress by weighting: GPU 35%, CPU 35%, RAM 30%.
        if (stage === 'gpu') {
          // Without WebGPU the GPU stage still fires (the runner calls the
          // probe and reports "not available") — but the block must stay in
          // its unmeasured state and the CPU graph is already running.
          if (!webgpuAvailable) {
            if (percent >= 100) appendLog(`gpu   → skipped · ${webgpuReason}`);
            return;
          }
          setBlockActive('gpu', percent < 100, percent);
          if (percent >= 100) {
            stopGraph('gpu');
            startGraph('cpu');
            setBlockActive('cpu', true, 0);
            setStatus('● BENCHMARK IN PROGRESS', 'CPU SHA-256 · WEB WORKERS');
            appendLog(`gpu   → ${message.toLowerCase()}`);
          } else {
            // Show in-progress dispatch info on first call
            if (percent === 0) appendLog('gpu   → submitting matmul 1024×1024 fp32 ×8 …');
          }
          setProgress(percent * 0.35);
        } else if (stage === 'cpu') {
          setBlockActive('cpu', percent < 100, percent);
          if (percent >= 100) {
            stopGraph('cpu');
            startGraph('ram');
            setBlockActive('ram', true, 0);
            setStatus('● BENCHMARK IN PROGRESS', 'RAM BANDWIDTH · SEQ + RANDOM');
            appendLog(`cpu   → ${message.toLowerCase()}`);
          } else if (percent === 0) {
            appendLog('cpu   → spawning workers · sha256 single + multi');
          }
          // Reweight when the GPU stage contributes nothing, so the bar
          // rises smoothly instead of jumping 0→35% in a few milliseconds.
          setProgress(webgpuAvailable ? 35 + percent * 0.35 : percent * 0.55);
        } else if (stage === 'ram') {
          setBlockActive('ram', percent < 100, percent);
          if (percent >= 100) {
            stopGraph('ram');
            setBlockActive('ram', false, 100);
            appendLog(`ram   → ${message.toLowerCase()}`);
            appendLog('score → composing 9bench score…');
          } else if (percent === 0) {
            appendLog('ram   → seq.read.64k commencing · sandboxed (browser-cap)');
          }
          setProgress(webgpuAvailable ? 70 + percent * 0.30 : 55 + percent * 0.45);
        } else if (stage === 'done') {
          setProgress(100);
          appendLog('done  → ' + message.toLowerCase());
        }
      });
    } catch (e: any) {
      stopGraph('gpu'); stopGraph('cpu'); stopGraph('ram');
      console.error('runFullBench failed', e);
      showError(e?.message || 'Benchmark execution failed. Try refreshing the page.');
      return;
    }

    // ── Update blocks with final values ───────────────────────────
    // result.gpu.supported is the post-run truth: it also covers the case
    // where the adapter existed but the bench then failed (device acquire,
    // shader verification, timer floor). Never print Math.round(0) here —
    // "0" next to GFLOPS reads as a measured zero.
    if (result.measured.gpu) {
      setBlockValue('gpu', Math.round(result.gpu.gflops).toLocaleString());
    } else {
      setBlockUnmeasured('gpu');
      $('#nogpu-notice')?.removeAttribute('hidden');
    }
    // Same rule for CPU and RAM: a failed phase used to render as "0k" / "0.0"
    // right next to a correctly-marked GPU block.
    if (result.measured.cpuMulti) {
      setBlockValue('cpu', Math.round(result.cpu.hashesPerSecondMulti / 1000).toLocaleString() + 'k');
    } else {
      setBlockUnmeasured('cpu', 'MULTI-CORE PHASE DID NOT REPORT');
    }
    if (result.measured.ram) {
      setBlockValue('ram', result.ram.readBandwidthGBs.toFixed(1));
    } else {
      setBlockUnmeasured('ram', 'MEMORY PHASE DID NOT REPORT');
    }

    // Variance: GPU has measurements[]; CPU/RAM not yet — show '—'
    if (result.gpu.measurements && result.gpu.measurements.length >= 3) {
      const m = result.gpu.measurements as number[];
      const min = Math.min(...m).toFixed(0);
      const avg = (m.reduce((a, b) => a + b, 0) / m.length).toFixed(0);
      const max = Math.max(...m).toFixed(0);
      setBlockVariance('gpu', min, avg, max);
    }

    const secs = (result.durationMs / 1000).toFixed(1);
    if (!result.scorable) {
      // Below the scoring floor: too much of the benchmark failed for the
      // composite to mean anything. Show what did measure, never a number
      // built on the parts that didn't.
      const missing = [
        !result.measured.cpuMulti ? 'CPU multi-core' : null,
        !result.measured.ram ? 'memory bandwidth' : null,
        !result.measured.gpu ? 'GPU' : null,
      ].filter(Boolean).join(', ');
      appendLog(`run   → incomplete · not measured: ${missing}`);
      appendLog('run   → not scored · not submitted');
      setStatus('⚠ INCOMPLETE RUN', `${secs}s · not enough measured to score`);
      showError(
        `This run measured too little to produce a score. Missing: ${missing}. ` +
        `We won't combine what's left into a composite and call it your machine's score — ` +
        `the missing parts carry most of the weight. Try running the test again.`
      );
      return;
    }

    setStatus(
      result.measured.gpu ? '✓ TEST COMPLETE' : '✓ TEST COMPLETE (CPU + RAM)',
      result.measured.gpu
        ? `${secs}s · submitting…`
        : `${secs}s · gpu not measured · submitting…`
    );
    appendLog(`score → ${result.scores.overall.toLocaleString()} (overall)`);

    // ── Consent check (GDPR Art. 6(1)(a)) ─────────────────────────
    // If the consent box was unchecked before clicking Start, we don't
    // submit — the user sees their result locally on this page only.
    if (!userConsent) {
      appendLog('consent → not given · result stays local (not submitted)');
      setStatus('✓ TEST COMPLETE (LOCAL)', 'no submission per your consent setting');
      return;
    }

    // Timing measured across a backgrounded tab is throttled and therefore
    // meaningless. Show the user their run, but keep it out of the pool.
    if (wentHidden) {
      appendLog('run   → tab was backgrounded · result kept local (timing unreliable)');
      setStatus('✓ TEST COMPLETE (LOCAL)', 'tab lost focus mid-run — not submitted');
      return;
    }

    // ── Submit + redirect ─────────────────────────────────────────
    try {
      const submitRes = await fetch('/api/submit', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          scores: result.scores,
          gpu: { gflops: result.gpu.gflops, adapterName: result.hardware.gpu },
          cpu: result.cpu,
          ram: result.ram,
          hardware: result.hardware,
          durationMs: result.durationMs,
          // v3.6 estimator: fixed-time multi-core window with summed per-worker
          // rates, and a median (not max) GPU headline. Declared so the server
          // ranks this run against other v3.6 runs and not against numbers
          // produced by the old estimator.
          estimatorVersion: 2,
          workerElapsedMs: result.cpu.workerElapsedMs,
          // ── Phase G: AI capabilities snapshot ──
          // We send only the small subset needed to reproduce predictions
          // for visitors of /r/[id] (score, tier, memory headroom, FP16).
          // Full predictions are regenerated client-side from these +
          // gpu_gflops + ram_read_gbs (already in main result).
          ai: result.ai ? {
            score: result.ai.score,
            tier:  result.ai.tier,
            memory: { largestAllocatableGB: result.ai.memory.largestAllocatableGB },
            webgpu: { fp16: result.ai.webgpu.fp16 },
          } : undefined,
        }),
      });
      if (submitRes.ok) {
        const submitted = await submitRes.json() as { id?: string };
        if (submitted.id) {
          // Permalink FIRST — the scored result is saved; everything after
          // this line is optional and skippable.
          appendLog(`submit → /r/${submitted.id}`);

          // ── v3.7 SHADOW PHASE — v4.0 candidate workload, unscored ──
          // Runs strictly AFTER the scored result is stored: ~12s of extra
          // all-core load before or between scored phases would heat the
          // chip and silently depress scored phone numbers. Here it can
          // contaminate nothing by construction. A shadow failure of any
          // kind must never strand the user — worst case is one log line
          // and the normal redirect.
          const totalElapsedS = (Date.now() - startedAt) / 1000;
          const shadowEligible =
            typeof WebAssembly !== 'undefined' &&
            totalElapsedS < 90;   // slowest devices: highest bail risk, worst data
          if (shadowEligible) {
            try {
              setStatus('✓ RESULT SAVED', 'running experimental v4.0 workload · skippable');
              appendLog('shadow → experimental v4.0 workload (~12s) · not scored · does not affect your result');
              appendLog(`shadow → click your result link above to skip: /r/${submitted.id}`);
              let shadowHidden = document.hidden;
              const onVis = () => { if (document.hidden) shadowHidden = true; };
              document.addEventListener('visibilitychange', onVis);
              const { runCPUBenchV4 } = await import('../bench/cpu-test-v4');
              const shadow = await runCPUBenchV4({
                singleMs: 1200, multiWindowMs: 4000, warmupMs: 300, probe: true,
                onLog: appendLog,
              });
              document.removeEventListener('visibilitychange', onVis);
              await fetch('/api/shadow', {
                method: 'POST',
                headers: { 'content-type': 'application/json' },
                body: JSON.stringify({
                  resultId: submitted.id,
                  wl: shadow.wl,
                  probeHashesSingle: shadow.probeHashesSingle,
                  intSingle: shadow.intSingle,
                  fpSingle: shadow.fpSingle,
                  intMulti: shadow.intMulti,
                  fpMulti: shadow.fpMulti,
                  singleElapsedMs: shadow.singleElapsedMs,
                  multiWindowMs: shadow.multiWindowMs,
                  workersSpawned: shadow.workersSpawned,
                  workersReported: shadow.workersReported,
                  intWorkerRates: shadow.intWorkerRates,
                  fpWorkerRates: shadow.fpWorkerRates,
                  clockSkewMs: shadow.clockSkewMs,
                  verifyOk: shadow.verifyOk,
                  verifyFailKernel: shadow.verifyFailKernel,
                  wentHidden: shadowHidden,
                  shadowElapsedMs: shadow.shadowElapsedMs,
                  cores: navigator.hardwareConcurrency || undefined,
                  error: shadow.error,
                }),
              }).catch(() => { /* shadow row lost, user unaffected */ });
              appendLog('shadow → recorded (unvalidated · not comparable to anything yet)');
            } catch (e) {
              appendLog('shadow → skipped (candidate failed to run — your result is unaffected)');
              console.warn('shadow phase failed (non-fatal):', e);
            }
          }

          setStatus('✓ COMPLETE', 'redirecting to your result…');
          // Tiny delay so the user sees the success state before navigation
          setTimeout(() => { window.location.href = `/r/${submitted.id}/`; }, 600);
          return;
        }
      }
      // Submit failed but bench succeeded — show local result without permalink
      appendLog('submit → offline · result not saved (try again later)');
      setStatus('✓ TEST COMPLETE (LOCAL)', 'submission failed — your bench data is intact');
    } catch (e: any) {
      console.warn('submit failed', e);
      appendLog('submit → network error · result not saved');
    }
  }

  // ── User consent state (set on Start click) ─────────────────────
  // GDPR Art. 6(1)(a): the consent box on the intro screen determines
  // whether we submit results to D1. Default is "checked" (submit).
  // If the user unchecks before clicking Start, we run the benchmark
  // but don't submit — they see their result locally on /test.
  let userConsent = true;

  // ── Gate the benchmark behind explicit Start click ──────────────
  // Previously auto-started on mount → not GDPR-compliant for auto-submit.
  // Now: user reads the consent screen, makes their choice, clicks Start.
  function onStartClicked() {
    const consentBox = document.getElementById('consent-submit') as HTMLInputElement | null;
    userConsent = consentBox?.checked ?? true;

    // Guard against double-starts: on slow devices the reveal frame can
    // lag (RUM: INP poor events on this button) and users click again —
    // two concurrent runFullBench calls would fight over the GPU.
    if (startBtn) (startBtn as HTMLButtonElement).disabled = true;

    // Hide intro, show test UI
    const intro = document.getElementById('test-intro');
    const ui    = document.getElementById('test-ui');
    if (intro) intro.setAttribute('hidden', '');
    if (ui)    ui.removeAttribute('hidden');

    // Wait one tick so the test-ui layout settles + canvases get their
    // measured size before we start drawing. rAF is throttled to zero in a
    // backgrounded tab, so a user who clicks Start and immediately switches
    // apps would never start the run at all and be left with a dead button —
    // a timer fallback guarantees the run begins either way.
    let started = false;
    const kickOff = () => { if (started) return; started = true; runBench(); };
    requestAnimationFrame(() => requestAnimationFrame(kickOff));
    setTimeout(kickOff, 250);
  }

  const startBtn = document.getElementById('start-btn');
  if (startBtn) startBtn.addEventListener('click', onStartClicked);
</script>
