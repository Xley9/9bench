---
/**
 * /r/[id] — Hybrid Result + Share page.
 *
 * Layout: V2 Editorial (big score, narrative) + V1 viral assets
 * (HardwareComparisonBars, action stack with PNG export).
 *
 * Architecture: client-side fetch /api/r/[id] (Astro doesn't pre-render
 * dynamic D1 routes on Cloudflare Pages). Static HTML shell renders
 * skeleton; JS populates real data after fetch.
 *
 * PNG export: html-to-image captures the .trading-card DOM element
 * directly (no React island needed — simpler, smaller bundle).
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import TruthDisclaimer from '../../components/bench/TruthDisclaimer.astro';
import { tierFor, PERCENTILE_MIN_N } from '../../components/bench/tier-system';
---

<BaseLayout
  title="Score — 9bench"
  description="Browser-based hardware benchmark result. Test yours at 9bench.com — no download, no account, no bias."
>
  <main class="container result-page">

    <!-- ── Loading state (replaced after fetch) ─────────────────── -->
    <div id="loading" class="loading-state">
      <div class="loading-state__pulse" aria-hidden="true"></div>
      <p class="loading-state__text">Loading result…</p>
    </div>

    <!-- ── Error state (shown if fetch fails) ───────────────────── -->
    <div id="error" class="error-state" hidden>
      <h2 class="section-h" style="font-size: 32px;">Result not found</h2>
      <p class="text-fg-2 font-mono" style="font-size: 13px; margin: 16px 0 24px;" id="error-message">—</p>
      <a href="/" class="btn-outline">← Test your hardware</a>
    </div>

    <!-- ── Result content (populated client-side) ───────────────── -->
    <article id="result" class="result" hidden>

      <!-- Header strip -->
      <header class="result__header">
        <div class="result__header-left">
          <span class="pill pill--accent" id="result-status">✓ TEST COMPLETE</span>
          <span class="pill" id="result-browser">—</span>
        </div>
        <div class="result__header-right">
          <span class="text-fg-3 font-mono" style="font-size: 11px; letter-spacing: 0.08em;">
            9BENCH SCORE · <span id="result-date">—</span>
          </span>
        </div>
      </header>

      <!-- Hero: score + narrative -->
      <section class="result__hero">
        <div class="result__hero-score">
          <div class="result__big tnum" id="result-score">—</div>
          <div class="result__tier" id="result-tier">
            <span class="result__tier-label" id="tier-label">—</span>
            <span class="result__tier-sub"   id="tier-sub">—</span>
          </div>
        </div>
        <div class="result__hero-narrative">
          <p class="result__narrative" id="result-narrative">—</p>
          <p class="result__rank font-mono" id="result-rank">—</p>
        </div>
      </section>

      <!-- ── Component imbalance callout (Phase G.4) ─────────────── -->
      <!-- Visible only when an imbalance is detected (RAM browser-cap excluded).
           Tells the user which component is bottlenecking — actionable
           upgrade guidance UserBenchmark/Geekbench don't provide. -->
      <aside id="imbalance-callout" class="imbalance-callout" hidden>
        <span class="imbalance-callout__icon" aria-hidden="true">⚡</span>
        <div class="imbalance-callout__body">
          <strong id="imbalance-title">—</strong>
          <p id="imbalance-detail">—</p>
        </div>
      </aside>

      <!-- Component breakdown (4-card grid) -->
      <section class="component-grid">
        <article class="component-card">
          <span class="component-card__label">— GPU</span>
          <div class="component-card__value tnum" id="comp-gpu">—</div>
          <div class="component-card__sub" id="comp-gpu-sub">—</div>
        </article>
        <article class="component-card">
          <span class="component-card__label">— CPU·1</span>
          <div class="component-card__value tnum" id="comp-cpu1">—</div>
          <div class="component-card__sub" id="comp-cpu1-sub">single-core</div>
        </article>
        <article class="component-card">
          <span class="component-card__label">— CPU·M</span>
          <div class="component-card__value tnum" id="comp-cpum">—</div>
          <div class="component-card__sub" id="comp-cpum-sub">multi-core</div>
        </article>
        <article class="component-card">
          <span class="component-card__label">— RAM</span>
          <div class="component-card__value tnum" id="comp-ram">—</div>
          <div class="component-card__sub" id="comp-ram-sub">—</div>
        </article>
      </section>

      <!-- ── AI Capabilities Section (Phase G — differentiator) ──────
           This is the section UserBenchmark / Geekbench / Cinebench do not
           have. 2026 hardware purchase is increasingly driven by "can it
           run Llama 13B?" — 9bench answers concretely, with reasoning. -->
      <section class="ai-section" id="ai-section" hidden>
        <header class="ai-section__head">
          <div class="eyebrow eyebrow--accent">// LOCAL AI · WHAT YOUR PC CAN RUN</div>
          <div class="ai-section__head-row">
            <h2 class="ai-section__h2" id="ai-tier-letter">—</h2>
            <div class="ai-section__head-text">
              <p class="ai-section__tier-sub" id="ai-tier-sub">—</p>
              <p class="ai-section__score">
                AI Capability Score · <span class="text-fg tnum" id="ai-score">—</span>
              </p>
            </div>
          </div>
        </header>

        <!-- WebGPU feature inventory — proof the score is grounded -->
        <div class="ai-section__features">
          <div class="ai-feat" id="ai-feat-fp16">
            <span class="ai-feat__icon">—</span>
            <div>
              <strong>FP16 (shader-f16)</strong>
              <span class="ai-feat__sub" id="ai-feat-fp16-sub">—</span>
            </div>
          </div>
          <div class="ai-feat" id="ai-feat-buffer">
            <span class="ai-feat__icon">—</span>
            <div>
              <strong>Memory headroom</strong>
              <span class="ai-feat__sub" id="ai-feat-buffer-sub">—</span>
            </div>
          </div>
          <div class="ai-feat" id="ai-feat-webgpu">
            <span class="ai-feat__icon">—</span>
            <div>
              <strong>WebGPU compute</strong>
              <span class="ai-feat__sub" id="ai-feat-webgpu-sub">—</span>
            </div>
          </div>
        </div>

        <!-- Predictions — concrete workload outcomes -->
        <div class="ai-predictions" id="ai-predictions">
          <!-- populated by JS -->
        </div>

        <!-- Methodology footnote -->
        <p class="ai-section__note">
          <strong>How these predictions work:</strong>
          We measure GPU compute (browser ≈ 35% of native), memory bandwidth
          (browser ≈ 40% of native), and largest allocatable buffer. Predictions
          extrapolate to native performance using documented scaling.
          <a href="/methodology#ai">Read the AI methodology →</a>
        </p>
      </section>

      <!-- Pre-Phase-G fallback: result was captured before AI probe existed -->
      <section class="ai-section ai-section--legacy" id="ai-section-legacy" hidden>
        <header class="ai-section__head">
          <div class="eyebrow eyebrow--accent">// LOCAL AI</div>
          <h2 class="ai-section__legacy-h2">AI capability not measured for this run</h2>
          <p class="ai-section__legacy-p">
            This result was captured before 9bench added local-AI capability
            scoring. <a href="/test/" class="text-accent">Run a fresh test</a>
            to see what your machine can run locally — Llama, SDXL, Whisper.
          </p>
        </header>
      </section>

      <!-- Two-column: detected hardware + trading card -->
      <section class="result__main">
        <div class="result__col-left">

          <h3 class="result__section-h">— Detected hardware</h3>
          <div class="hw-rows">
            <div class="hw-row">
              <span class="hw-row__label">GPU</span>
              <span class="hw-row__value" id="hw-gpu">—</span>
            </div>
            <div class="hw-row">
              <span class="hw-row__label">CPU</span>
              <span class="hw-row__value" id="hw-cpu">—</span>
            </div>
            <div class="hw-row">
              <span class="hw-row__label">RAM</span>
              <span class="hw-row__value" id="hw-ram">—</span>
            </div>
            <div class="hw-row">
              <span class="hw-row__label">Browser</span>
              <span class="hw-row__value" id="hw-browser">—</span>
            </div>
          </div>

          <!-- VS. KNOWN HARDWARE (V1 viral asset) -->
          <h3 class="result__section-h">— vs. known hardware</h3>
          <div id="cmp-bars" class="cmp-bars">
            <!-- Phase 2 placeholder: shown until reference_hardware D1 table is seeded -->
            <p class="cmp-bars__placeholder font-mono">
              <span class="text-warn">Phase 2:</span>
              comparison data unlocks once reference hardware is seeded.
              <a href="/methodology" class="text-accent">How this works →</a>
            </p>
          </div>

          <!-- Raw measurements (collapsible) -->
          <details class="raw-measurements">
            <summary class="raw-measurements__summary">
              — Raw measurements
              <span class="raw-measurements__hint">click to expand</span>
            </summary>
            <div class="raw-measurements__body">
              <div class="result-row">
                <span class="result-row-label">GPU compute</span>
                <span class="result-row-value tnum" id="raw-gflops">—</span>
              </div>
              <div class="result-row">
                <span class="result-row-label">CPU cores</span>
                <span class="result-row-value tnum" id="raw-cores">—</span>
              </div>
              <div class="result-row">
                <span class="result-row-label">SHA-256 single</span>
                <span class="result-row-value tnum" id="raw-sha-single">—</span>
              </div>
              <div class="result-row">
                <span class="result-row-label">SHA-256 multi</span>
                <span class="result-row-value tnum" id="raw-sha-multi">—</span>
              </div>
              <div class="result-row">
                <span class="result-row-label">RAM read</span>
                <span class="result-row-value tnum" id="raw-ram-read">—</span>
              </div>
              <div class="result-row">
                <span class="result-row-label">RAM write</span>
                <span class="result-row-value tnum" id="raw-ram-write">—</span>
              </div>
              <div class="result-row">
                <span class="result-row-label">RAM random latency</span>
                <span class="result-row-value tnum" id="raw-ram-latency">—</span>
              </div>
            </div>
          </details>
        </div>

        <!-- Right column: Trading Card + Share Actions -->
        <aside class="result__col-right">

          <!-- TRADING CARD — captured by html-to-image for PNG export -->
          <div class="trading-card-wrap">
            <div class="trading-card" id="trading-card">
              <div class="trading-card__head">
                <span>9BENCH · TRUTH SERIES</span>
                <span id="card-id">—</span>
              </div>
              <div>
                <span class="trading-card__score tnum" id="card-score">—</span>
                <span class="trading-card__tier" id="card-tier">—</span>
              </div>
              <div class="trading-card__hw" id="card-hw">—</div>
              <div class="trading-card__components">
                <div class="trading-card__comp">
                  <span class="trading-card__comp-label">— GPU</span>
                  <span class="trading-card__comp-value tnum" id="card-gpu">—</span>
                </div>
                <div class="trading-card__comp">
                  <span class="trading-card__comp-label">— CPU·1</span>
                  <span class="trading-card__comp-value tnum" id="card-cpu1">—</span>
                </div>
                <div class="trading-card__comp">
                  <span class="trading-card__comp-label">— CPU·M</span>
                  <span class="trading-card__comp-value tnum" id="card-cpum">—</span>
                </div>
                <div class="trading-card__comp">
                  <span class="trading-card__comp-label">— RAM</span>
                  <span class="trading-card__comp-value tnum" id="card-ram">—</span>
                </div>
              </div>
              <div class="trading-card__pct" id="card-pct">—</div>
              <div class="trading-card__url" id="card-url">9bench.com/r/—</div>
            </div>
          </div>

          <!-- Share Actions Stack -->
          <div class="share-actions">
            <a href="#" class="share-actions__primary" id="share-beat">
              BEAT MY SCORE →
              <span class="share-actions__url" id="share-url-display">9bench.com/r/—</span>
            </a>
            <button type="button" class="share-actions__btn" id="share-png">↓ DOWNLOAD CARD AS PNG · 1080×1350</button>
            <button type="button" class="share-actions__btn" id="share-link">🔗 COPY LINK</button>
            <button type="button" class="share-actions__btn" id="share-twitter">𝕏 / TWITTER</button>
            <button type="button" class="share-actions__btn" id="share-reddit">🟧 POST TO REDDIT</button>
            <button type="button" class="share-actions__btn" id="share-json">{ } EXPORT RAW JSON</button>
          </div>

          <!-- Permalink reminder -->
          <div class="permalink-reminder">
            <span class="permalink-reminder__label">// PERMALINK</span>
            <span class="permalink-reminder__url" id="permalink-url">9bench.com/r/—</span>
            <span class="permalink-reminder__sub">
              Anonymous. No fingerprint stored. Open across devices, share with anyone.
            </span>
          </div>
        </aside>
      </section>

      <!-- Truth Disclaimer (always shown) -->
      <section style="padding: 32px 0;">
        <TruthDisclaimer />
      </section>

      <!-- CTA back to test -->
      <section class="result__cta">
        <a href="/test/" class="run-btn">▶ TEST AGAIN</a>
        <a href="/methodology" class="btn-outline">Read the methodology</a>
      </section>
    </article>
  </main>
</BaseLayout>

<style>
  .result-page {
    padding: 24px 0 56px;
  }

  /* Loading + error states */
  .loading-state, .error-state {
    text-align: center;
    padding: 96px 0;
  }
  .loading-state__pulse {
    width: 14px; height: 14px;
    background: var(--accent);
    margin: 0 auto 18px;
    animation: pulse 1.2s ease-in-out infinite;
  }
  .loading-state__text {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-3);
  }

  /* Header strip */
  .result__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    padding: 12px 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    margin-bottom: 56px;
  }
  .result__header-left { display: flex; gap: 8px; flex-wrap: wrap; }

  /* Hero */
  .result__hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    margin-bottom: 56px;
    align-items: end;
  }
  @media (min-width: 1024px) {
    .result__hero { grid-template-columns: 1.4fr 1fr; gap: 56px; }
  }
  .result__hero-score {
    display: flex;
    align-items: end;
    gap: 24px;
    flex-wrap: wrap;
  }
  .result__big {
    font-family: var(--sans);
    font-weight: 800;
    font-size: clamp(80px, 14vw, 200px);
    line-height: 0.85;
    letter-spacing: -0.04em;
    color: var(--fg);
  }
  .result__tier {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-bottom: 16px;
  }
  .result__tier-label {
    font-family: var(--mono);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .result__tier-sub {
    font-family: var(--sans);
    font-size: 14px;
    color: var(--fg-2);
  }

  .result__hero-narrative {
    padding-bottom: 16px;
  }
  .result__narrative {
    font-family: var(--sans);
    font-size: 17px;
    line-height: 1.55;
    color: var(--fg-2);
    margin: 0 0 16px 0;
    max-width: 480px;
  }
  .result__rank {
    font-size: 12px;
    color: var(--fg-3);
    letter-spacing: 0.04em;
  }

  /* Component grid (4 cards) */
  .component-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    margin-bottom: 56px;
  }
  @media (min-width: 768px) {
    .component-grid { grid-template-columns: repeat(4, 1fr); }
  }
  .component-card {
    background: var(--bg-2);
    padding: 24px 22px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .component-card__label {
    font-family: var(--mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .component-card__value {
    font-family: var(--sans);
    font-weight: 800;
    font-size: clamp(36px, 4vw, 56px);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--fg);
  }
  .component-card__sub {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--fg-3);
    margin-top: auto;
    letter-spacing: 0.03em;
  }

  /* Main two-column area */
  .result__main {
    display: grid;
    grid-template-columns: 1fr;
    gap: 48px;
  }
  @media (min-width: 1024px) {
    .result__main { grid-template-columns: 1.4fr 1fr; gap: 48px; }
  }
  .result__section-h {
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fg-3);
    margin: 0 0 16px 0;
  }
  .result__section-h:not(:first-child) { margin-top: 40px; }

  /* Hardware rows */
  .hw-rows {
    border-top: 1px solid var(--line-2);
  }
  .hw-row {
    display: flex;
    justify-content: space-between;
    gap: 14px;
    padding: 12px 0;
    border-bottom: 1px solid var(--line-2);
    font-family: var(--mono);
    font-size: 13px;
  }
  .hw-row__label {
    color: var(--fg-3);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    flex: 0 0 90px;
  }
  .hw-row__value {
    color: var(--fg);
    text-align: right;
    flex: 1;
    word-break: break-word;
  }

  /* Comparison bars (Phase 2 placeholder for now) */
  .cmp-bars__placeholder {
    padding: 14px 16px;
    border: 1px dashed var(--line);
    background: var(--bg-2);
    font-size: 12px;
    line-height: 1.6;
    color: var(--fg-2);
  }

  /* Raw measurements (collapsible) */
  .raw-measurements {
    margin-top: 32px;
    border-top: 1px solid var(--line);
    padding-top: 16px;
  }
  .raw-measurements__summary {
    cursor: pointer;
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fg-3);
    list-style: none;
    display: flex;
    justify-content: space-between;
    padding: 8px 0;
  }
  .raw-measurements__summary::-webkit-details-marker { display: none; }
  .raw-measurements__hint {
    color: var(--fg-4);
    font-weight: 400;
    text-transform: none;
    letter-spacing: 0.04em;
  }
  .raw-measurements[open] .raw-measurements__hint { content: 'click to collapse'; }
  .raw-measurements__body {
    margin-top: 8px;
    border-top: 1px solid var(--line-2);
  }

  /* Right column: trading card + share actions */
  .result__col-right {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .trading-card-wrap {
    overflow-x: auto;
  }

  /* Share actions stack */
  .share-actions {
    display: flex;
    flex-direction: column;
    gap: 0;
    border: 1px solid var(--line);
  }
  .share-actions__primary {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
    padding: 14px 18px;
    background: var(--accent);
    color: #000;
    font-family: var(--mono);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    border-bottom: 1px solid #000;
  }
  .share-actions__primary:hover { background: var(--fg); }
  .share-actions__url {
    font-family: var(--mono);
    font-size: 10px;
    font-weight: 400;
    text-transform: lowercase;
    letter-spacing: 0;
    color: rgba(0, 0, 0, 0.55);
  }
  .share-actions__btn {
    background: transparent;
    color: var(--fg-2);
    border: 0;
    border-bottom: 1px solid var(--line);
    padding: 12px 18px;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    text-align: left;
    transition: color 0.15s, background 0.15s;
  }
  .share-actions__btn:last-child { border-bottom: 0; }
  .share-actions__btn:hover { color: var(--accent); background: var(--bg-2); }
  .share-actions__btn.is-success { color: var(--good); }

  /* Permalink reminder */
  .permalink-reminder {
    border: 1px solid var(--line);
    padding: 14px 16px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .permalink-reminder__label {
    font-family: var(--mono);
    font-size: 10px;
    color: var(--fg-3);
    letter-spacing: 0.12em;
  }
  .permalink-reminder__url {
    font-family: var(--mono);
    font-size: 13px;
    color: var(--accent);
    word-break: break-all;
  }
  .permalink-reminder__sub {
    font-family: var(--sans);
    font-size: 11px;
    color: var(--fg-3);
    line-height: 1.5;
  }

  /* CTA */
  .result__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    padding: 32px 0;
    border-top: 1px solid var(--line);
  }

  /* ── Component Imbalance Callout (Phase G.4) ─────────────────── */
  .imbalance-callout {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    padding: 16px 20px;
    margin: 0 0 32px 0;
    border-left: 3px solid var(--accent);
    background: rgba(0, 217, 255, 0.04);
  }
  :root[data-accent="orange"] .imbalance-callout {
    background: rgba(255, 107, 43, 0.04);
  }
  .imbalance-callout--warn {
    border-left-color: var(--warn);
    background: rgba(255, 87, 34, 0.04);
  }
  .imbalance-callout__icon {
    font-size: 22px;
    flex: 0 0 auto;
    color: var(--accent);
  }
  .imbalance-callout--warn .imbalance-callout__icon { color: var(--warn); }
  .imbalance-callout__body strong {
    display: block;
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 4px;
  }
  .imbalance-callout--warn .imbalance-callout__body strong { color: var(--warn); }
  .imbalance-callout__body p {
    margin: 0;
    font-family: var(--sans);
    font-size: 14px;
    line-height: 1.55;
    color: var(--fg-2);
  }

  /* ── AI Capabilities Section (Phase G) ───────────────────────── */
  .ai-section {
    padding: 48px 0;
    margin: 56px 0 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .ai-section__head { margin-bottom: 32px; }
  .ai-section__head-row {
    display: flex;
    gap: 24px;
    align-items: center;
    margin-top: 16px;
    flex-wrap: wrap;
  }
  .ai-section__h2 {
    font-family: var(--sans);
    font-weight: 800;
    font-size: clamp(64px, 10vw, 120px);
    line-height: 0.85;
    letter-spacing: -0.04em;
    margin: 0;
    color: var(--accent);
    flex: 0 0 auto;
  }
  .ai-section__head-text {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .ai-section__tier-sub {
    font-family: var(--sans);
    font-size: 18px;
    color: var(--fg);
    margin: 0;
    line-height: 1.3;
  }
  .ai-section__score {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--fg-3);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin: 0;
  }
  .ai-section__score .text-fg {
    font-weight: 700;
    font-size: 14px;
  }

  /* WebGPU feature inventory — 3-card grid */
  .ai-section__features {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    margin-bottom: 32px;
  }
  @media (min-width: 768px) {
    .ai-section__features { grid-template-columns: repeat(3, 1fr); }
  }
  .ai-feat {
    background: var(--bg-2);
    padding: 16px 18px;
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }
  .ai-feat__icon {
    font-size: 18px;
    color: var(--accent);
    flex: 0 0 auto;
    line-height: 1;
  }
  .ai-feat--ok    .ai-feat__icon { color: var(--good); }
  .ai-feat--warn  .ai-feat__icon { color: var(--warn); }
  .ai-feat--limit .ai-feat__icon { color: var(--fg-3); }
  .ai-feat strong {
    display: block;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg);
    margin-bottom: 4px;
  }
  .ai-feat__sub {
    display: block;
    font-family: var(--sans);
    font-size: 12px;
    color: var(--fg-2);
    line-height: 1.5;
  }

  /* Predictions list */
  .ai-predictions {
    display: flex;
    flex-direction: column;
    gap: 0;
    border: 1px solid var(--line);
    background: var(--bg-2);
  }
  .ai-pred {
    display: grid;
    grid-template-columns: 24px 1fr;
    gap: 14px;
    padding: 16px 20px;
    border-bottom: 1px solid var(--line-2);
    align-items: start;
  }
  .ai-pred:last-child { border-bottom: 0; }
  .ai-pred__verdict {
    font-family: var(--sans);
    font-weight: 800;
    font-size: 18px;
    line-height: 1;
    flex: 0 0 auto;
  }
  .ai-pred--yes   .ai-pred__verdict { color: var(--good); }
  .ai-pred--maybe .ai-pred__verdict { color: var(--accent); }
  .ai-pred--no    .ai-pred__verdict { color: var(--fg-3); }
  .ai-pred__body { display: flex; flex-direction: column; gap: 4px; }
  .ai-pred__name {
    font-family: var(--sans);
    font-weight: 600;
    font-size: 15px;
    color: var(--fg);
  }
  .ai-pred__perf {
    font-family: var(--mono);
    font-size: 13px;
    color: var(--accent);
    font-weight: 600;
  }
  .ai-pred--no .ai-pred__perf { color: var(--fg-3); text-decoration: line-through; }
  .ai-pred__reason {
    font-family: var(--sans);
    font-size: 12px;
    color: var(--fg-3);
    line-height: 1.55;
    margin-top: 2px;
  }

  .ai-section__note {
    margin-top: 24px;
    padding: 14px 18px;
    border: 1px dashed var(--line);
    font-family: var(--mono);
    font-size: 11px;
    line-height: 1.6;
    color: var(--fg-3);
  }
  .ai-section__note strong { color: var(--fg-2); }
  .ai-section__note a { color: var(--accent); }

  /* Legacy fallback when row predates Phase G */
  .ai-section--legacy { padding: 32px 0; }
  .ai-section__legacy-h2 {
    font-family: var(--sans);
    font-weight: 700;
    font-size: 22px;
    color: var(--fg-2);
    margin: 12px 0 8px 0;
  }
  .ai-section__legacy-p {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--fg-3);
    margin: 0;
  }
  .ai-section__legacy-p a { text-decoration: underline; }
</style>

<script>
  // ─────────────────────────────────────────────────────────────────
  //  RESULT PAGE — fetch + render + share actions
  // ─────────────────────────────────────────────────────────────────

  import { tierFor, PERCENTILE_MIN_N, shareText } from '../../components/bench/tier-system';
  import { toPng } from 'html-to-image';

  // AI tier label + color helper. Inlined here (rather than importing
  // the full ai-capabilities module) because Astro tree-shakes the
  // server-side `probeAICapabilities` away — we only need the visual
  // labels for previously-stored ai_tier strings.
  function aiTierLabel(tier: string): { letter: string; sub: string; color: string } {
    switch (tier) {
      case 'AI-S':           return { letter: 'S', sub: 'AI workstation — runs 13B LLMs and SDXL comfortably', color: 'var(--accent)' };
      case 'AI-A':           return { letter: 'A', sub: 'Strong local AI — 7-13B LLMs, SD 1.5 image generation', color: 'var(--good)' };
      case 'AI-B':           return { letter: 'B', sub: 'Capable — 7B LLMs, SD 1.5, smaller image models', color: 'var(--fg)' };
      case 'AI-Workstation': return { letter: '◯', sub: 'Limited — 7B Q4 marginal, smaller models work', color: 'var(--fg-2)' };
      case 'AI-Office':      return { letter: '◯', sub: 'Cloud-first — local AI is impractical on this hardware', color: 'var(--fg-3)' };
      case 'AI-Limited':     return { letter: '⚠', sub: 'Cloud-only — not a local-AI machine', color: 'var(--warn)' };
      default:               return { letter: '?', sub: 'Unknown AI tier', color: 'var(--fg-3)' };
    }
  }

  /**
   * Reproduce predictions client-side from stored result + AI metadata.
   * Mirrors generatePredictions() in src/bench/ai-capabilities.ts so the
   * source of truth lives next to the original probe.
   * Why duplicate: original lives in /src/bench/ which gets tree-shaken
   * server-side; importing it would pull in WebGPU probe code we don't
   * need on the result page.
   */
  function generatePredictionsClient(
    gpuGflops: number,
    ramReadGBs: number,
    largestAllocatableGB: number,
    fp16: boolean
  ): Array<{name: string; description: string; verdict: 'yes' | 'maybe' | 'no'; performance: string | null; reasoning: string; category: string}> {
    const NATIVE_RATIO = 0.35;
    const estimatedNativeGFLOPS = gpuGflops / NATIVE_RATIO;
    const estimatedNativeRAM = ramReadGBs / 0.4;
    const out: any[] = [];

    // Llama 7B Q4
    {
      const memT = (estimatedNativeRAM * 0.7) / 4;
      const compT = estimatedNativeGFLOPS / 50;
      const tps = Math.min(memT, compT);
      if (largestAllocatableGB < 4) {
        out.push({ name: 'Llama 7B (Q4)', description: 'Local LLM, 7B params, 4-bit quantized', verdict: 'no', performance: null,
          reasoning: `Browser memory headroom is ${largestAllocatableGB.toFixed(1)} GB; 7B Q4 needs ~4 GB just for weights.`, category: 'llm' });
      } else if (tps >= 15) {
        out.push({ name: 'Llama 7B (Q4)', description: 'Local LLM, 7B params, 4-bit quantized', verdict: 'yes',
          performance: `~${Math.round(tps - 5)}–${Math.round(tps + 10)} tokens/s`,
          reasoning: `Memory bandwidth (${ramReadGBs.toFixed(1)} GB/s browser ≈ ${estimatedNativeRAM.toFixed(0)} GB/s native est.) supports comfortable inference.`, category: 'llm' });
      } else {
        out.push({ name: 'Llama 7B (Q4)', description: 'Local LLM, 7B params, 4-bit quantized', verdict: 'maybe',
          performance: `~${Math.max(2, Math.round(tps - 3))}–${Math.round(tps + 5)} tokens/s`,
          reasoning: 'Will run but slowly — bandwidth-bound. RAM upgrade or faster storage helps.', category: 'llm' });
      }
    }
    // Llama 13B Q4
    {
      const tps = (estimatedNativeRAM * 0.7) / 8;
      if (largestAllocatableGB < 8) {
        out.push({ name: 'Llama 13B (Q4)', description: 'Local LLM, 13B params, 4-bit quantized', verdict: 'no', performance: null,
          reasoning: `Needs ~8 GB for weights; browser allocated only ${largestAllocatableGB.toFixed(1)} GB max.`, category: 'llm' });
      } else if (tps >= 8) {
        out.push({ name: 'Llama 13B (Q4)', description: 'Local LLM, 13B params, 4-bit quantized', verdict: 'yes',
          performance: `~${Math.max(3, Math.round(tps - 3))}–${Math.round(tps + 5)} tokens/s`,
          reasoning: 'Bandwidth supports usable inference. Suitable for chatbot use cases.', category: 'llm' });
      } else {
        out.push({ name: 'Llama 13B (Q4)', description: 'Local LLM, 13B params, 4-bit quantized', verdict: 'maybe',
          performance: `~${Math.max(2, Math.round(tps - 1))}–${Math.round(tps + 2)} tokens/s`,
          reasoning: 'Functional but slow. OK for batch jobs, not interactive chat.', category: 'llm' });
      }
    }
    // Llama 70B — always no for browser
    out.push({ name: 'Llama 70B (Q4)', description: 'Large flagship LLM, 70B params', verdict: 'no', performance: null,
      reasoning: 'Needs ~40 GB just for weights. Browser memory model caps allocation well below this. Use a native llama.cpp setup with 64 GB+ RAM.', category: 'llm' });

    // SDXL
    {
      if (!fp16) {
        out.push({ name: 'Stable Diffusion XL (1024×1024)', description: 'High-resolution image generation', verdict: 'maybe',
          performance: 'No estimate — FP16 unsupported',
          reasoning: "Your WebGPU adapter doesn't expose shader-f16. SDXL works in FP32 but is ~3× slower and may exceed memory limits.", category: 'image' });
      } else if (gpuGflops >= 800) {
        out.push({ name: 'Stable Diffusion XL (1024×1024)', description: 'High-resolution image generation', verdict: 'yes',
          performance: '~20-40s per image',
          reasoning: `GPU compute (${gpuGflops.toFixed(0)} GFLOPS browser) and FP16 support give you usable SDXL throughput.`, category: 'image' });
      } else if (gpuGflops >= 400) {
        out.push({ name: 'Stable Diffusion XL (1024×1024)', description: 'High-resolution image generation', verdict: 'maybe',
          performance: '~60-120s per image',
          reasoning: 'Will run but expect minute-plus generation times. Consider SD 1.5 (512×512) for faster results.', category: 'image' });
      } else {
        out.push({ name: 'Stable Diffusion XL (1024×1024)', description: 'High-resolution image generation', verdict: 'no', performance: null,
          reasoning: `GPU compute (${gpuGflops.toFixed(0)} GFLOPS) is below the practical floor for SDXL. Use cloud or a more powerful GPU.`, category: 'image' });
      }
    }
    // SD 1.5
    {
      if (gpuGflops >= 200) {
        out.push({ name: 'Stable Diffusion 1.5 (512×512)', description: 'Standard image generation', verdict: 'yes',
          performance: gpuGflops >= 500 ? '~5-15s per image' : '~15-30s per image',
          reasoning: 'Light enough to run smoothly on your hardware. Good for ideation.', category: 'image' });
      } else {
        out.push({ name: 'Stable Diffusion 1.5 (512×512)', description: 'Standard image generation', verdict: 'maybe',
          performance: '~30-60s per image',
          reasoning: 'Functional but slow — usable for occasional generation, not iterative work.', category: 'image' });
      }
    }
    // Whisper
    {
      if (gpuGflops >= 150 && largestAllocatableGB >= 1) {
        out.push({ name: 'Whisper Small (audio→text)', description: 'Real-time speech-to-text', verdict: 'yes',
          performance: gpuGflops >= 400 ? 'Faster than real-time (~3-5×)' : 'Near real-time (~1-2×)',
          reasoning: 'Whisper is light (~244M params); your hardware handles it comfortably.', category: 'audio' });
      } else {
        out.push({ name: 'Whisper Small (audio→text)', description: 'Real-time speech-to-text', verdict: 'maybe',
          performance: 'Slower than real-time',
          reasoning: 'Will run but transcription will lag the audio. Consider Whisper Tiny for faster pace.', category: 'audio' });
      }
    }
    return out;
  }

  const $ = <T extends HTMLElement = HTMLElement>(sel: string) =>
    document.querySelector(sel) as T | null;
  const $$ = (sel: string) => Array.from(document.querySelectorAll(sel));

  const loadingEl = $('#loading')!;
  const errorEl   = $('#error')!;
  const resultEl  = $('#result')!;

  // Extract id from URL: /r/abc12345/ or /r/abc12345
  const pathParts = window.location.pathname.split('/').filter(Boolean);
  const resultId  = (pathParts[1] || '').toLowerCase();

  function fmt(n: number): string {
    return Number(n).toLocaleString();
  }
  function ordinal(n: number): string {
    const s = ['th','st','nd','rd'];
    const v = n % 100;
    return n + (s[(v - 20) % 10] || s[v] || s[0]);
  }
  function setText(sel: string, text: string) {
    const el = $(sel); if (el) el.textContent = text;
  }

  /**
   * Build the narrative paragraph from real data.
   * Avoids fabrication — only references measurements that exist.
   */
  function narrativeFor(r: any, percentile: number, total: number): string {
    const tier = tierFor(r.scores.overall);
    const isStrong = r.scores.overall >= 1700;
    const isMid    = r.scores.overall >= 1000;
    const isLow    = r.scores.overall < 500;

    // Identify component imbalance (RAM is structurally low in browsers,
    // so don't shame it — but if GPU or CPU is much weaker than the others,
    // call it out)
    const components = [
      ['GPU', r.scores.gpu],
      ['CPU', r.scores.cpuMulti],
    ] as Array<[string, number]>;
    const max = Math.max(...components.map(c => c[1]));
    const min = Math.min(...components.map(c => c[1]));
    const weakest = components.find(c => c[1] === min)?.[0];
    const imbalanced = max > 0 && (min / max) < 0.45;

    if (isStrong) {
      return imbalanced
        ? `Strong overall, but ${weakest} lags noticeably. Likely your next upgrade target.`
        : `Strong configuration. You're paying enough that this is what you should expect.`;
    }
    if (isMid) {
      return `Solid working machine. Office, browser-everything, light gaming — fine. Demanding 2026 tasks (local LLMs, 4K editing) will feel the squeeze.`;
    }
    if (isLow) {
      return `Built for spreadsheets, not silicon-flexing. That's totally fine — calibrate expectations.`;
    }
    return `Functional everyday machine. Replacement cycle approaching for creative or technical work.`;
  }

  async function load() {
    if (!/^[a-f0-9]{8}$/.test(resultId)) {
      loadingEl.hidden = true;
      errorEl.hidden = false;
      $('#error-message')!.textContent = 'Invalid result ID format. Try the homepage.';
      return;
    }

    try {
      const res = await fetch(`/api/r/${resultId}`);
      if (!res.ok) {
        const errBody = await res.json().catch(() => ({}));
        throw new Error((errBody as any).error || `HTTP ${res.status}`);
      }
      const data = await res.json() as any;
      if (!data.ok) throw new Error(data.error || 'Unknown error');

      const r          = data.result;
      const percentile = data.percentile ?? 0;
      const total      = data.total ?? 0;
      const tier       = tierFor(r.scores.overall);

      const dateStr = new Date(r.createdAt * 1000).toLocaleString('en-US', {
        month: 'short', day: 'numeric', year: 'numeric',
        hour: '2-digit', minute: '2-digit', timeZone: 'UTC',
      }) + ' UTC';

      // ── Document title with score ────────────────────────────
      document.title = `9bench ${fmt(r.scores.overall)} (${tier.label}) — your hardware in 15 seconds`;

      // ── Header strip ─────────────────────────────────────────
      setText('#result-status', '✓ TEST COMPLETE');
      setText('#result-date',   dateStr);
      // We don't store browser strings yet — placeholder until schema migration
      $('#result-browser')!.style.display = 'none';

      // ── Hero ─────────────────────────────────────────────────
      setText('#result-score', fmt(r.scores.overall));
      setText('#tier-label',   tier.label);
      setText('#tier-sub',     tier.sub);
      $('#tier-label')!.style.color = tier.color;
      setText('#result-narrative', narrativeFor(r, percentile, total));

      // ── Rank line: percentile gate at N ≥ 100 ────────────────
      if (total >= PERCENTILE_MIN_N) {
        setText('#result-rank',
          `Faster than ${percentile}% of all runs · Ranked ${ordinal(total - Math.round(total * percentile / 100))} of ${fmt(total)}.`);
      } else {
        setText('#result-rank',
          `Early days — ${fmt(total)} test${total === 1 ? '' : 's'} so far. Percentile ranking unlocks at 100+ runs.`);
      }

      // ── Component grid ───────────────────────────────────────
      setText('#comp-gpu',  fmt(r.scores.gpu));
      setText('#comp-cpu1', fmt(r.scores.cpuSingle));
      setText('#comp-cpum', fmt(r.scores.cpuMulti));
      setText('#comp-ram',  fmt(r.scores.ram));
      setText('#comp-gpu-sub',  `${r.gpu.gflops.toFixed(0)} GFLOPS`);
      setText('#comp-ram-sub',  `${r.ram.readGBs.toFixed(1)} / ${r.ram.writeGBs.toFixed(1)} GB/s`);

      // ── Detected hardware rows ───────────────────────────────
      setText('#hw-gpu',     r.gpu.name || 'Browser hides this — re-test to add manually');
      setText('#hw-cpu',     `${r.cpu.cores} cores`);
      setText('#hw-ram',     `${r.ram.readGBs.toFixed(1)} GB/s read · ${r.ram.writeGBs.toFixed(1)} GB/s write · ${r.ram.latencyNs.toFixed(1)} ns latency`);
      setText('#hw-browser', 'Browser info per-test (not stored)');

      // ── Raw measurements ─────────────────────────────────────
      setText('#raw-gflops',     `${r.gpu.gflops.toFixed(1)} GFLOPS`);
      setText('#raw-cores',      String(r.cpu.cores));
      setText('#raw-sha-single', `${fmt(Math.round(r.cpu.hashesSingle))} h/s`);
      setText('#raw-sha-multi',  `${fmt(Math.round(r.cpu.hashesMulti))} h/s`);
      setText('#raw-ram-read',   `${r.ram.readGBs.toFixed(1)} GB/s`);
      setText('#raw-ram-write',  `${r.ram.writeGBs.toFixed(1)} GB/s`);
      setText('#raw-ram-latency',`${r.ram.latencyNs.toFixed(1)} ns`);

      // ── Trading card ─────────────────────────────────────────
      setText('#card-id',     `-${r.id.slice(0, 6)}-`);
      setText('#card-score',  fmt(r.scores.overall));
      setText('#card-tier',   tier.key === 'S' || tier.key === 'A' ? tier.key : '');
      setText('#card-hw',     [
        r.gpu.name || 'GPU details hidden',
        `${r.cpu.cores}-core CPU`,
      ].join(' · '));
      setText('#card-gpu',    fmt(r.scores.gpu));
      setText('#card-cpu1',   fmt(r.scores.cpuSingle));
      setText('#card-cpum',   fmt(r.scores.cpuMulti));
      setText('#card-ram',    fmt(r.scores.ram));
      const cardPctText = total >= PERCENTILE_MIN_N
        ? `Faster than ${percentile}% globally`
        : `Early days · ${fmt(total)} test${total === 1 ? '' : 's'} so far`;
      setText('#card-pct', cardPctText);
      setText('#card-url', `9bench.com/r/${r.id}`);

      // ── Share actions URLs ───────────────────────────────────
      const url = `https://9bench.com/r/${r.id}`;
      setText('#share-url-display', url.replace(/^https?:\/\//, ''));
      setText('#permalink-url',     url);
      ($('#share-beat')! as HTMLAnchorElement).href = url;

      // ── Component imbalance callout (Phase G.4) ──────────────
      // Identify the weakest non-RAM component (RAM is excluded because
      // it's structurally low in browsers — the disclaimer covers that).
      // If GPU or CPU is significantly behind the others, point it out.
      renderImbalanceCallout(r);

      // ── AI Capabilities section (Phase G.3) ──────────────────
      renderAISection(r);

      // ── Show result, hide loading ────────────────────────────
      loadingEl.hidden = true;
      resultEl.hidden = false;

      // ── Wire share buttons ───────────────────────────────────
      wireShareButtons(r, percentile, total, tier, url);

      // ── Load reference hardware comparison (async, non-blocking) ──
      loadReferenceComparison(r.scores.overall);
    } catch (e: any) {
      console.error('Failed to load result', e);
      loadingEl.hidden = true;
      errorEl.hidden = false;
      $('#error-message')!.textContent = e?.message || 'Could not load this result.';
    }
  }

  /**
   * Wire all the share-action buttons. Each is independent so a failure
   * in one (e.g. clipboard blocked) doesn't break the others.
   */
  function wireShareButtons(r: any, percentile: number, total: number, tier: any, url: string) {
    const shareTextStr = shareText(r.scores.overall, total >= PERCENTILE_MIN_N ? percentile : undefined);

    // Copy link
    $('#share-link')?.addEventListener('click', async (e) => {
      const btn = e.currentTarget as HTMLButtonElement;
      try {
        await navigator.clipboard.writeText(url);
        const original = btn.textContent;
        btn.classList.add('is-success');
        btn.textContent = '✓ COPIED';
        setTimeout(() => { btn.classList.remove('is-success'); btn.textContent = original; }, 1500);
      } catch {
        // Fallback: open prompt() for user to copy manually
        prompt('Copy this URL:', url);
      }
    });

    // X / Twitter share
    $('#share-twitter')?.addEventListener('click', () => {
      const text = `${shareTextStr} ${url}`;
      const u = `https://twitter.com/intent/tweet?text=${encodeURIComponent(text)}`;
      window.open(u, '_blank', 'noopener,width=560,height=600');
    });

    // Reddit share — opens compose with title pre-filled
    $('#share-reddit')?.addEventListener('click', () => {
      const title = `${shareTextStr.replace(/\.$/, '')} — built it in the browser`;
      const u = `https://www.reddit.com/submit?url=${encodeURIComponent(url)}&title=${encodeURIComponent(title)}`;
      window.open(u, '_blank', 'noopener');
    });

    // PNG export — captures the .trading-card DOM directly
    $('#share-png')?.addEventListener('click', async (e) => {
      const btn = e.currentTarget as HTMLButtonElement;
      const card = $('#trading-card');
      if (!card) return;
      const original = btn.textContent;
      btn.disabled = true;
      btn.textContent = '⏳ RENDERING…';
      try {
        // 3x pixelRatio for crisp 1080×1350 export — Twitter/Reddit display
        // images at 1080px wide; 3x of our 360px card width = 1080px exact.
        const dataUrl = await toPng(card, {
          pixelRatio: 3,
          backgroundColor: '#0A0A0A',
          cacheBust: true,
        });
        const a = document.createElement('a');
        a.download = `9bench-${r.id}.png`;
        a.href = dataUrl;
        a.click();
        btn.classList.add('is-success');
        btn.textContent = '✓ DOWNLOADED';
        setTimeout(() => { btn.classList.remove('is-success'); btn.textContent = original; btn.disabled = false; }, 1500);
      } catch (err) {
        console.error('PNG export failed', err);
        btn.textContent = '✗ FAILED — try copy link instead';
        btn.disabled = false;
        setTimeout(() => { btn.textContent = original; }, 2500);
      }
    });

    // JSON export — full result for verification
    $('#share-json')?.addEventListener('click', () => {
      const blob = new Blob([JSON.stringify({
        url,
        result: r,
        percentile,
        total,
        exportedAt: new Date().toISOString(),
      }, null, 2)], { type: 'application/json' });
      const a = document.createElement('a');
      a.download = `9bench-${r.id}.json`;
      a.href = URL.createObjectURL(blob);
      a.click();
      URL.revokeObjectURL(a.href);
    });
  }

  /**
   * Render component imbalance callout when one of GPU/CPU lags
   * significantly behind the others. RAM is excluded (browser-cap).
   */
  function renderImbalanceCallout(r: any) {
    const components: Array<[string, number]> = [
      ['GPU',         r.scores.gpu],
      ['CPU·1 (single-core)', r.scores.cpuSingle],
      ['CPU·M (multi-core)',  r.scores.cpuMulti],
    ];
    // Find min and max non-RAM scores
    const max = Math.max(...components.map(c => c[1]));
    const min = Math.min(...components.map(c => c[1]));
    const ratio = min / Math.max(max, 1);

    // Only flag if min is < 50% of max (meaningful imbalance)
    if (ratio >= 0.5) {
      // Also check RAM is not under 30% of CPU·M (browser cap is well-known
      // but extreme RAM gaps still useful to mention)
      const ramRatio = r.scores.ram / Math.max(r.scores.cpuMulti, 1);
      if (ramRatio < 0.20) {
        const callout = $('#imbalance-callout');
        if (callout) {
          callout.classList.remove('imbalance-callout--warn');
          $('#imbalance-title')!.textContent = 'Memory bandwidth is your floor';
          $('#imbalance-detail')!.textContent =
            `RAM scored ${(r.scores.cpuMulti / Math.max(r.scores.ram, 1)).toFixed(1)}× lower than CPU multi-core. ` +
            `Partly browser-sandbox cap (typical 30-50% of native), but if native benchmarks show similar gap, RAM upgrade gives you the biggest practical speedup.`;
          callout.removeAttribute('hidden');
        }
      }
      return;
    }

    const weakest = components.find(c => c[1] === min)!;
    const callout = $('#imbalance-callout');
    if (!callout) return;

    callout.classList.add('imbalance-callout--warn');
    $('#imbalance-title')!.textContent = `Bottleneck identified: ${weakest[0]}`;
    $('#imbalance-detail')!.textContent =
      `${weakest[0]} scored ${(max / Math.max(min, 1)).toFixed(1)}× lower than your strongest component. ` +
      `Likely your most actionable upgrade target — would unlock more performance from the rest of your machine.`;
    callout.removeAttribute('hidden');
  }

  /**
   * Render the AI Capabilities section. Two paths:
   *   - r.ai != null  → Phase-G result, full AI section with predictions
   *   - r.ai == null  → Pre-Phase-G result, legacy notice + re-test prompt
   */
  function renderAISection(r: any) {
    const ai = r.ai;
    if (!ai) {
      // Legacy result, no AI block — show "test again" prompt
      $('#ai-section-legacy')!.removeAttribute('hidden');
      return;
    }

    const tier = aiTierLabel(ai.tier);

    // Tier letter + sub
    $('#ai-tier-letter')!.textContent = tier.letter;
    $('#ai-tier-letter')!.setAttribute('style', `color: ${tier.color};`);
    $('#ai-tier-sub')!.textContent = tier.sub;
    $('#ai-tier-sub')!.setAttribute('style', `color: ${tier.color};`);
    $('#ai-score')!.textContent = ai.score.toLocaleString();

    // Feature inventory
    const fp16 = !!ai.webgpu?.fp16;
    const maxAlloc = ai.memory?.largestAllocatableGB ?? 0;
    const webgpuOk = ai.webgpu !== null && ai.webgpu !== undefined;

    setFeature('fp16', fp16, fp16 ? 'shader-f16' : 'not exposed', fp16
      ? 'Modern LLMs use FP16/BF16. Your adapter supports it.'
      : 'FP16 unsupported — LLM/SDXL run in FP32 (slower, more memory).');

    const memColor = maxAlloc >= 4 ? 'ok' : maxAlloc >= 1 ? 'warn' : 'limit';
    setFeature('buffer', memColor === 'ok', `${maxAlloc.toFixed(1)} GB max allocation`,
      maxAlloc >= 4 ? 'Enough headroom for 7B-13B quantized models.' :
      maxAlloc >= 2 ? 'Tight — fits 7B Q4 but with little overhead.' :
      'Below practical floor for local LLMs.');

    setFeature('webgpu', webgpuOk, webgpuOk ? 'WebGPU compute available' : 'no WebGPU',
      webgpuOk ? 'Required for GPU-accelerated AI inference.' :
      'CPU-only fallback — much slower for ML workloads.');

    // Predictions — regenerated client-side from stored fields
    const predictions = generatePredictionsClient(
      r.gpu.gflops || 0,
      r.ram.readGBs || 0,
      maxAlloc,
      fp16
    );

    const predHtml = predictions.map((p) => {
      const verdictIcon = p.verdict === 'yes' ? '✓' : p.verdict === 'maybe' ? '~' : '✗';
      const perfHtml = p.performance ? `<span class="ai-pred__perf">${p.performance}</span>` : '';
      return `
        <article class="ai-pred ai-pred--${p.verdict}">
          <span class="ai-pred__verdict">${verdictIcon}</span>
          <div class="ai-pred__body">
            <span class="ai-pred__name">${p.name}</span>
            ${perfHtml}
            <p class="ai-pred__reason">${p.reasoning}</p>
          </div>
        </article>
      `;
    }).join('');
    $('#ai-predictions')!.innerHTML = predHtml;

    $('#ai-section')!.removeAttribute('hidden');
  }

  function setFeature(id: string, ok: boolean, value: string, sub: string) {
    const el = $(`#ai-feat-${id}`);
    if (!el) return;
    el.classList.remove('ai-feat--ok', 'ai-feat--warn', 'ai-feat--limit');
    el.classList.add(ok ? 'ai-feat--ok' : 'ai-feat--warn');
    const icon = el.querySelector<HTMLElement>('.ai-feat__icon');
    if (icon) icon.textContent = ok ? '✓' : '⚠';
    const subEl = $(`#ai-feat-${id}-sub`);
    if (subEl) subEl.textContent = sub;
    // Append the value to the strong label
    const strong = el.querySelector<HTMLElement>('strong');
    if (strong && !strong.dataset.augmented) {
      strong.textContent = `${strong.textContent} · ${value}`;
      strong.dataset.augmented = 'true';
    }
  }

  /**
   * Load reference hardware comparison bars from /api/reference-hardware.
   * Empty response → keep Phase 2 placeholder visible.
   * Real data → replace placeholder with bar chart.
   */
  async function loadReferenceComparison(userScore: number) {
    try {
      const res = await fetch(`/api/reference-hardware?limit=6&around=${userScore}`);
      if (!res.ok) return;  // graceful — keep placeholder
      const data = await res.json() as any;
      const items = data.items || [];
      if (items.length < 3) return;  // Less than 3 references = not useful — keep placeholder

      const container = $('#cmp-bars');
      if (!container) return;

      // Determine the bar scale: we render relative to the user's score.
      // Bars go left (negative delta) or right (positive delta) from a
      // center line, max ±60% gives readable scale for typical hardware.
      const MAX_DELTA = 60;

      const html = items.map((item: any) => {
        const pct = ((item.score - userScore) / userScore) * 100;
        const sign = pct > 0 ? '+' : pct < 0 ? '-' : '';
        const absPct = Math.min(Math.abs(pct), MAX_DELTA);
        const halfWidth = (absPct / MAX_DELTA) * 50;  // 0-50% of half-track
        const isFasterThanUser = pct > 0;
        const fillStyle = isFasterThanUser
          ? `left: 50%; width: ${halfWidth}%;`
          : `right: 50%; width: ${halfWidth}%;`;
        const fillClass = isFasterThanUser ? '' : 'cmp-bar__fill--neg';
        const deltaClass = isFasterThanUser ? '' : 'cmp-bar__delta--neg';
        const deltaText = sign === '' ? '·' : `${sign}${absPct.toFixed(0)}%`;
        return `
          <div class="cmp-bar">
            <span class="cmp-bar__label" title="${item.notes || ''}">${item.name}</span>
            <div class="cmp-bar__track">
              <div class="cmp-bar__fill ${fillClass}" style="${fillStyle}"></div>
            </div>
            <span class="cmp-bar__delta ${deltaClass}">${deltaText}</span>
          </div>
        `;
      }).join('');

      container.innerHTML = `
        <p style="font-family: var(--mono); font-size: 11px; color: var(--fg-3); margin: 0 0 12px 0;">
          Negative = your machine is faster · Positive = reference is faster
        </p>
        ${html}
      `;
    } catch (e) {
      // Silent fallback — placeholder stays visible
      console.warn('reference-hardware fetch failed', e);
    }
  }

  load();
</script>
