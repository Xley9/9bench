    } else if (midGflops >= 1500 && usableRamGB >= 12) {
      out.push({
        name: 'HunyuanVideo (5s 720p, Q4)',
        description: '13B Tencent video model — 2026\'s quality leader',
        verdict: 'maybe',
        performance: '~5-15 min per 5s 720p clip',
        reasoning: `Estimated native ~${Math.round(midGflops)} GFLOPS + ${usableRamGB} GB RAM. Will work but expect long generation times.`,
        category: 'video',
      });
    } else {
      out.push({
        name: 'HunyuanVideo (5s 720p, Q4)',
        description: '13B Tencent video model — 2026\'s quality leader',
        verdict: 'no', performance: null,
        reasoning: `Needs ≥12 GB VRAM and substantial compute. Try LTX-Video (lighter) or use cloud.`,
        category: 'video',
      });
    }

    // ── LTX-Video (5s) ──
    // Lightricks 2B video model — speed champion, runs on 8 GB.
    // ~7× SDXL time (4090: SDXL 4s → LTX 28s).
    if (cls?.sdxlSecondsLow != null && cls?.sdxlSecondsHigh != null && fluxFloorVRAM >= 8) {
      const sLow  = Math.max(10, Math.round(cls.sdxlSecondsLow  * 7));
      const sHigh = Math.max(20, Math.round(cls.sdxlSecondsHigh * 7));
      out.push({
        name: 'LTX-Video (5s)',
