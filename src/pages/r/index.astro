---
/**
 * /r/[id] — Hybrid Result + Share page.
 *
 * Layout: V2 Editorial (big score, narrative) + V1 viral assets
 * (HardwareComparisonBars, action stack with PNG export).
 *
 * Architecture: client-side fetch /api/r/[id] (Astro doesn't pre-render
 * dynamic D1 routes on Cloudflare Pages). Static HTML shell renders
 * skeleton; JS populates real data after fetch.
 *
 * PNG export: html-to-image captures the .trading-card DOM element
 * directly (no React island needed — simpler, smaller bundle).
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import TruthDisclaimer from '../../components/bench/TruthDisclaimer.astro';
import { tierFor, PERCENTILE_MIN_N } from '../../components/bench/tier-system';
---

<BaseLayout
  title="Score — 9bench"
  description="Browser-based hardware benchmark result. Test yours at 9bench.com — no download, no account, no bias."
>
  <main class="container result-page">

    <!-- ── Loading state (replaced after fetch) ─────────────────── -->
    <div id="loading" class="loading-state">
      <div class="loading-state__pulse" aria-hidden="true"></div>
      <p class="loading-state__text">Loading result…</p>
    </div>

    <!-- ── Error state (shown if fetch fails) ───────────────────── -->
    <div id="error" class="error-state" hidden>
      <h2 class="section-h" style="font-size: 32px;">Result not found</h2>
      <p class="text-fg-2 font-mono" style="font-size: 13px; margin: 16px 0 24px;" id="error-message">—</p>
      <a href="/" class="btn-outline">← Test your hardware</a>
    </div>

    <!-- ── Result content (populated client-side) ───────────────── -->
    <article id="result" class="result" hidden>

      <!-- Header strip -->
      <header class="result__header">
        <div class="result__header-left">
          <span class="pill pill--accent" id="result-status">✓ TEST COMPLETE</span>
          <span class="pill" id="result-browser">—</span>
        </div>
        <div class="result__header-right">
          <span class="text-fg-3 font-mono" style="font-size: 11px; letter-spacing: 0.08em;">
            9BENCH SCORE · <span id="result-date">—</span>
          </span>
        </div>
      </header>

      <!-- Hero: score + narrative -->
      <section class="result__hero">
        <div class="result__hero-score">
          <div class="result__big tnum" id="result-score">—</div>
          <div class="result__tier" id="result-tier">
            <span class="result__tier-label" id="tier-label">—</span>
            <span class="result__tier-sub"   id="tier-sub">—</span>
          </div>
        </div>
        <div class="result__hero-narrative">
          <p class="result__narrative" id="result-narrative">—</p>
          <p class="result__rank font-mono" id="result-rank">—</p>
        </div>
      </section>

      <!-- ── Component imbalance callout (Phase G.4) ─────────────── -->
      <!-- Visible only when an imbalance is detected (RAM browser-cap excluded).
           Tells the user which component is bottlenecking — actionable
           upgrade guidance UserBenchmark/Geekbench don't provide. -->
      <aside id="imbalance-callout" class="imbalance-callout" hidden>
        <span class="imbalance-callout__icon" aria-hidden="true">⚡</span>
        <div class="imbalance-callout__body">
          <strong id="imbalance-title">—</strong>
          <p id="imbalance-detail">—</p>
        </div>
      </aside>

      <!-- Component breakdown (4-card grid) -->
      <section class="component-grid">
        <article class="component-card">
          <span class="component-card__label">— GPU</span>
          <div class="component-card__value tnum" id="comp-gpu">—</div>
          <div class="component-card__sub" id="comp-gpu-sub">—</div>
        </article>
        <article class="component-card">
          <span class="component-card__label">— CPU·1</span>
          <div class="component-card__value tnum" id="comp-cpu1">—</div>
          <div class="component-card__sub" id="comp-cpu1-sub">single-core</div>
        </article>
        <article class="component-card">
          <span class="component-card__label">— CPU·M</span>
          <div class="component-card__value tnum" id="comp-cpum">—</div>
          <div class="component-card__sub" id="comp-cpum-sub">multi-core</div>
        </article>
        <article class="component-card">
          <span class="component-card__label">— RAM</span>
          <div class="component-card__value tnum" id="comp-ram">—</div>
          <div class="component-card__sub" id="comp-ram-sub">—</div>
        </article>
      </section>

      <!-- ── AI Capabilities Section (Phase G + H — differentiator) ──
           This is the section UserBenchmark / Geekbench / Cinebench do not
           have. 2026 hardware purchase is increasingly driven by "can it
           run Llama 13B?" — 9bench answers concretely, with reasoning.

           Phase H upgrade: split predictions into Browser (transformers.js,
           web-llm) and Native (llama.cpp, ComfyUI). Browser is what we
           directly measured; Native is extrapolated from the same hardware
           with sandbox limits removed. Each prediction is shown side-by-side
           so users see both the "what runs in this tab" answer AND the
           "what your hardware can really do" answer. -->
      <section class="ai-section" id="ai-section" hidden>
        <header class="ai-section__head">
          <div class="eyebrow eyebrow--accent">// LOCAL AI · WHAT YOUR PC CAN RUN</div>

          <!-- Two score blocks: Browser (measured) vs Native (estimated).
               Both shown side-by-side so users can compare at a glance.
               Browser has the live measurement authority, Native has the
               "what your hardware really should do" guidance. -->
          <div class="ai-scoreblocks">
            <article class="ai-scoreblock ai-scoreblock--browser">
              <div class="ai-scoreblock__head">
                <span class="ai-scoreblock__label">Browser</span>
                <span class="ai-scoreblock__sublabel">measured · this tab</span>
              </div>
              <div class="ai-scoreblock__score tnum" id="ai-browser-score">—</div>
              <div class="ai-scoreblock__tier" id="ai-browser-tier">—</div>
              <p class="ai-scoreblock__sub" id="ai-browser-sub">—</p>
            </article>

            <article class="ai-scoreblock ai-scoreblock--native">
              <div class="ai-scoreblock__head">
                <span class="ai-scoreblock__label">Native</span>
                <span class="ai-scoreblock__sublabel">estimated · llama.cpp / ComfyUI</span>
              </div>
              <div class="ai-scoreblock__score tnum" id="ai-native-score">—</div>
              <div class="ai-scoreblock__tier" id="ai-native-tier">—</div>
              <p class="ai-scoreblock__sub" id="ai-native-sub">—</p>
            </article>
          </div>
        </header>

        <!-- WebGPU feature inventory — proof the score is grounded -->
        <div class="ai-section__features">
          <div class="ai-feat" id="ai-feat-fp16">
            <span class="ai-feat__icon" aria-hidden="true">—</span>
            <div class="ai-feat__body">
              <strong>FP16 support</strong>
              <span class="ai-feat__value" id="ai-feat-fp16-value">—</span>
              <span class="ai-feat__sub" id="ai-feat-fp16-sub">—</span>
            </div>
          </div>
          <div class="ai-feat" id="ai-feat-buffer">
            <span class="ai-feat__icon" aria-hidden="true">—</span>
            <div class="ai-feat__body">
              <strong>Memory headroom</strong>
              <span class="ai-feat__value" id="ai-feat-buffer-value">—</span>
              <span class="ai-feat__sub" id="ai-feat-buffer-sub">—</span>
            </div>
          </div>
          <div class="ai-feat" id="ai-feat-webgpu">
            <span class="ai-feat__icon" aria-hidden="true">—</span>
            <div class="ai-feat__body">
              <strong>WebGPU compute</strong>
              <span class="ai-feat__value" id="ai-feat-webgpu-value">—</span>
              <span class="ai-feat__sub" id="ai-feat-webgpu-sub">—</span>
            </div>
          </div>
        </div>

        <!-- Predictions — TWO-COLUMN table: Browser | Native side-by-side.
             Each row is one workload (Llama 7B, SDXL, etc) with both
             contexts shown. Mobile collapses to stacked rows. -->
        <div class="ai-pred-table">
          <header class="ai-pred-table__head">
            <div class="ai-pred-table__h-name">Workload</div>
            <div class="ai-pred-table__h-col">
              <span class="ai-pred-table__h-title">Browser</span>
              <span class="ai-pred-table__h-sub">in this tab today</span>
            </div>
            <div class="ai-pred-table__h-col">
              <span class="ai-pred-table__h-title">Native</span>
              <span class="ai-pred-table__h-sub">your hardware, no sandbox</span>
            </div>
          </header>
          <div class="ai-pred-table__body" id="ai-pred-rows">
            <!-- populated by JS as .ai-pred-row elements -->
          </div>
        </div>

        <!-- Methodology footnote with the 2-context explanation -->
        <p class="ai-section__note">
          <strong>How these predictions work:</strong>
          <span class="text-accent">Browser</span> values reflect what your
          browser can actually run today (transformers.js, web-llm) — sandbox
          memory limits + ANGLE/Direct3D translation overhead included.
          <span class="text-accent">Native</span> values extrapolate to what
          the same hardware achieves outside the browser (llama.cpp, ComfyUI),
          assuming typical RAM headroom and direct GPU access. Real native
          performance varies by ±30% — these are calibration targets, not
          guarantees. <a href="/methodology#ai">Read the AI methodology →</a>
        </p>
      </section>

      <!-- Pre-Phase-G fallback: result was captured before AI probe existed -->
      <section class="ai-section ai-section--legacy" id="ai-section-legacy" hidden>
        <header class="ai-section__head">
          <div class="eyebrow eyebrow--accent">// LOCAL AI</div>
          <h2 class="ai-section__legacy-h2">AI capability not measured for this run</h2>
          <p class="ai-section__legacy-p">
            This result was captured before 9bench added local-AI capability
            scoring. <a href="/test/" class="text-accent">Run a fresh test</a>
            to see what your machine can run locally — Llama, SDXL, Whisper.
          </p>
        </header>
      </section>

      <!-- Two-column: detected hardware + trading card -->
      <section class="result__main">
        <div class="result__col-left">

          <h3 class="result__section-h">— Detected hardware</h3>
          <div class="hw-rows">
            <div class="hw-row">
              <span class="hw-row__label">GPU</span>
              <span class="hw-row__value" id="hw-gpu">—</span>
            </div>
            <div class="hw-row">
              <span class="hw-row__label">CPU</span>
              <span class="hw-row__value" id="hw-cpu">—</span>
            </div>
            <div class="hw-row">
              <span class="hw-row__label">RAM</span>
              <span class="hw-row__value" id="hw-ram">—</span>
            </div>
            <div class="hw-row">
              <span class="hw-row__label">Browser</span>
              <span class="hw-row__value" id="hw-browser">—</span>
            </div>
          </div>

          <!-- VS. KNOWN HARDWARE (V1 viral asset) -->
          <h3 class="result__section-h">— vs. known hardware</h3>
          <div id="cmp-bars" class="cmp-bars">
            <!-- Phase 2 placeholder: shown until reference_hardware D1 table is seeded -->
            <p class="cmp-bars__placeholder font-mono">
              <span class="text-warn">Phase 2:</span>
              comparison data unlocks once reference hardware is seeded.
              <a href="/methodology" class="text-accent">How this works →</a>
            </p>
          </div>

          <!-- Raw measurements (collapsible) -->
          <details class="raw-measurements">
            <summary class="raw-measurements__summary">
              — Raw measurements
              <span class="raw-measurements__hint">click to expand</span>
            </summary>
            <div class="raw-measurements__body">
              <div class="result-row">
                <span class="result-row-label">GPU compute</span>
                <span class="result-row-value tnum" id="raw-gflops">—</span>
              </div>
              <div class="result-row">
                <span class="result-row-label">CPU cores</span>
                <span class="result-row-value tnum" id="raw-cores">—</span>
              </div>
              <div class="result-row">
                <span class="result-row-label">SHA-256 single</span>
                <span class="result-row-value tnum" id="raw-sha-single">—</span>
              </div>
              <div class="result-row">
                <span class="result-row-label">SHA-256 multi</span>
                <span class="result-row-value tnum" id="raw-sha-multi">—</span>
              </div>
              <div class="result-row">
                <span class="result-row-label">RAM read</span>
                <span class="result-row-value tnum" id="raw-ram-read">—</span>
              </div>
              <div class="result-row">
                <span class="result-row-label">RAM write</span>
                <span class="result-row-value tnum" id="raw-ram-write">—</span>
              </div>
              <div class="result-row">
                <span class="result-row-label">RAM random latency</span>
                <span class="result-row-value tnum" id="raw-ram-latency">—</span>
              </div>
            </div>
          </details>
        </div>

        <!-- Right column: Trading Card + Share Actions -->
        <aside class="result__col-right">

          <!-- TRADING CARD — captured by html-to-image for PNG export -->
          <div class="trading-card-wrap">
            <div class="trading-card" id="trading-card">
              <div class="trading-card__head">
                <span>9BENCH · TRUTH SERIES</span>
                <span id="card-id">—</span>
              </div>
              <div>
                <span class="trading-card__score tnum" id="card-score">—</span>
                <span class="trading-card__tier" id="card-tier">—</span>
              </div>
              <div class="trading-card__hw" id="card-hw">—</div>
              <div class="trading-card__components">
                <div class="trading-card__comp">
                  <span class="trading-card__comp-label">— GPU</span>
                  <span class="trading-card__comp-value tnum" id="card-gpu">—</span>
                </div>
                <div class="trading-card__comp">
                  <span class="trading-card__comp-label">— CPU·1</span>
                  <span class="trading-card__comp-value tnum" id="card-cpu1">—</span>
                </div>
                <div class="trading-card__comp">
                  <span class="trading-card__comp-label">— CPU·M</span>
                  <span class="trading-card__comp-value tnum" id="card-cpum">—</span>
                </div>
                <div class="trading-card__comp">
                  <span class="trading-card__comp-label">— RAM</span>
                  <span class="trading-card__comp-value tnum" id="card-ram">—</span>
                </div>
              </div>
              <div class="trading-card__pct" id="card-pct">—</div>
              <div class="trading-card__url" id="card-url">9bench.com/r/—</div>
            </div>
          </div>

          <!-- Share Actions Stack -->
          <div class="share-actions">
            <a href="#" class="share-actions__primary" id="share-beat">
              BEAT MY SCORE →
              <span class="share-actions__url" id="share-url-display">9bench.com/r/—</span>
            </a>
            <button type="button" class="share-actions__btn" id="share-png">↓ DOWNLOAD CARD AS PNG · 1080×1350</button>
            <button type="button" class="share-actions__btn" id="share-link">🔗 COPY LINK</button>
            <button type="button" class="share-actions__btn" id="share-twitter">𝕏 / TWITTER</button>
            <button type="button" class="share-actions__btn" id="share-reddit">🟧 POST TO REDDIT</button>
            <button type="button" class="share-actions__btn" id="share-json">{ } EXPORT RAW JSON</button>
          </div>

          <!-- Permalink reminder -->
          <div class="permalink-reminder">
            <span class="permalink-reminder__label">// PERMALINK</span>
            <span class="permalink-reminder__url" id="permalink-url">9bench.com/r/—</span>
            <span class="permalink-reminder__sub">
              Anonymous. No fingerprint stored. Open across devices, share with anyone.
            </span>
          </div>
        </aside>
      </section>

      <!-- Truth Disclaimer (always shown) -->
      <section style="padding: 32px 0;">
        <TruthDisclaimer />
      </section>

      <!-- CTA back to test -->
      <section class="result__cta">
        <a href="/test/" class="run-btn">▶ TEST AGAIN</a>
        <a href="/methodology" class="btn-outline">Read the methodology</a>
      </section>
    </article>
  </main>
</BaseLayout>

<style>
  .result-page {
    padding: 24px 0 56px;
  }

  /* Loading + error states */
  .loading-state, .error-state {
    text-align: center;
    padding: 96px 0;
  }
  .loading-state__pulse {
    width: 14px; height: 14px;
    background: var(--accent);
    margin: 0 auto 18px;
    animation: pulse 1.2s ease-in-out infinite;
  }
  .loading-state__text {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-3);
  }

  /* Header strip */
  .result__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    padding: 12px 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    margin-bottom: 56px;
  }
  .result__header-left { display: flex; gap: 8px; flex-wrap: wrap; }

  /* Hero */
  .result__hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    margin-bottom: 56px;
    align-items: end;
  }
  @media (min-width: 1024px) {
    .result__hero { grid-template-columns: 1.4fr 1fr; gap: 56px; }
  }
  .result__hero-score {
    display: flex;
    align-items: end;
    gap: 24px;
    flex-wrap: wrap;
  }
  .result__big {
    font-family: var(--sans);
    font-weight: 800;
    font-size: clamp(80px, 14vw, 200px);
    line-height: 0.85;
    letter-spacing: -0.04em;
    color: var(--fg);
  }
  .result__tier {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-bottom: 16px;
  }
  .result__tier-label {
    font-family: var(--mono);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .result__tier-sub {
    font-family: var(--sans);
    font-size: 14px;
    color: var(--fg-2);
  }

  .result__hero-narrative {
    padding-bottom: 16px;
  }
  .result__narrative {
    font-family: var(--sans);
    font-size: 17px;
    line-height: 1.55;
    color: var(--fg-2);
    margin: 0 0 16px 0;
    max-width: 480px;
  }
  .result__rank {
    font-size: 12px;
    color: var(--fg-3);
    letter-spacing: 0.04em;
  }

  /* Component grid (4 cards) */
  .component-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    margin-bottom: 56px;
  }
  @media (min-width: 768px) {
    .component-grid { grid-template-columns: repeat(4, 1fr); }
  }
  .component-card {
    background: var(--bg-2);
    padding: 24px 22px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .component-card__label {
    font-family: var(--mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .component-card__value {
    font-family: var(--sans);
    font-weight: 800;
    font-size: clamp(36px, 4vw, 56px);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--fg);
  }
  .component-card__sub {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--fg-3);
    margin-top: auto;
    letter-spacing: 0.03em;
  }

  /* Main two-column area */
  .result__main {
    display: grid;
    grid-template-columns: 1fr;
    gap: 48px;
  }
  @media (min-width: 1024px) {
    .result__main { grid-template-columns: 1.4fr 1fr; gap: 48px; }
  }
  .result__section-h {
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fg-3);
    margin: 0 0 16px 0;
  }
  .result__section-h:not(:first-child) { margin-top: 40px; }

  /* Hardware rows */
  .hw-rows {
    border-top: 1px solid var(--line-2);
  }
  .hw-row {
    display: flex;
    justify-content: space-between;
    gap: 14px;
    padding: 12px 0;
    border-bottom: 1px solid var(--line-2);
    font-family: var(--mono);
    font-size: 13px;
  }
  .hw-row__label {
    color: var(--fg-3);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    flex: 0 0 90px;
  }
  .hw-row__value {
    color: var(--fg);
    text-align: right;
    flex: 1;
    word-break: break-word;
  }

  /* Comparison bars (Phase 2 placeholder for now) */
  .cmp-bars__placeholder {
    padding: 14px 16px;
    border: 1px dashed var(--line);
    background: var(--bg-2);
    font-size: 12px;
    line-height: 1.6;
    color: var(--fg-2);
  }

  /* Raw measurements (collapsible) */
  .raw-measurements {
    margin-top: 32px;
    border-top: 1px solid var(--line);
    padding-top: 16px;
  }
  .raw-measurements__summary {
    cursor: pointer;
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fg-3);
    list-style: none;
    display: flex;
    justify-content: space-between;
    padding: 8px 0;
  }
  .raw-measurements__summary::-webkit-details-marker { display: none; }
  .raw-measurements__hint {
    color: var(--fg-4);
    font-weight: 400;
    text-transform: none;
    letter-spacing: 0.04em;
  }
  .raw-measurements[open] .raw-measurements__hint { content: 'click to collapse'; }
  .raw-measurements__body {
    margin-top: 8px;
    border-top: 1px solid var(--line-2);
  }

  /* Right column: trading card + share actions */
  .result__col-right {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .trading-card-wrap {
    overflow-x: auto;
  }

  /* Share actions stack */
  .share-actions {
    display: flex;
    flex-direction: column;
    gap: 0;
    border: 1px solid var(--line);
  }
  .share-actions__primary {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
    padding: 14px 18px;
    background: var(--accent);
    color: #000;
    font-family: var(--mono);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    border-bottom: 1px solid #000;
  }
  .share-actions__primary:hover { background: var(--fg); }
  .share-actions__url {
    font-family: var(--mono);
    font-size: 10px;
    font-weight: 400;
    text-transform: lowercase;
    letter-spacing: 0;
    color: rgba(0, 0, 0, 0.55);
  }
  .share-actions__btn {
    background: transparent;
    color: var(--fg-2);
    border: 0;
    border-bottom: 1px solid var(--line);
    padding: 12px 18px;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    text-align: left;
