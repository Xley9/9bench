<script>
  // ─────────────────────────────────────────────────────────────────
  //  RESULT PAGE — fetch + render + share actions
  // ─────────────────────────────────────────────────────────────────

  import { tierFor, PERCENTILE_MIN_N, shareText } from '../../components/bench/tier-system';
  import { lookupGPUClass, refinedNativeContext, type GPUClass } from '../../bench/gpu-class-lookup';
  import { toPng } from 'html-to-image';
  import { runLLMLiveTest, formatTPS, type LLMTestProgress, type LLMTestResult } from '../../bench/llm-live-test';

  // AI tier label + color helper. Inlined here (rather than importing
  // the full ai-capabilities module) because Astro tree-shakes the
  // server-side `probeAICapabilities` away — we only need the visual
  // labels for previously-stored ai_tier strings.
  function aiTierLabel(tier: string): { letter: string; sub: string; color: string } {
    switch (tier) {
      case 'AI-S':           return { letter: 'S', sub: 'AI workstation — runs 13B LLMs and SDXL comfortably', color: 'var(--accent)' };
      case 'AI-A':           return { letter: 'A', sub: 'Strong local AI — 7-13B LLMs, SD 1.5 image generation', color: 'var(--good)' };
      case 'AI-B':           return { letter: 'B', sub: 'Capable — 7B LLMs, SD 1.5, smaller image models', color: 'var(--fg)' };
      case 'AI-Entry':
      case 'AI-Workstation': // legacy rows stored before the rename
                             return { letter: '◯', sub: 'Entry level — 7B Q4 marginal, smaller models work', color: 'var(--fg-2)' };
      case 'AI-Office':      return { letter: '◯', sub: 'Cloud-first — local AI is impractical on this hardware', color: 'var(--fg-3)' };
      case 'AI-Limited':     return { letter: '⚠', sub: 'Cloud-only — not a local-AI machine', color: 'var(--warn)' };
      default:               return { letter: '?', sub: 'Unknown AI tier', color: 'var(--fg-3)' };
    }
  }

  /**
   * ─────────────────────────────────────────────────────────────────
   * NATIVE CONTEXT ESTIMATION (Phase H — Option C)
   * ─────────────────────────────────────────────────────────────────
   * Browsers cap what we can measure (sandbox memory ~1-2 GB,
   * ANGLE/Direct3D translation ~5-10x slower than native CUDA, RAM
   * bandwidth ~40% of native). To answer "what could my hardware
   * actually run if I used llama.cpp?", we extrapolate from the
   * measured browser values to estimated native performance.
   *
   * Assumptions documented inline. These are educated estimates,
   * NOT measurements — calibrated against publicly published benchmarks
   * (llama.cpp on RTX 4060 Laptop ≈ 30-50 t/s for 7B Q4, etc.). Real
   * native results vary by ±30% based on driver, OS, RAM speed.
   */

  interface NativeContext {
    /** Estimated native GPU compute (rough — varies 3-15× browser) */
    nativeGflopsLow: number;
    nativeGflopsHigh: number;
    /** Estimated total system RAM (heuristic from cpu cores + deviceMemory) */
    estimatedTotalRamGB: number;
    /** RAM available for AI workloads after OS/apps overhead (~60%) */
    usableRamGB: number;
    /** FP16 effectively always available natively on any GPU < 5 years old */
    fp16Likely: boolean;
  }

  function estimateNativeContext(
    browserGflops: number,
    cpuCores: number,
    browserFp16: boolean,
    gpuName: string | null  // Phase K: enables tighter calibration when we recognize the GPU
  ): NativeContext & { gpuClass: GPUClass | null; matchedDisplayName: string | null } {
    // ── Phase K: Hardware-class lookup ─────────────────────────────
    // If we recognize the GPU model from the renderer string, we use
    // calibrated benchmark data instead of the wide 3-12× browser→native
    // extrapolation. This shrinks the native estimate range from "~3909
    // GFLOPS" (huge spread) to e.g. "8000-12000 GFLOPS" (RTX 4060 Laptop
    // class) — matched against published TechPowerUp / 3DMark medians.
    const gpuClass = lookupGPUClass(gpuName);

    let nativeGflopsLow:  number;
    let nativeGflopsHigh: number;

    if (gpuClass) {
      // Calibrated path — much tighter range
      const refined = refinedNativeContext(gpuClass);
      nativeGflopsLow  = refined.nativeGflopsLow;
      nativeGflopsHigh = refined.nativeGflopsHigh;
    } else {
      // Generic fallback — wide range, browser-extrapolation only.
      // Apple Silicon shows ~50-70% of native (good WebGPU impl),
      // NVIDIA Windows via ANGLE shows ~5-10% (heavy translation overhead).
      // We give a wide range to be honest about uncertainty.
      nativeGflopsLow  = browserGflops * 3;
      nativeGflopsHigh = browserGflops * 12;
    }

    // Total system RAM heuristic. For known Apple Silicon with unified
    // memory architecture, override with class-specific typical VRAM
    // (which is system RAM). For others, fall back to CPU-core heuristic.
    let estimatedTotalRamGB: number;
    if (gpuClass && gpuClass.form === 'apple-silicon') {
      // Apple Silicon: VRAM IS system RAM (unified memory).
      // Class table 'typicalVRAM' is the typical config — use it.
      estimatedTotalRamGB = gpuClass.typicalVRAM;
    } else if (cpuCores <= 4)        estimatedTotalRamGB = 8;
    else if (cpuCores <= 8)   estimatedTotalRamGB = 16;
    else if (cpuCores <= 16)  estimatedTotalRamGB = 32;
    else if (cpuCores <= 24)  estimatedTotalRamGB = 48;
    else                      estimatedTotalRamGB = 64;

    // After OS overhead (~3-4 GB) + browser/apps (~2-4 GB) we estimate
    // 60% of total is realistically free for an AI inference process.
    const usableRamGB = Math.round(estimatedTotalRamGB * 0.6);

    // FP16 universal on any GPU shipping after 2020.
    const fp16Likely = true;

    return {
      nativeGflopsLow,
      nativeGflopsHigh,
      estimatedTotalRamGB,
      usableRamGB,
      fp16Likely,
      gpuClass,
      matchedDisplayName: gpuClass?.displayName ?? null,
    };
  }

  /**
   * Generate native AI predictions — what the SAME hardware achieves
   * with llama.cpp / ComfyUI / native Whisper, no browser sandbox.
   *
   * Calibration sources (publicly verifiable):
   *   - llama.cpp on RTX 4060 Laptop (~10 TFLOPS native, 256 GB/s VRAM):
   *     ~30-50 t/s for Llama 7B Q4
   *   - llama.cpp on Apple M2 Pro: ~25-40 t/s for Llama 7B Q4
   *   - ComfyUI SDXL on RTX 4070: ~5-10s per 1024×1024 image
   *   - Whisper.cpp on M-series: 5-10× faster than real-time
   */
  function generateNativePredictions(
    nativeCtx: NativeContext & { gpuClass?: any; matchedDisplayName?: string | null }
  ): Array<{name: string; description: string; verdict: 'yes' | 'maybe' | 'no'; performance: string | null; reasoning: string; category: string}> {
    const out: any[] = [];
    const {nativeGflopsLow: lo, nativeGflopsHigh: hi, usableRamGB} = nativeCtx;
    const midGflops = (lo + hi) / 2;
    // Phase K: when GPU is recognized, use class-calibrated benchmarks
    // instead of GFLOPS extrapolation. Tighter ranges, real-world accurate.
    const cls = (nativeCtx as any).gpuClass;

    // ── Llama 7B Q4 (~6 GB RAM minimum for KV cache + weights) ──
    if (usableRamGB >= 6) {
      let tpsLow: number, tpsHigh: number, source: string;
      if (cls?.llama7BQ4TPSLow != null && cls?.llama7BQ4TPSHigh != null) {
        // Calibrated path
        tpsLow  = cls.llama7BQ4TPSLow;
        tpsHigh = cls.llama7BQ4TPSHigh;
        source  = `Calibrated for ${cls.displayName} from public llama.cpp benchmarks.`;
      } else {
        // Generic GFLOPS-extrapolation path
        tpsLow  = Math.round(lo / 80);
        tpsHigh = Math.round(hi / 80);
        source  = `Estimated ~${Math.round(midGflops)} GFLOPS native + ${usableRamGB} GB usable RAM. llama.cpp / Ollama recommended.`;
      }
      out.push({
        // Phase K (fix): keep name plain so it pairs up with the
        // browser-side prediction row. The matched-class info already
        // shows in the native score sub-text and in the reasoning.
        name: 'Llama 7B (Q4)',
        description: '7-billion params, 4-bit quantized',
        verdict: 'yes',
        performance: `~${Math.max(5, tpsLow)}–${Math.max(15, tpsHigh)} tokens/s`,
        reasoning: source,
        category: 'llm',
      });
    } else {
      out.push({
        name: 'Llama 7B (Q4)', description: '7-billion params, 4-bit quantized',
        verdict: 'no', performance: null,
        reasoning: `Native estimated free RAM is ~${usableRamGB} GB; 7B Q4 needs at least 6 GB.`,
        category: 'llm',
      });
    }

    // ── Llama 13B Q4 (~10 GB RAM minimum) ──
    if (usableRamGB >= 10) {
      const tpsLow  = Math.round(lo / 160);
      const tpsHigh = Math.round(hi / 160);
      out.push({
        name: 'Llama 13B (Q4)', description: '13-billion params, 4-bit quantized',
        verdict: 'yes',
        performance: `~${Math.max(3, tpsLow)}–${Math.max(8, tpsHigh)} tokens/s`,
        reasoning: `Estimated ${usableRamGB} GB usable RAM accommodates the 8 GB weights + KV cache.`,
        category: 'llm',
      });
    } else {
      out.push({
        name: 'Llama 13B (Q4)', description: '13-billion params, 4-bit quantized',
        verdict: 'no', performance: null,
        reasoning: `Estimated free RAM ${usableRamGB} GB; 13B Q4 needs ~10 GB minimum.`,
        category: 'llm',
      });
    }

    // ── Llama 70B Q4 (~48 GB RAM minimum) ──
    if (usableRamGB >= 48) {
      const tpsLow  = Math.round(lo / 600);
      const tpsHigh = Math.round(hi / 600);
      out.push({
        name: 'Llama 70B (Q4)', description: 'Flagship LLM, 70-billion params',
        verdict: 'yes',
        performance: `~${Math.max(2, tpsLow)}–${Math.max(6, tpsHigh)} tokens/s`,
        reasoning: `Workstation-class ${usableRamGB} GB free RAM fits the 40 GB weights + cache.`,
        category: 'llm',
      });
    } else if (usableRamGB >= 32) {
      out.push({
        name: 'Llama 70B (Q4)', description: 'Flagship LLM, 70-billion params',
        verdict: 'maybe',
        performance: 'GGUF disk-streaming · ~1-3 t/s',
        reasoning: `Marginal — ${usableRamGB} GB RAM is below the 48 GB ideal. Disk-streaming GGUF works but is slow.`,
        category: 'llm',
      });
    } else {
      out.push({
        name: 'Llama 70B (Q4)', description: 'Flagship LLM, 70-billion params',
        verdict: 'no', performance: null,
        reasoning: `Estimated ${usableRamGB} GB free RAM — needs ≥48 GB. Use a workstation or cloud.`,
        category: 'llm',
      });
    }

    // ── Qwen2.5-Coder 32B Q4_K_M (~22 GB minimum incl. KV cache) ──
    // The de-facto local coding-agent model in 2026 (Continue.dev, Aider).
    // Calibrated as ~30% of Llama 7B Q4 throughput due to ~4.5× model size
    // and similar quant scheme.
    if (usableRamGB >= 22 && cls?.llama7BQ4TPSLow != null) {
      const tpsLow  = Math.max(8,  Math.round(cls.llama7BQ4TPSLow  * 0.30));
      const tpsHigh = Math.max(15, Math.round(cls.llama7BQ4TPSHigh * 0.30));
      out.push({
        name: 'Qwen2.5-Coder 32B (Q4)',
        description: 'Local coding-agent LLM, 32B params, 4-bit quantized',
        verdict: 'yes',
        performance: `~${tpsLow}–${tpsHigh} tokens/s`,
        reasoning: `Calibrated for ${cls.displayName} from llama.cpp. Most-used local coding model in 2026 — runs Continue.dev / Aider as a Cursor replacement.`,
