    } else if (midGflops >= 600 && usableRamGB >= 8) {
      const sLow  = Math.max(20, Math.round(140000 / hi));
      const sHigh = Math.max(40, Math.round(140000 / lo));
      out.push({
        name: 'LTX-Video (5s)',
        description: 'Lightricks 2B — fastest local video model',
        verdict: 'yes',
