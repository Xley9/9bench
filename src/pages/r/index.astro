    } else {
      out.push({
        name: 'Flux.1-schnell (1024×1024, 4 steps)',
        description: 'Fast 4-step Flux variant — 8 GB VRAM friendly',
        verdict: 'no', performance: null,
        reasoning: `Needs ≥8 GB VRAM. SDXL or SD 1.5 with --lowvram remain the budget-tier image options.`,
        category: 'image',
      });
    }

    // ── SD 1.5 ──
    if (midGflops >= 200) {
      const sLow  = Math.max(2, Math.round(5000 / hi));
      const sHigh = Math.max(5, Math.round(5000 / lo));
      out.push({
        name: 'Stable Diffusion 1.5 (512×512)', description: 'Standard image generation',
        verdict: 'yes',
        performance: `~${sLow}–${sHigh}s per image`,
        reasoning: 'Light enough for most modern hardware. Fast for ideation and iteration.',
        category: 'image',
      });
    } else {
      out.push({
        name: 'Stable Diffusion 1.5 (512×512)', description: 'Standard image generation',
        verdict: 'maybe',
        performance: '~30-90s per image',
        reasoning: 'Will run but slowly — older GPU or integrated graphics.',
        category: 'image',
