    } else if (fluxFloorVRAM >= 8) {
      out.push({
        name: 'Flux.1-dev (1024×1024, NF4)',
        description: '12B DiT — 2026\'s leading open image model',
        verdict: 'maybe',
        performance: '~60-180s per image',
        reasoning: `Tight VRAM (~${fluxFloorVRAM} GB) — works with --lowvram + tile-VAE but slow. Try Flux.1-schnell instead for fast iteration.`,
        category: 'image',
      });
    } else {
      out.push({
        name: 'Flux.1-dev (1024×1024, NF4)',
        description: '12B DiT — 2026\'s leading open image model',
        verdict: 'no', performance: null,
        reasoning: `Needs ≥12 GB VRAM for the NF4-quantized model. Use cloud (Replicate / Hugging Face) or upgrade GPU.`,
        category: 'image',
      });
    }

    // ── Flux.1-schnell (4 steps, 1024×1024) ──
    // Speed-optimized 4-step variant. ~70% of SDXL time, runs on 8 GB.
    if (cls?.sdxlSecondsLow != null && cls?.sdxlSecondsHigh != null && fluxFloorVRAM >= 8) {
      const sLow  = Math.max(1, Math.round(cls.sdxlSecondsLow  * 0.7));
      const sHigh = Math.max(2, Math.round(cls.sdxlSecondsHigh * 0.7));
      out.push({
        name: 'Flux.1-schnell (1024×1024, 4 steps)',
        description: 'Fast 4-step Flux variant — 8 GB VRAM friendly',
        verdict: 'yes',
        performance: `~${sLow}–${sHigh}s per image`,
