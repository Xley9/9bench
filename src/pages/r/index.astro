      });
    } else if (cls?.sdxlSecondsLow === null) {
      // GPU class explicitly says SDXL impractical
      out.push({
        name: 'Stable Diffusion XL (1024×1024)',
        description: 'High-res image generation',
        verdict: 'no', performance: null,
