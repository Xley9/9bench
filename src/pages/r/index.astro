    // ── HunyuanVideo Q4 (5s 720p) ──
    // 13B Tencent video model, 60% of r/StableDiffusion video discussion.
    // ~65× SDXL time on the same hardware (4090: SDXL 4s → HunyuanVideo 260s).
    // Q4 quant runs on 12 GB; fp16 needs 24 GB.
    if (cls?.sdxlSecondsLow != null && cls?.sdxlSecondsHigh != null && fluxFloorVRAM >= 12) {
      const sLow  = Math.round(cls.sdxlSecondsLow  * 65);
      const sHigh = Math.round(cls.sdxlSecondsHigh * 65);
      const minLow  = Math.floor(sLow / 60);
      const minHigh = Math.floor(sHigh / 60);
      const perfStr = sLow >= 60
        ? `~${minLow}–${minHigh} min per 5s 720p clip`
        : `~${sLow}–${sHigh}s per 5s 720p clip`;
      out.push({
        name: 'HunyuanVideo (5s 720p, Q4)',
        description: '13B Tencent video model — 2026\'s quality leader',
        verdict: 'yes',
        performance: perfStr,
        reasoning: `Calibrated for ${cls.displayName}. Q4 quant fits in 12 GB; fp16 needs 24 GB. Local video gen viable on consumer GPUs in 2026.`,
        category: 'video',
