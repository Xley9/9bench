    // ~55% of Llama 7B throughput due to vision encoder overhead.
    if (usableRamGB >= 6 && cls?.llama7BQ4TPSLow != null) {
      const tpsLow  = Math.max(5,  Math.round(cls.llama7BQ4TPSLow  * 0.55));
      const tpsHigh = Math.max(12, Math.round(cls.llama7BQ4TPSHigh * 0.55));
      out.push({
        name: 'Qwen2-VL 7B (Q4)',
