    } else if (midGflops >= 400 && usableRamGB >= 8) {
      const sLow  = Math.max(2,  Math.round(15000 / hi));
      const sHigh = Math.max(5,  Math.round(15000 / lo));
      out.push({
        name: 'Flux.1-schnell (1024×1024, 4 steps)',
