    // ── Flux.1-dev (NF4 quantized, 1024×1024, 20 steps) ──
    // 2026's most popular open image model (60%+ of r/StableDiffusion).
    // NF4 quant runs on 12 GB VRAM; fp16 needs 24 GB. Roughly ~3.5× SDXL time
    // due to the 12B DiT architecture vs SDXL's 2.6B UNet.
    const fluxFloorVRAM = cls?.typicalVRAM ?? Math.min(usableRamGB, 8);
    if (cls?.sdxlSecondsLow != null && cls?.sdxlSecondsHigh != null && fluxFloorVRAM >= 12) {
      const sLow  = Math.round(cls.sdxlSecondsLow  * 3.5);
      const sHigh = Math.round(cls.sdxlSecondsHigh * 3.5);
      out.push({
        name: 'Flux.1-dev (1024×1024, NF4)',
        description: '12B DiT — 2026\'s leading open image model',
        verdict: 'yes',
