        category: 'audio',
      });
    }

    return out;
  }

  /**
   * Compute a native AI score using the same weighting as the browser
   * AI score, but with extrapolated native values.
   */
  function computeNativeAIScore(nativeCtx: NativeContext): number {
    const midGflops = (nativeCtx.nativeGflopsLow + nativeCtx.nativeGflopsHigh) / 2;
    const gpuComp = midGflops * 0.5;          // higher weight scaling for native
    const memComp = nativeCtx.usableRamGB * 80;
    const fp16Bonus = nativeCtx.fp16Likely ? 300 : 0;
    return Math.round(gpuComp * 0.5 + memComp * 0.4 + fp16Bonus * 0.1);
  }

  function nativeAITier(score: number): { letter: string; sub: string } {
    if (score >= 5000) return { letter: 'AI-S',           sub: 'Workstation-class — 70B LLMs and large image models comfortable' };
    if (score >= 3000) return { letter: 'AI-A',           sub: 'Strong native AI — 13B LLMs, SDXL, real-time Whisper' };
    if (score >= 1700) return { letter: 'AI-B',           sub: 'Capable — 7-13B LLMs, SD 1.5 / SDXL with patience' };
    if (score >= 800)  return { letter: 'Workstation',    sub: '7B LLMs comfortable, SD 1.5 OK, SDXL slow' };
    if (score >= 400)  return { letter: 'Office',         sub: 'Light AI — Whisper, small image models, no LLMs' };
    return { letter: 'Limited', sub: 'Cloud-first — local AI not practical on this hardware' };
  }

  /**
   * Reproduce predictions client-side from stored result + AI metadata.
   * Mirrors generatePredictions() in src/bench/ai-capabilities.ts so the
   * source of truth lives next to the original probe.
   * Why duplicate: original lives in /src/bench/ which gets tree-shaken
   * server-side; importing it would pull in WebGPU probe code we don't
   * need on the result page.
   */
  function generatePredictionsClient(
    gpuGflops: number,
    ramReadGBs: number,
    largestAllocatableGB: number,
    fp16: boolean
  ): Array<{name: string; description: string; verdict: 'yes' | 'maybe' | 'no'; performance: string | null; reasoning: string; category: string}> {
    const NATIVE_RATIO = 0.35;
    const estimatedNativeGFLOPS = gpuGflops / NATIVE_RATIO;
    const estimatedNativeRAM = ramReadGBs / 0.4;
    const out: any[] = [];

    // Llama 7B Q4
    {
      const memT = (estimatedNativeRAM * 0.7) / 4;
      const compT = estimatedNativeGFLOPS / 50;
      const tps = Math.min(memT, compT);
      if (largestAllocatableGB < 4) {
        out.push({ name: 'Llama 7B (Q4)', description: 'Local LLM, 7B params, 4-bit quantized', verdict: 'no', performance: null,
          reasoning: `Browser memory headroom is ${largestAllocatableGB.toFixed(1)} GB; 7B Q4 needs ~4 GB just for weights.`, category: 'llm' });
      } else if (tps >= 15) {
        out.push({ name: 'Llama 7B (Q4)', description: 'Local LLM, 7B params, 4-bit quantized', verdict: 'yes',
          performance: `~${Math.round(tps - 5)}–${Math.round(tps + 10)} tokens/s`,
          reasoning: `Memory bandwidth (${ramReadGBs.toFixed(1)} GB/s browser ≈ ${estimatedNativeRAM.toFixed(0)} GB/s native est.) supports comfortable inference.`, category: 'llm' });
      } else {
        out.push({ name: 'Llama 7B (Q4)', description: 'Local LLM, 7B params, 4-bit quantized', verdict: 'maybe',
          performance: `~${Math.max(2, Math.round(tps - 3))}–${Math.round(tps + 5)} tokens/s`,
          reasoning: 'Will run but slowly — bandwidth-bound. RAM upgrade or faster storage helps.', category: 'llm' });
      }
    }
    // Llama 13B Q4
    {
      const tps = (estimatedNativeRAM * 0.7) / 8;
      if (largestAllocatableGB < 8) {
        out.push({ name: 'Llama 13B (Q4)', description: 'Local LLM, 13B params, 4-bit quantized', verdict: 'no', performance: null,
          reasoning: `Needs ~8 GB for weights; browser allocated only ${largestAllocatableGB.toFixed(1)} GB max.`, category: 'llm' });
      } else if (tps >= 8) {
        out.push({ name: 'Llama 13B (Q4)', description: 'Local LLM, 13B params, 4-bit quantized', verdict: 'yes',
          performance: `~${Math.max(3, Math.round(tps - 3))}–${Math.round(tps + 5)} tokens/s`,
          reasoning: 'Bandwidth supports usable inference. Suitable for chatbot use cases.', category: 'llm' });
      } else {
        out.push({ name: 'Llama 13B (Q4)', description: 'Local LLM, 13B params, 4-bit quantized', verdict: 'maybe',
          performance: `~${Math.max(2, Math.round(tps - 1))}–${Math.round(tps + 2)} tokens/s`,
          reasoning: 'Functional but slow. OK for batch jobs, not interactive chat.', category: 'llm' });
      }
    }
    // Llama 70B — always no for browser
    out.push({ name: 'Llama 70B (Q4)', description: 'Large flagship LLM, 70B params', verdict: 'no', performance: null,
      reasoning: 'Needs ~40 GB just for weights. Browser memory model caps allocation well below this. Use a native llama.cpp setup with 64 GB+ RAM.', category: 'llm' });

    // Qwen2.5-Coder 32B — always no for browser (~19 GB weights)
    out.push({ name: 'Qwen2.5-Coder 32B (Q4)', description: 'Local coding-agent LLM, 32B params, 4-bit quantized', verdict: 'no', performance: null,
      reasoning: 'Needs ~19 GB just for Q4 weights. Way beyond browser allocation caps. Native llama.cpp on 24 GB+ GPU only.', category: 'llm' });

    // Qwen2-VL 7B — similar headroom math to Llama 7B
    {
      if (largestAllocatableGB < 5) {
        out.push({ name: 'Qwen2-VL 7B (Q4)', description: 'Vision-language model — OCR, screenshots, multimodal', verdict: 'no', performance: null,
          reasoning: `Browser memory headroom is ${largestAllocatableGB.toFixed(1)} GB; 7B Q4 + vision encoder needs ~5 GB minimum.`, category: 'llm' });
      } else {
        out.push({ name: 'Qwen2-VL 7B (Q4)', description: 'Vision-language model — OCR, screenshots, multimodal', verdict: 'maybe',
          performance: 'Slow — vision encoder is unoptimized in browser',
          reasoning: 'transformers.js supports it but vision-encoder kernels run unoptimized. Use native llama.cpp / Ollama for usable speed.', category: 'llm' });
      }
    }

    // SDXL
    {
      if (!fp16) {
        out.push({ name: 'Stable Diffusion XL (1024×1024)', description: 'High-resolution image generation', verdict: 'maybe',
          performance: 'No estimate — FP16 unsupported',
          reasoning: "Your WebGPU adapter doesn't expose shader-f16. SDXL works in FP32 but is ~3× slower and may exceed memory limits.", category: 'image' });
      } else if (gpuGflops >= 800) {
        out.push({ name: 'Stable Diffusion XL (1024×1024)', description: 'High-resolution image generation', verdict: 'yes',
          performance: '~20-40s per image',
          reasoning: `GPU compute (${gpuGflops.toFixed(0)} GFLOPS browser) and FP16 support give you usable SDXL throughput.`, category: 'image' });
      } else if (gpuGflops >= 400) {
        out.push({ name: 'Stable Diffusion XL (1024×1024)', description: 'High-resolution image generation', verdict: 'maybe',
          performance: '~60-120s per image',
          reasoning: 'Will run but expect minute-plus generation times. Consider SD 1.5 (512×512) for faster results.', category: 'image' });
      } else {
        out.push({ name: 'Stable Diffusion XL (1024×1024)', description: 'High-resolution image generation', verdict: 'no', performance: null,
          reasoning: `GPU compute (${gpuGflops.toFixed(0)} GFLOPS) is below the practical floor for SDXL. Use cloud or a more powerful GPU.`, category: 'image' });
      }
    }
    // Flux.1-dev — needs 12 GB+ VRAM, browser caps at ~4 GB max → always NO
    out.push({ name: 'Flux.1-dev (1024×1024, NF4)', description: '12B DiT — 2026\'s leading open image model', verdict: 'no', performance: null,
      reasoning: 'NF4 quant still needs ~10 GB working memory. Browser sandbox caps allocation well below this. Native ComfyUI / Forge required.', category: 'image' });

    // Flux.1-schnell — possibly maybe on top-tier WebGPU (4 steps + 8 GB)
    {
      if (fp16 && gpuGflops >= 1500 && largestAllocatableGB >= 4) {
        out.push({ name: 'Flux.1-schnell (1024×1024, 4 steps)', description: 'Fast 4-step Flux variant — 8 GB VRAM friendly', verdict: 'maybe',
          performance: '~30-90s per image (browser)',
          reasoning: 'Top-tier WebGPU + FP16 can theoretically run it via ONNX Runtime Web — but 5-10× slower than native ComfyUI.', category: 'image' });
      } else {
        out.push({ name: 'Flux.1-schnell (1024×1024, 4 steps)', description: 'Fast 4-step Flux variant — 8 GB VRAM friendly', verdict: 'no', performance: null,
          reasoning: 'Browser memory + compute below the practical floor. Native ComfyUI / Forge required.', category: 'image' });
      }
    }

    // SD 1.5
    {
      if (gpuGflops >= 200) {
        out.push({ name: 'Stable Diffusion 1.5 (512×512)', description: 'Standard image generation', verdict: 'yes',
          performance: gpuGflops >= 500 ? '~5-15s per image' : '~15-30s per image',
          reasoning: 'Light enough to run smoothly on your hardware. Good for ideation.', category: 'image' });
      } else {
        out.push({ name: 'Stable Diffusion 1.5 (512×512)', description: 'Standard image generation', verdict: 'maybe',
          performance: '~30-60s per image',
          reasoning: 'Functional but slow — usable for occasional generation, not iterative work.', category: 'image' });
      }
    }

    // HunyuanVideo — always no for browser
    out.push({ name: 'HunyuanVideo (5s 720p, Q4)', description: '13B Tencent video model — 2026\'s quality leader', verdict: 'no', performance: null,
      reasoning: 'Local video gen requires 12 GB+ VRAM and minutes of GPU time. Browser-impractical. Native ComfyUI on RTX 4070+ / M3 Max+.', category: 'video' });

    // LTX-Video — possibly maybe on top-tier WebGPU (lighter 2B model)
    {
      if (fp16 && gpuGflops >= 1500 && largestAllocatableGB >= 4) {
        out.push({ name: 'LTX-Video (5s)', description: 'Lightricks 2B — fastest local video model', verdict: 'maybe',
          performance: '~2-5 min per 5s clip (browser)',
          reasoning: 'Top-tier WebGPU can run the 2B model. Native ComfyUI is 5-10× faster — use that for real work.', category: 'video' });
      } else {
        out.push({ name: 'LTX-Video (5s)', description: 'Lightricks 2B — fastest local video model', verdict: 'no', performance: null,
          reasoning: 'Browser memory + compute below the practical floor. Native ComfyUI / DiffusionPipeline required.', category: 'video' });
      }
    }

    // Whisper
    {
      if (gpuGflops >= 150 && largestAllocatableGB >= 1) {
        out.push({ name: 'Whisper Small (audio→text)', description: 'Real-time speech-to-text', verdict: 'yes',
          performance: gpuGflops >= 400 ? 'Faster than real-time (~3-5×)' : 'Near real-time (~1-2×)',
          reasoning: 'Whisper is light (~244M params); your hardware handles it comfortably.', category: 'audio' });
      } else {
        out.push({ name: 'Whisper Small (audio→text)', description: 'Real-time speech-to-text', verdict: 'maybe',
          performance: 'Slower than real-time',
          reasoning: 'Will run but transcription will lag the audio. Consider Whisper Tiny for faster pace.', category: 'audio' });
      }
    }
    return out;
  }

  const $ = <T extends HTMLElement = HTMLElement>(sel: string) =>
    document.querySelector(sel) as T | null;
  const $$ = (sel: string) => Array.from(document.querySelectorAll(sel));

  const loadingEl = $('#loading')!;
  const errorEl   = $('#error')!;
  const resultEl  = $('#result')!;

  // Extract id from URL: /r/abc12345/ or /r/abc12345
  const pathParts = window.location.pathname.split('/').filter(Boolean);
  const resultId  = (pathParts[1] || '').toLowerCase();

  function fmt(n: number): string {
    return Number(n).toLocaleString();
  }
  function ordinal(n: number): string {
    const s = ['th','st','nd','rd'];
    const v = n % 100;
    return n + (s[(v - 20) % 10] || s[v] || s[0]);
  }
  function setText(sel: string, text: string) {
    const el = $(sel); if (el) el.textContent = text;
  }

  /**
   * Build the narrative paragraph from real data.
   * Avoids fabrication — only references measurements that exist.
   */
  function narrativeFor(r: any, percentile: number, total: number): string {
    const tier = tierFor(r.scores.overall);
    const isStrong = r.scores.overall >= 1700;
    const isMid    = r.scores.overall >= 1000;
    const isLow    = r.scores.overall < 500;

    // Identify component imbalance (RAM is structurally low in browsers,
    // so don't shame it — but if GPU or CPU is much weaker than the others,
    // call it out)
    const components = [
      ['GPU', r.scores.gpu],
      ['CPU', r.scores.cpuMulti],
    ] as Array<[string, number]>;
    const max = Math.max(...components.map(c => c[1]));
    const min = Math.min(...components.map(c => c[1]));
    const weakest = components.find(c => c[1] === min)?.[0];
    const imbalanced = max > 0 && (min / max) < 0.45;

    if (isStrong) {
      return imbalanced
        ? `Strong overall, but ${weakest} lags noticeably. Likely your next upgrade target.`
        : `Strong configuration. You're paying enough that this is what you should expect.`;
    }
    if (isMid) {
      return `Solid working machine. Office, browser-everything, light gaming — fine. Demanding 2026 tasks (local LLMs, 4K editing) will feel the squeeze.`;
    }
    if (isLow) {
      return `Built for spreadsheets, not silicon-flexing. That's totally fine — calibrate expectations.`;
    }
    return `Functional everyday machine. Replacement cycle approaching for creative or technical work.`;
  }

  async function load() {
    if (!/^[a-f0-9]{8}$/.test(resultId)) {
      loadingEl.hidden = true;
      errorEl.hidden = false;
      $('#error-message')!.textContent = 'Invalid result ID format. Try the homepage.';
      return;
    }

    try {
      const res = await fetch(`/api/r/${resultId}`);
      if (!res.ok) {
        const errBody = await res.json().catch(() => ({}));
        throw new Error((errBody as any).error || `HTTP ${res.status}`);
      }
      const data = await res.json() as any;
      if (!data.ok) throw new Error(data.error || 'Unknown error');

      const r          = data.result;
      const percentile = data.percentile ?? 0;
      const total      = data.total ?? 0;
      const tier       = tierFor(r.scores.overall);

      // r.createdAt is already milliseconds (set via Date.now() in submit.ts).
      // The previous *1000 multiplied to nanoseconds → invalid date "Mar 10, 58295".
      const dateStr = new Date(r.createdAt).toLocaleString('en-US', {
        month: 'short', day: 'numeric', year: 'numeric',
        hour: '2-digit', minute: '2-digit', timeZone: 'UTC',
      }) + ' UTC';

      // ── Document title with score ────────────────────────────
      document.title = `9bench ${fmt(r.scores.overall)} (${tier.label}) — your hardware in 15 seconds`;

      // ── Header strip ─────────────────────────────────────────
      setText('#result-status', '✓ TEST COMPLETE');
      setText('#result-date',   dateStr);
      // We don't store browser strings yet — placeholder until schema migration
      $('#result-browser')!.style.display = 'none';

      // ── Hero ─────────────────────────────────────────────────
      setText('#result-score', fmt(r.scores.overall));
      setText('#tier-label',   tier.label);
      setText('#tier-sub',     tier.sub);
      $('#tier-label')!.style.color = tier.color;
      setText('#result-narrative', narrativeFor(r, percentile, total));

      // ── Rank line: percentile gate at N ≥ 100 ────────────────
      if (total >= PERCENTILE_MIN_N) {
        setText('#result-rank',
          `Faster than ${percentile}% of all runs · Ranked ${ordinal(total - Math.round(total * percentile / 100))} of ${fmt(total)}.`);
      } else {
        setText('#result-rank',
          `Early days — ${fmt(total)} test${total === 1 ? '' : 's'} so far. Percentile ranking unlocks at 100+ runs.`);
      }

      // ── Component grid ───────────────────────────────────────
      setText('#comp-gpu',  fmt(r.scores.gpu));
      setText('#comp-cpu1', fmt(r.scores.cpuSingle));
      setText('#comp-cpum', fmt(r.scores.cpuMulti));
      setText('#comp-ram',  fmt(r.scores.ram));
      setText('#comp-gpu-sub',  `${r.gpu.gflops.toFixed(0)} GFLOPS`);
      setText('#comp-ram-sub',  `${r.ram.readGBs.toFixed(1)} / ${r.ram.writeGBs.toFixed(1)} GB/s`);

      // ── Detected hardware rows ───────────────────────────────
      setText('#hw-gpu',     r.gpu.name || 'Browser hides this — re-test to add manually');
      setText('#hw-cpu',     `${r.cpu.cores} cores`);
      setText('#hw-ram',     `${r.ram.readGBs.toFixed(1)} GB/s read · ${r.ram.writeGBs.toFixed(1)} GB/s write · ${r.ram.latencyNs.toFixed(1)} ns latency`);
      setText('#hw-browser', 'Browser info per-test (not stored)');

      // ── Raw measurements ─────────────────────────────────────
      setText('#raw-gflops',     `${r.gpu.gflops.toFixed(1)} GFLOPS`);
      setText('#raw-cores',      String(r.cpu.cores));
      setText('#raw-sha-single', `${fmt(Math.round(r.cpu.hashesSingle))} h/s`);
      setText('#raw-sha-multi',  `${fmt(Math.round(r.cpu.hashesMulti))} h/s`);
      setText('#raw-ram-read',   `${r.ram.readGBs.toFixed(1)} GB/s`);
      setText('#raw-ram-write',  `${r.ram.writeGBs.toFixed(1)} GB/s`);
      setText('#raw-ram-latency',`${r.ram.latencyNs.toFixed(1)} ns`);

      // ── Trading card ─────────────────────────────────────────
      setText('#card-id',     `-${r.id.slice(0, 6)}-`);
      setText('#card-score',  fmt(r.scores.overall));
      // Tier badge: full label below the score (was previously just "S"
      // rendered as a 36px superscript right next to the score number,
      // which looked like a typo on the PNG export).
      // S-tier → "S-TIER · ENTHUSIAST / WORKSTATION", D-tier → "PATIENT & HONEST · IT STILL GETS THE JOB DONE", etc.
      setText('#card-tier', `${tier.label.toUpperCase()} · ${tier.sub.toUpperCase()}`);
      setText('#card-hw',     [
        r.gpu.name || 'GPU details hidden',
        `${r.cpu.cores}-core CPU`,
      ].join(' · '));
      setText('#card-gpu',    fmt(r.scores.gpu));
      setText('#card-cpu1',   fmt(r.scores.cpuSingle));
      setText('#card-cpum',   fmt(r.scores.cpuMulti));
      setText('#card-ram',    fmt(r.scores.ram));
      const cardPctText = total >= PERCENTILE_MIN_N
        ? `Faster than ${percentile}% globally`
        : `Early days · ${fmt(total)} test${total === 1 ? '' : 's'} so far`;
      setText('#card-pct', cardPctText);
      setText('#card-url', `9bench.com/r/${r.id}`);

      // ── Share actions URLs ───────────────────────────────────
      const url = `https://9bench.com/r/${r.id}`;
      setText('#share-url-display', url.replace(/^https?:\/\//, ''));
      setText('#permalink-url',     url);
      ($('#share-beat')! as HTMLAnchorElement).href = url;

      // ── Component imbalance callout (Phase G.4) ──────────────
      // Identify the weakest non-RAM component (RAM is excluded because
      // it's structurally low in browsers — the disclaimer covers that).
      // If GPU or CPU is significantly behind the others, point it out.
      renderImbalanceCallout(r);

      // ── AI Capabilities section (Phase G.3) ──────────────────
      // Returns the native context so we can pass it to the live LLM
      // test wiring for the "vs estimate" comparison.
      const nativeCtxForCompare = renderAISection(r);

      // ── Show result, hide loading ────────────────────────────
      loadingEl.hidden = true;
      resultEl.hidden = false;

      // ── Wire share buttons ───────────────────────────────────
      wireShareButtons(r, percentile, total, tier, url);

      // ── Wire live LLM test (Phase L) ──────────────────────────
      // Reads memory headroom from r.ai if available; falls back to
      // a conservative 1 GB if no AI block (legacy results pre-G).
      const headroomGB = r.ai?.memory?.largestAllocatableGB ?? 1;
      wireLLMLiveTest(headroomGB, nativeCtxForCompare);

      // ── Load reference hardware comparison (async, non-blocking) ──
      loadReferenceComparison(r.scores.overall);
    } catch (e: any) {
      console.error('Failed to load result', e);
      loadingEl.hidden = true;
      errorEl.hidden = false;
      $('#error-message')!.textContent = e?.message || 'Could not load this result.';
    }
  }

  /**
   * Wire all the share-action buttons. Each is independent so a failure
   * in one (e.g. clipboard blocked) doesn't break the others.
   */
  function wireShareButtons(r: any, percentile: number, total: number, tier: any, url: string) {
    const shareTextStr = shareText(r.scores.overall, total >= PERCENTILE_MIN_N ? percentile : undefined);

    // Copy link
    $('#share-link')?.addEventListener('click', async (e) => {
      const btn = e.currentTarget as HTMLButtonElement;
      try {
        await navigator.clipboard.writeText(url);
        const original = btn.textContent;
        btn.classList.add('is-success');
        btn.textContent = '✓ COPIED';
        setTimeout(() => { btn.classList.remove('is-success'); btn.textContent = original; }, 1500);
      } catch {
        // Fallback: open prompt() for user to copy manually
        prompt('Copy this URL:', url);
      }
    });

    // X / Twitter share
    $('#share-twitter')?.addEventListener('click', () => {
      const text = `${shareTextStr} ${url}`;
      const u = `https://twitter.com/intent/tweet?text=${encodeURIComponent(text)}`;
      window.open(u, '_blank', 'noopener,width=560,height=600');
    });

    // Reddit share — opens compose with title pre-filled
    $('#share-reddit')?.addEventListener('click', () => {
      const title = `${shareTextStr.replace(/\.$/, '')} — built it in the browser`;
      const u = `https://www.reddit.com/submit?url=${encodeURIComponent(url)}&title=${encodeURIComponent(title)}`;
      window.open(u, '_blank', 'noopener');
    });

    // PNG export — captures the .trading-card DOM directly
    $('#share-png')?.addEventListener('click', async (e) => {
      const btn = e.currentTarget as HTMLButtonElement;
      const card = $('#trading-card');
      if (!card) return;
      const original = btn.textContent;
      btn.disabled = true;
      btn.textContent = '⏳ RENDERING…';
      try {
        // 3x pixelRatio for crisp 1080×1350 export — Twitter/Reddit display
        // images at 1080px wide; 3x of our 360px card width = 1080px exact.
        const dataUrl = await toPng(card, {
          pixelRatio: 3,
          backgroundColor: '#0A0A0A',
          cacheBust: true,
        });
        const a = document.createElement('a');
        a.download = `9bench-${r.id}.png`;
        a.href = dataUrl;
        a.click();
        btn.classList.add('is-success');
        btn.textContent = '✓ DOWNLOADED';
        setTimeout(() => { btn.classList.remove('is-success'); btn.textContent = original; btn.disabled = false; }, 1500);
      } catch (err) {
        console.error('PNG export failed', err);
        btn.textContent = '✗ FAILED — try copy link instead';
        btn.disabled = false;
        setTimeout(() => { btn.textContent = original; }, 2500);
      }
    });

    // JSON export — full result for verification
    $('#share-json')?.addEventListener('click', () => {
      const blob = new Blob([JSON.stringify({
        url,
        result: r,
        percentile,
        total,
        exportedAt: new Date().toISOString(),
      }, null, 2)], { type: 'application/json' });
      const a = document.createElement('a');
      a.download = `9bench-${r.id}.json`;
      a.href = URL.createObjectURL(blob);
      a.click();
      URL.revokeObjectURL(a.href);
    });
  }

  /**
   * Wire the "Run Live LLM Test" button (Phase L).
   *
   * On click, lazy-loads transformers.js + a tiny LLM, runs inference
   * for ~30s, displays measured tokens/s. Compares against the native
   * Llama 7B Q4 estimate so users can see how browser-WASM compares
   * to native llama.cpp performance ceilings.
   */
  function wireLLMLiveTest(
    headroomGB: number,
    nativeCompare: { llama7BTPSLow: number; llama7BTPSHigh: number; matchedDisplayName: string | null } | null
  ) {
    const btn = $('#llm-run-btn') as HTMLButtonElement | null;
    if (!btn) return;

    btn.addEventListener('click', async () => {
      // Disable button + show panel
      btn.disabled = true;
      btn.textContent = '⏳ RUNNING TEST…';
      $('#llm-test-panel')!.removeAttribute('hidden');
      $('#llm-result')!.setAttribute('hidden', '');
      $('#llm-error')!.setAttribute('hidden', '');

      try {
        const result = await runLLMLiveTest(headroomGB, (progress: LLMTestProgress) => {
          // Update progress bar + text
          const fill = $('#llm-progress-fill');
          const text = $('#llm-progress-text');
          if (fill && progress.percent != null) {
            fill.style.width = progress.percent + '%';
          }
          if (text) text.textContent = progress.message;

          if (progress.phase === 'error') {
            $('#llm-error-msg')!.textContent = progress.error || 'Unknown error';
            $('#llm-error')!.removeAttribute('hidden');
          }
        });

        // Render the result block
        renderLLMResult(result, nativeCompare);
        btn.textContent = '✓ TEST COMPLETE';
        btn.disabled = false;
      } catch (e: any) {
        // Error already surfaced via onProgress error phase
        console.error('Live LLM test failed', e);
        btn.textContent = '✗ FAILED — TRY AGAIN';
        btn.disabled = false;
      }
    });
  }

  /**
   * Render the final LLM test result with comparison to native estimate.
   */
  function renderLLMResult(
    result: LLMTestResult,
    nativeCompare: { llama7BTPSLow: number; llama7BTPSHigh: number; matchedDisplayName: string | null } | null
  ) {
    $('#llm-result')!.removeAttribute('hidden');

    $('#llm-result-tps')!.textContent = formatTPS(result.tokensPerSecond).replace(' t/s', '');
    $('#llm-result-model')!.textContent = result.modelDisplayName;
    $('#llm-model-tag')!.textContent = result.modelDisplayName;
    $('#llm-result-tokens')!.textContent = result.tokensGenerated.toString();
    $('#llm-result-seconds')!.textContent = result.inferenceSeconds.toFixed(1);

    // ── Honest same-model native estimate ──
    // Previous version compared browser-DistilGPT-2 against native-Llama-7B
    // and produced a misleading ~1× ratio. Different model sizes — apples
    // to oranges. The defensible, well-documented number is:
    //
    //   browser-vs-native on the SAME model = 5-10× slowdown
    //
    // Sources: llama.cpp GitHub issues #4167, #5950; MLX-Examples README;
    // 9bench Article 4 (Browser vs Native LLM Performance) — all converge
    // on 5-10× for the same model running browser vs native on identical
    // hardware. So we show the user what their hardware would do natively
    // running the SAME model they just tested. No cross-model conflation.
    const verdictEl = $('#llm-compare-verdict');
    if (verdictEl && result.tokensPerSecond > 0) {
      const nativeSameLow  = Math.round(result.tokensPerSecond * 5);
      const nativeSameHigh = Math.round(result.tokensPerSecond * 10);
      verdictEl.innerHTML =
        `<span class="text-accent font-mono" style="font-weight: 700;">` +
        `~${nativeSameLow}–${nativeSameHigh} t/s` +
        `</span>` +
        `<span class="text-fg-3 font-mono" style="font-size: 11px; margin-left: 8px;">` +
        `(extrapolated · 5-10× browser→native)` +
        `</span>`;
    } else if (verdictEl) {
      verdictEl.textContent = '—';
    }
    // Suppress the previously-noisy nativeCompare warning (variable kept
    // in signature for API compat — we may use Llama 7B numbers in a
    // future "what about real models?" tooltip).
    void nativeCompare;
  }

  /**
   * Render component imbalance callout when one of GPU/CPU lags
   * significantly behind the others. RAM is excluded (browser-cap).
   */
  function renderImbalanceCallout(r: any) {
    const components: Array<[string, number]> = [
      ['GPU',         r.scores.gpu],
      ['CPU·1 (single-core)', r.scores.cpuSingle],
      ['CPU·M (multi-core)',  r.scores.cpuMulti],
    ];
    // Find min and max non-RAM scores
    const max = Math.max(...components.map(c => c[1]));
    const min = Math.min(...components.map(c => c[1]));
    const ratio = min / Math.max(max, 1);

    // Only flag if min is < 50% of max (meaningful imbalance)
    if (ratio >= 0.5) {
      // Also check RAM is not under 30% of CPU·M (browser cap is well-known
      // but extreme RAM gaps still useful to mention)
      const ramRatio = r.scores.ram / Math.max(r.scores.cpuMulti, 1);
      if (ramRatio < 0.20) {
        const callout = $('#imbalance-callout');
        if (callout) {
          callout.classList.remove('imbalance-callout--warn');
          $('#imbalance-title')!.textContent = 'Memory bandwidth is your floor';
          $('#imbalance-detail')!.textContent =
            `RAM scored ${(r.scores.cpuMulti / Math.max(r.scores.ram, 1)).toFixed(1)}× lower than CPU multi-core. ` +
            `Partly browser-sandbox cap (typical 30-50% of native), but if native benchmarks show similar gap, RAM upgrade gives you the biggest practical speedup.`;
          callout.removeAttribute('hidden');
        }
      }
      return;
    }

    const weakest = components.find(c => c[1] === min)!;
    const callout = $('#imbalance-callout');
    if (!callout) return;

    callout.classList.add('imbalance-callout--warn');
    $('#imbalance-title')!.textContent = `Bottleneck identified: ${weakest[0]}`;
    $('#imbalance-detail')!.textContent =
      `${weakest[0]} scored ${(max / Math.max(min, 1)).toFixed(1)}× lower than your strongest component. ` +
      `Likely your most actionable upgrade target — would unlock more performance from the rest of your machine.`;
    callout.removeAttribute('hidden');
  }

  /**
   * Render the AI Capabilities section. Two paths:
   *   - r.ai != null  → Phase-G result, full AI section with predictions
   *   - r.ai == null  → Pre-Phase-G result, legacy notice + re-test prompt
   *
   * Phase H: Now renders Browser + Native side-by-side. Browser uses
   * the directly-measured fields; Native is extrapolated client-side
   * via estimateNativeContext() + generateNativePredictions().
   */
  function renderAISection(r: any): { llama7BTPSLow: number; llama7BTPSHigh: number; matchedDisplayName: string | null } | null {
    const ai = r.ai;
    if (!ai) {
      // Legacy result, no AI block — show "test again" prompt
      $('#ai-section-legacy')!.removeAttribute('hidden');
      return null;
    }

    // ── Browser values (directly measured during the bench run) ──
    const browserFp16     = !!ai.webgpu?.fp16;
    const browserMaxAlloc = ai.memory?.largestAllocatableGB ?? 0;
    const browserGflops   = r.gpu.gflops || 0;
    const browserRamGBs   = r.ram.readGBs || 0;
    const browserTier     = aiTierLabel(ai.tier);

    // ── Native estimation (extrapolated from browser values) ──
    // Phase K: pass GPU name so the lookup table can refine estimates
    // when we recognize the hardware (RTX 4060 Laptop, M2 Pro, etc).
    const nativeCtx       = estimateNativeContext(
      browserGflops,
      r.cpu.cores || 4,
      browserFp16,
      r.gpu.name || null,
    );
    const nativeScore     = computeNativeAIScore(nativeCtx);
    const nativeTierInfo  = nativeAITier(nativeScore);

    // ── Browser score block ──
    $('#ai-browser-score')!.textContent = ai.score.toLocaleString();
    $('#ai-browser-tier')!.textContent  = ai.tier;
    $('#ai-browser-sub')!.textContent   = browserTier.sub;

    // ── Native score block ──
    $('#ai-native-score')!.textContent = '~' + nativeScore.toLocaleString();
    $('#ai-native-tier')!.textContent  = nativeTierInfo.letter;
    // When we matched a known GPU class, surface that — gives users
    // confidence the estimates aren't pure extrapolation. Falls back
    // gracefully to the RAM-only suffix when no class match.
    const nativeSubExtras = nativeCtx.matchedDisplayName
      ? ` · matched ${nativeCtx.matchedDisplayName} · ~${nativeCtx.estimatedTotalRamGB} GB unified/system RAM`
      : ` · est. ${nativeCtx.estimatedTotalRamGB} GB system RAM`;
    $('#ai-native-sub')!.textContent   = nativeTierInfo.sub + nativeSubExtras;

    // ── Feature inventory (browser-only — these describe the sandbox limits) ──
    setFeature('fp16',
      browserFp16 ? 'ok' : 'warn',
      browserFp16 ? 'shader-f16 supported' : 'shader-f16 not exposed',
      browserFp16
        ? 'Modern LLMs use FP16/BF16. Your adapter supports it.'
        : 'FP16 unsupported in browser — but native almost certainly has it.');

    const memTier = browserMaxAlloc >= 4 ? 'ok' : browserMaxAlloc >= 1 ? 'warn' : 'limit';
    setFeature('buffer',
      memTier,
      `${browserMaxAlloc.toFixed(1)} GB max allocation (browser)`,
      browserMaxAlloc >= 4 ? 'Enough headroom for 7-13B quantized models in-browser.' :
      browserMaxAlloc >= 2 ? 'Tight in-browser — but ~' + nativeCtx.estimatedTotalRamGB + ' GB system RAM available natively.' :
      'Browser sandbox-limited. Native estimated ~' + nativeCtx.estimatedTotalRamGB + ' GB available.');

    const webgpuOk = ai.webgpu !== null && ai.webgpu !== undefined;
    setFeature('webgpu',
      webgpuOk ? 'ok' : 'limit',
      webgpuOk ? 'compute available' : 'compute unavailable',
      webgpuOk
        ? 'Required for GPU-accelerated AI inference (both browser + native via CUDA/Metal/Vulkan).'
        : 'CPU-only fallback in browser. Native would still use GPU directly.');

    // ── Browser predictions (the existing generatePredictionsClient) ──
    const browserPreds = generatePredictionsClient(
      browserGflops, browserRamGBs, browserMaxAlloc, browserFp16
    );

    // ── Native predictions (the new generator) ──
    const nativePreds = generateNativePredictions(nativeCtx);

    // ── Build the 2-column predictions table ──
    // We pair predictions by name. If a prediction exists in one but
    // not the other, we render a placeholder cell. In practice both
    // generators produce the same workload list in the same order.
    const allNames = Array.from(new Set([
      ...browserPreds.map(p => p.name),
      ...nativePreds.map(p => p.name),
    ]));

    const renderCell = (p: any) => {
      if (!p) return '<div class="ai-pred-row__cell"><span class="text-fg-3 font-mono">—</span></div>';
      const icon = p.verdict === 'yes' ? '✓' : p.verdict === 'maybe' ? '~' : '✗';
      const verdictText = p.verdict === 'yes' ? 'YES' : p.verdict === 'maybe' ? 'MAYBE' : 'NO';
      const perfHtml = p.performance
        ? `<span class="ai-pred-row__perf">${escapeHtml(p.performance)}</span>` : '';
      return `<div class="ai-pred-row__cell ai-pred-row__cell--${p.verdict}">
        <span class="ai-pred-row__verdict">
          <span class="ai-pred-row__verdict-icon">${icon}</span>
          ${verdictText}
        </span>
        ${perfHtml}
        <span class="ai-pred-row__reason">${escapeHtml(p.reasoning)}</span>
      </div>`;
    };

    const rowsHtml = allNames.map((name) => {
      const bp = browserPreds.find(p => p.name === name);
      const np = nativePreds.find(p => p.name === name);
      const desc = (bp || np)?.description || '';
      return `<div class="ai-pred-row">
        <div class="ai-pred-row__name-cell">
          <span class="ai-pred-row__name">${escapeHtml(name)}</span>
          <span class="ai-pred-row__desc">${escapeHtml(desc)}</span>
        </div>
        ${renderCell(bp)}
        ${renderCell(np)}
      </div>`;
    }).join('');

    $('#ai-pred-rows')!.innerHTML = rowsHtml;
    $('#ai-section')!.removeAttribute('hidden');

    // Return data needed for the live LLM test "vs estimate" comparison.
    // We use the native Llama 7B prediction range as the calibration
    // target — that's what users will most likely run with llama.cpp.
    const llama7B = nativePreds.find(p => p.name.startsWith('Llama 7B'));
    let lo = 0, hi = 0;
    if (llama7B?.performance) {
      const m = llama7B.performance.match(/~?(\d+(?:\.\d+)?)–(\d+(?:\.\d+)?)/);
      if (m) { lo = parseFloat(m[1]); hi = parseFloat(m[2]); }
    }
    return {
      llama7BTPSLow:  lo,
      llama7BTPSHigh: hi,
      matchedDisplayName: nativeCtx.matchedDisplayName,
    };
  }

  // Local escapeHtml (the result page already has one in renderShareButtons
  // scope, but we need it earlier here). Keep behavior identical.
  function escapeHtml(s: string): string {
    return String(s ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  /**
   * Set a feature card's icon, value, sub, and color tier.
   *
   * Replaces the old setFeature() that augmented the strong's textContent
   * with the value — that produced doubled labels like
   * "FP16 (shader-f16) · shader-f16". Now the value goes into a
   * dedicated .ai-feat__value span so each piece stays clean.
   */
  function setFeature(id: string, tier: 'ok' | 'warn' | 'limit', value: string, sub: string) {
    const el = $(`#ai-feat-${id}`);
    if (!el) return;
    el.classList.remove('ai-feat--ok', 'ai-feat--warn', 'ai-feat--limit');
    el.classList.add(`ai-feat--${tier}`);

    const icon = el.querySelector<HTMLElement>('.ai-feat__icon');
    if (icon) icon.textContent = tier === 'ok' ? '✓' : tier === 'warn' ? '⚠' : '○';

    const valueEl = $(`#ai-feat-${id}-value`);
    if (valueEl) valueEl.textContent = value;

    const subEl = $(`#ai-feat-${id}-sub`);
    if (subEl) subEl.textContent = sub;
  }

  /**
   * Load reference hardware comparison bars from /api/reference-hardware.
   * Empty response → section stays hidden entirely.
   * Real data → fill bars and reveal the section.
   */
  async function loadReferenceComparison(userScore: number) {
    try {
      const res = await fetch(`/api/reference-hardware?limit=6&around=${userScore}`);
      if (!res.ok) return;  // graceful — section stays hidden
      const data = await res.json() as any;
      const items = data.items || [];
      if (items.length < 3) return;  // Less than 3 references = not useful — stay hidden

      const container = $('#cmp-bars');
      if (!container) return;

      // Determine the bar scale: we render relative to the user's score.
      // Bars go left (negative delta) or right (positive delta) from a
      // center line, max ±60% gives readable scale for typical hardware.
      const MAX_DELTA = 60;

      const html = items.map((item: any) => {
        const pct = ((item.score - userScore) / userScore) * 100;
        const sign = pct > 0 ? '+' : pct < 0 ? '-' : '';
        const absPct = Math.min(Math.abs(pct), MAX_DELTA);
        const halfWidth = (absPct / MAX_DELTA) * 50;  // 0-50% of half-track
        const isFasterThanUser = pct > 0;
        const fillStyle = isFasterThanUser
          ? `left: 50%; width: ${halfWidth}%;`
          : `right: 50%; width: ${halfWidth}%;`;
        const fillClass = isFasterThanUser ? '' : 'cmp-bar__fill--neg';
        const deltaClass = isFasterThanUser ? '' : 'cmp-bar__delta--neg';
        const deltaText = sign === '' ? '·' : `${sign}${absPct.toFixed(0)}%`;
        return `
          <div class="cmp-bar">
            <span class="cmp-bar__label" title="${item.notes || ''}">${item.name}</span>
            <div class="cmp-bar__track">
              <div class="cmp-bar__fill ${fillClass}" style="${fillStyle}"></div>
            </div>
            <span class="cmp-bar__delta ${deltaClass}">${deltaText}</span>
          </div>
        `;
      }).join('');

      container.innerHTML = `
        <p style="font-family: var(--mono); font-size: 11px; color: var(--fg-3); margin: 0 0 12px 0;">
          Negative = your machine is faster · Positive = reference is faster
        </p>
        ${html}
      `;
      $('#cmp-section')?.removeAttribute('hidden');
    } catch (e) {
      // Silent fallback — placeholder stays visible
      console.warn('reference-hardware fetch failed', e);
    }
  }

  load();
</script>
