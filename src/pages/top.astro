---
/**
 * /top — V1 Terminal leaderboard.
 *
 * Tabular display matching V1 mockup: rank · score · CPU · GPU · flag · hash · date.
 * Period filter: 7D / 30D / ALL.
 *
 * Country flags are not in the schema yet (Phase 2 enrichment from CF
 * geo headers). Until then, we hide the FLAG column gracefully — never
 * fabricate locations.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import TruthDisclaimer from '../components/bench/TruthDisclaimer.astro';
import { tierFor } from '../components/bench/tier-system';
---

<BaseLayout
  title="Top scores — 9bench"
  description="The fastest computers measured by 9bench, anonymously. Browser hardware benchmark leaderboard, last 7 days."
  keywords="top hardware benchmark scores, fastest computer 9bench, leaderboard, gpu benchmark ranking, cpu benchmark top, browser benchmark leaderboard"
  breadcrumbItems={[{ name: 'Top Scores' }]}
>
  <main class="container top-page">

    <!-- Eyebrow + Hero -->
    <div class="top-page__head">
      <div class="eyebrow eyebrow--accent">// LEADERBOARD · LIVE</div>
      <h1 class="top-page__title">
        Top scores.<br />
        <span class="text-fg-3">Last <span id="period-label">7 days</span>.</span>
      </h1>
    </div>

    <!-- Period filter -->
    <div class="top-page__filters">
      <button class="filter-btn is-active" data-period="week">7D</button>
      <button class="filter-btn" data-period="month">30D</button>
      <button class="filter-btn" data-period="all">ALL</button>
      <span class="filter-meta font-mono" id="filter-meta">—</span>
    </div>

    <!-- Loading / error states -->
    <div id="loading" class="top-page__loading">
      <span class="loading-pulse" aria-hidden="true"></span>
      <span class="font-mono">Fetching leaderboard…</span>
    </div>
    <div id="error" class="top-page__error" hidden>
      <p class="text-warn font-mono">Could not load leaderboard.</p>
      <p id="error-message" class="text-fg-3 font-mono" style="font-size: 12px;">—</p>
    </div>

    <!-- Empty state (shown when zero results in period) -->
    <div id="empty" class="top-page__empty" hidden>
      <p class="text-fg-2 font-mono">No tests submitted in this period yet.</p>
      <p class="text-fg-3 font-mono" style="font-size: 12px; margin-top: 8px;">
        Be the first.
      </p>
      <p style="margin-top: 24px;">
        <a href="/test/" class="run-btn">▶ TEST MY HARDWARE</a>
      </p>
    </div>

    <!-- Leaderboard table -->
    <div id="leaderboard-wrap" hidden>
      <div class="leaderboard-table">
        <table class="table">
          <thead>
            <tr>
              <th>Rank</th>
              <th>Score</th>
              <th>CPU</th>
              <th>GPU</th>
              <th>Hash</th>
              <th class="num">Date</th>
            </tr>
          </thead>
          <tbody id="leaderboard-rows">
            <!-- populated by JS -->
          </tbody>
        </table>
      </div>
      <p class="leaderboard-meta font-mono" id="leaderboard-meta">—</p>
    </div>

    <!-- Truth disclaimer -->
    <section style="padding: 48px 0 32px;">
      <TruthDisclaimer compact />
    </section>

    <!-- CTA -->
    <section class="top-page__cta">
      <a href="/test/" class="run-btn">▶ TEST MY HARDWARE</a>
      <a href="/methodology/" class="btn-outline">Read the methodology</a>
    </section>
  </main>
</BaseLayout>

<style>
  .top-page {
    padding: 32px 0 56px;
    /* Reserve viewport height while the leaderboard loads client-side —
       prevents the footer from jumping when rows replace the loading
       state (RUM CLS 0.25 on this page). */
    min-height: 100vh;
  }
  .top-page__head {
    margin-bottom: 32px;
  }
  .top-page__title {
    font-family: var(--mono);
    font-weight: 700;
    font-size: clamp(40px, 6vw, 80px);
    line-height: 0.95;
    letter-spacing: -0.04em;
    margin: 16px 0 0 0;
    color: var(--fg);
  }

  /* Filter row */
  .top-page__filters {
    display: flex;
    gap: 4px;
    align-items: center;
    flex-wrap: wrap;
    padding: 12px 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    margin-bottom: 32px;
  }
  .filter-btn {
    background: transparent;
    border: 1px solid var(--line);
    color: var(--fg-2);
    padding: 6px 14px;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s;
  }
  .filter-btn:hover { border-color: var(--accent); color: var(--accent); }
  .filter-btn.is-active {
    border-color: var(--accent);
    color: var(--accent);
    background: rgba(0, 217, 255, 0.06);
  }
  :root[data-accent="orange"] .filter-btn.is-active {
    background: rgba(255, 107, 43, 0.06);
  }
  .filter-meta {
    margin-left: auto;
    font-size: 11px;
    color: var(--fg-3);
    letter-spacing: 0.04em;
  }

  /* Loading state */
  .top-page__loading {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 48px 0;
    font-size: 12px;
    color: var(--fg-3);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .loading-pulse {
    width: 10px; height: 10px;
    background: var(--accent);
    animation: pulse 1.2s ease-in-out infinite;
  }

  .top-page__empty {
    text-align: center;
    padding: 64px 0;
    border: 1px dashed var(--line);
  }

  /* Leaderboard table — horizontal scroll on mobile */
  .leaderboard-table {
    overflow-x: auto;
    border: 1px solid var(--line);
    background: var(--bg-2);
  }
  .leaderboard-table .table {
    min-width: 720px;
  }
  .leaderboard-table .table tbody tr {
    cursor: pointer;
  }
  .leaderboard-table .table tbody tr:hover { background: var(--bg-3); }
  .leaderboard-table .table .gpu-cell    { color: var(--fg-2); max-width: 240px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .leaderboard-table .table .hash-cell   { color: var(--fg-3); }
  .leaderboard-table .table .score-cell  { color: var(--accent); font-weight: 700; font-size: 14px; }
  .leaderboard-table .table .date-cell   { color: var(--fg-3); }

  .leaderboard-meta {
    margin-top: 16px;
    font-size: 11px;
    color: var(--fg-3);
    letter-spacing: 0.04em;
  }

  .top-page__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }

  .top-page__error {
    padding: 32px 0;
  }
</style>

<script>
  const $ = (sel: string) => document.querySelector(sel) as HTMLElement | null;

  const periodLabel = { week: '7 days', month: '30 days', all: 'all time' };
  let currentPeriod: 'week' | 'month' | 'all' = 'week';

  function fmt(n: number) { return Number(n).toLocaleString(); }
  function shortDate(ms: number) {
    // createdAt is stored/returned in milliseconds (Date.now() in submit.ts)
    // — multiplying by 1000 here rendered every date as year ~58492.
    const d = new Date(ms);
    return d.toISOString().slice(2, 10);
  }
  function shortGpu(name: string | null) {
    if (!name) return '—';
    // Strip ANGLE wrapper if cleanup didn't run pre-storage
    return name.replace(/^ANGLE\s*\([^)]+\)/, '').trim().slice(0, 60) || '—';
  }
  function shortCpu(cores: number) {
    return `${cores}-core`;
  }
  /**
   * HTML-escape user-supplied strings before injecting into innerHTML.
   * GPU name comes from user submissions (browser-supplied via WebGL
   * debug-renderer) and could contain attacker-injected HTML if a
   * malicious client spoofed the field. This protects every visitor
   * to /top from a stored XSS.
   */
  function escapeHtml(s: string | null | undefined): string {
    return String(s ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  async function loadPeriod(period: 'week' | 'month' | 'all') {
    currentPeriod = period;
    const labelEl = $('#period-label');
    if (labelEl) labelEl.textContent = periodLabel[period];

    // Update filter button states
    document.querySelectorAll<HTMLButtonElement>('.filter-btn').forEach((btn) => {
      btn.classList.toggle('is-active', btn.dataset.period === period);
    });

    $('#loading')!.removeAttribute('hidden');
    $('#error')!.setAttribute('hidden', '');
    $('#empty')!.setAttribute('hidden', '');
    $('#leaderboard-wrap')!.setAttribute('hidden', '');

    try {
      const res = await fetch(`/api/top?limit=50&period=${period}`);
      if (!res.ok) {
        const errBody = await res.json().catch(() => ({}));
        throw new Error((errBody as any).error || `HTTP ${res.status}`);
      }
      const data = await res.json() as any;
      if (!data.ok) throw new Error(data.error || 'Unknown error');

      const results = data.results || [];
      $('#loading')!.setAttribute('hidden', '');

      // Empty state when period has zero results
      if (results.length === 0) {
        $('#empty')!.removeAttribute('hidden');
        return;
      }

      // Render rows
      const tbody = $('#leaderboard-rows')!;
      tbody.innerHTML = results.map((r: any) => {
        // ID is regex-validated server-side (^[a-f0-9]{8}$) but we
        // re-validate here to be paranoid (defence in depth).
        const safeId = String(r.id || '').replace(/[^a-f0-9]/g, '').slice(0, 8);
        return `
        <tr data-href="/r/${safeId}/">
          <td class="rank-cell">#${String(r.rank).padStart(2, '0')}</td>
          <td class="score-cell tnum">${fmt(r.scores.overall)}</td>
          <td>${shortCpu(r.cpu.cores)}</td>
          <td class="gpu-cell" title="${escapeHtml(r.gpu.name || '')}">${escapeHtml(shortGpu(r.gpu.name))}</td>
          <td class="hash-cell">-${escapeHtml(safeId.slice(0, 6))}-</td>
          <td class="date-cell num tnum">${shortDate(r.createdAt)}</td>
        </tr>`;
      }).join('');

      // Make rows clickable
      tbody.querySelectorAll<HTMLElement>('tr[data-href]').forEach((tr) => {
        tr.addEventListener('click', () => {
          window.location.href = tr.dataset.href!;
        });
      });

      // Meta line
      const total = data.total ?? results.length;
      // The API filters to GPU-measured runs, so this count is not "all
      // submissions" — say which pool it is.
      $('#leaderboard-meta')!.textContent =
        `Showing ${results.length} of ${fmt(total)} GPU-measured runs · period: ${periodLabel[period]}. `
        + `Runs without WebGPU are scored on CPU + RAM only and ranked separately.`;

      // Filter meta on top filter row
      $('#filter-meta')!.textContent = `${fmt(total)} TESTS · LIVE`;

      $('#leaderboard-wrap')!.removeAttribute('hidden');
    } catch (e: any) {
      console.error('top failed', e);
      $('#loading')!.setAttribute('hidden', '');
      $('#error')!.removeAttribute('hidden');
      const msg = $('#error-message');
      if (msg) msg.textContent = e?.message || 'Network error';
    }
  }

  // Wire filter buttons
  document.querySelectorAll<HTMLButtonElement>('.filter-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const period = btn.dataset.period as 'week' | 'month' | 'all';
      if (period && period !== currentPeriod) loadPeriod(period);
    });
  });

  // Initial load
  loadPeriod('week');
</script>
