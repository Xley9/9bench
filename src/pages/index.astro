---
import BaseLayout from '../layouts/BaseLayout.astro';
import IssueNameplate from '../components/bench/IssueNameplate.astro';
import LiveCounter from '../components/bench/LiveCounter.astro';
import TruthDisclaimer from '../components/bench/TruthDisclaimer.astro';

// Stats are loaded client-side from /api/stats. SSR-safe defaults
// here so the layout doesn't shift when the fetch resolves.
// Vendor payments is hard-coded to 0 — by design, not by query.
const initialStats = {
  total_runs: 0,
  gpu_models_seen: 0,
  avg_duration_seconds: 0,
  vendor_payments: 0,
};

const FEATURES = [
  {
    n: '01',
    h: 'No paid bias',
    b: "r/hardware banned UserBenchmark for documented anti-AMD bias. 9bench takes zero money from chip vendors. The scoring formula is on GitHub.",
    pull: 'Zero vendor money.',
  },
  {
    n: '02',
    h: 'No 8 GB download',
    b: 'Geekbench, Cinebench, 3DMark, PassMark all need 500 MB–8 GB and admin rights. Useless on corporate networks, schools, shared computers.',
    pull: '0 MB to test.',
  },
  {
    n: '03',
    h: 'No fake precision',
    b: "We tell you when our number is approximate. RAM is browser-sandboxed. We say so loudly instead of pretending our number is gospel.",
    pull: "We say what we can't measure.",
  },
];
---

<BaseLayout
  title="9bench — Free Browser CPU GPU RAM Benchmark, No Download"
  description="Test your computer's CPU, GPU, and RAM speed in 15 seconds — directly in your browser. WebGPU + WebAssembly powered. No download, no account, no bias. Free alternative to UserBenchmark."
>
  <main class="container landing">

    <IssueNameplate />

    <!-- ── Hero ───────────────────────────────────────────────────── -->
    <section class="hero">
      <div class="hero__col-headline">
        <h1 class="hero__h1">
          Your PC<br />
          in <em>15</em><br />
          seconds.
        </h1>
      </div>
      <div class="hero__col-aside">
        <p class="hero__lede">
          CPU + GPU + RAM, measured in your browser. No download. No login.
          No vendor money. Open methodology — every formula on the page.
        </p>
        <div class="hero__cta-row">
          <a href="/test/" class="run-btn">▶ TEST MY HARDWARE</a>
          <a href="#paste-permalink" class="hero__permalink-link">or paste a permalink</a>
        </div>
        <p class="hero__sub">
          ~15 seconds · No login · Privacy-first · Cyan or Orange — your call (top right).
        </p>
      </div>
    </section>

    <!-- ── Stats row (live) ──────────────────────────────────────── -->
    <section class="stats-row" id="stats-row" data-stats>
      <div class="stat">
        <div class="stat__num tnum" data-stat="total_runs">{initialStats.total_runs.toLocaleString()}</div>
        <div class="stat__label">Runs submitted</div>
      </div>
      <div class="stat">
        <div class="stat__num tnum" data-stat="gpu_models_seen">{initialStats.gpu_models_seen.toLocaleString()}</div>
        <div class="stat__label">GPU models seen</div>
      </div>
      <div class="stat">
        <div class="stat__num tnum" data-stat="avg_duration_seconds">~{initialStats.avg_duration_seconds || '—'}s</div>
        <div class="stat__label">Avg test duration</div>
      </div>
      <div class="stat">
        <div class="stat__num tnum" style="color: var(--accent);">0</div>
        <div class="stat__label">Vendors paid us</div>
      </div>
    </section>

    <!-- ── How it differs (3-column) ──────────────────────────────── -->
    <section class="features">
      <header class="features__head">
        <div class="feature-num">FEATURE / 01</div>
        <h2 class="section-h">The honest one.</h2>
        <p class="features__intro">
          Three things every other benchmark gets wrong, and how 9bench fixes them.
        </p>
      </header>
      <div class="features__grid">
        {FEATURES.map((c, i) => (
          <article class="feature" style={i < 2 ? 'border-right: 1px solid var(--line);' : ''}>
            <div class="feature-num">· {c.n}</div>
            <h3 class="feature-title">{c.h}</h3>
            <p class="feature-body">{c.b}</p>
            <p class="feature-quote">"{c.pull}"</p>
          </article>
        ))}
      </div>
    </section>

    <!-- ── Quote block (Methodology pull-quote) ──────────────────── -->
    <section class="pullquote">
      <blockquote class="pullquote__text">
        <span class="text-accent">"</span>
        Every formula. Every constant. Every weight.
        If you find a flaw, file an issue. We ship the patch the same week.
        <span class="text-accent">"</span>
      </blockquote>
      <div class="pullquote__attr">— METHODOLOGY · v3.1 · APR 2026</div>
    </section>

    <!-- ── Permalink paste box ────────────────────────────────────── -->
    <section class="permalink-section" id="paste-permalink">
      <div class="permalink-section__head">
        <div class="feature-num">JUMP / 02</div>
        <h2 class="section-h">Compare a permalink.</h2>
      </div>
      <form class="permalink-form" id="permalink-form">
        <input
          type="text"
          name="permalink"
          placeholder="9bench.com/r/74aa808d  or  74aa808d"
          aria-label="9bench result permalink or hash"
        />
        <button type="submit" class="btn-outline">Open result →</button>
      </form>
      <p class="permalink-section__hint">
        Paste any 9bench result URL or 8-char hash to view the full breakdown.
      </p>
    </section>

    <!-- ── Truth disclaimer (always visible on Landing for new visitors) ── -->
    <section class="landing-disclaimer">
      <TruthDisclaimer compact />
    </section>

    <!-- ── SEO body content (long-form, AI-citable) ────────────────── -->
    <section class="seo-body">
      <h2 class="section-h" style="margin-top: 96px;">What 9bench measures</h2>
      <p class="seo-body__p">
        9bench is a free, open browser-based hardware benchmark that tests your
        <strong>CPU</strong>, <strong>GPU</strong>, and <strong>RAM</strong> speed in about
        15 seconds — no download, no installation, no account required. The entire benchmark
        runs locally in your browser using <strong>WebGPU compute shaders</strong>,
        <strong>WebAssembly</strong>, <strong>Web Workers</strong>, and the
        <strong>Web Crypto API</strong>.
      </p>
      <h3 class="seo-body__h3">How it differs from UserBenchmark and Geekbench</h3>
      <p class="seo-body__p">
        <a href="https://www.reddit.com/r/pcmasterrace/" rel="external">r/pcmasterrace</a> and
        <a href="https://www.reddit.com/r/hardware/" rel="external">r/hardware</a>
        have banned <em>UserBenchmark.com</em> due to documented anti-AMD bias.
        <em>Geekbench</em>, <em>Cinebench</em>, <em>3DMark</em>, and <em>PassMark</em>
        all require 500MB–8GB downloads and admin rights — unusable in corporate networks,
        schools, and on shared computers. 9bench fills the gap: instant, transparent,
        no install, fair scoring.
      </p>
    </section>
  </main>
</BaseLayout>

<style>
  .landing {
    padding-top: 24px;
    padding-bottom: 56px;
  }

  /* Hero — 3:2 grid on desktop, stacked on mobile */
  .hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    padding: 56px 0 40px;
    align-items: end;
  }
  @media (min-width: 1024px) {
    .hero {
      grid-template-columns: 3fr 2fr;
      gap: 60px;
    }
  }
  .hero__h1 {
    font-family: var(--mono);
    font-weight: 700;
    font-size: clamp(64px, 11vw, 140px);
    line-height: 0.85;
    letter-spacing: -0.055em;
    color: var(--fg);
    margin: 0;
  }
  .hero__h1 em {
    font-style: normal;
    color: var(--accent);
  }
  .hero__col-aside { padding-bottom: 12px; }
  .hero__lede {
    font-family: var(--sans);
    font-size: clamp(15px, 1.5vw, 19px);
    line-height: 1.55;
    color: var(--fg-2);
    margin: 0 0 24px 0;
    max-width: 480px;
  }
  .hero__cta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
    margin-top: 16px;
  }
  .hero__permalink-link {
    font-family: var(--sans);
    font-size: 14px;
    color: var(--fg-2);
    text-decoration: none;
    border-bottom: 1px solid var(--fg-3);
    padding-bottom: 2px;
  }
  .hero__permalink-link:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  .hero__sub {
    margin-top: 16px;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--fg-3);
    letter-spacing: 0.04em;
  }

  /* Stats row — desktop 4-col, mobile 2-col */
  .stats-row {
    margin-top: 24px;
  }

  /* Features section — 1:3 column ratio (label : 3 cards) */
  .features {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    padding: 80px 0;
  }
  @media (min-width: 1024px) {
    .features {
      grid-template-columns: 1fr 3fr;
      gap: 60px;
    }
  }
  .features__head {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .features__intro {
    font-family: var(--sans);
    font-size: 14px;
    line-height: 1.6;
    color: var(--fg-3);
    margin: 0;
  }
  .features__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
  }
  @media (min-width: 768px) {
    .features__grid { grid-template-columns: repeat(3, 1fr); gap: 0; }
    .feature { padding: 0 24px; }
    .feature:first-child { padding-left: 0; }
    .feature:last-child  { padding-right: 0; border-right: none !important; }
  }
  .feature {
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .feature-quote {
    margin: 14px 0 0 0;
    padding-top: 10px;
    border-top: 1px solid var(--line);
  }

  /* Pullquote block */
  .pullquote {
    padding: 56px 0;
    border-top: 1px solid var(--line);
  }
  .pullquote__text {
    font-family: var(--mono);
    font-weight: 700;
    font-size: clamp(24px, 4vw, 48px);
    line-height: 1.05;
    letter-spacing: -0.025em;
    color: var(--fg);
    margin: 0;
    max-width: 1100px;
  }
  .pullquote__attr {
    margin-top: 18px;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--fg-3);
    letter-spacing: 0.08em;
  }

  /* Permalink section */
  .permalink-section {
    padding: 56px 0;
    border-top: 1px solid var(--line);
  }
  .permalink-section__head {
    margin-bottom: 24px;
  }
  .permalink-form {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: stretch;
    max-width: 600px;
  }
  .permalink-form input {
    flex: 1 1 280px;
    min-width: 220px;
  }
  .permalink-section__hint {
    margin-top: 12px;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--fg-3);
  }

  .landing-disclaimer {
    padding: 32px 0 56px;
  }

  /* SEO body */
  .seo-body {
    border-top: 1px solid var(--line);
    padding: 56px 0 0;
    max-width: 720px;
  }
  .seo-body__p {
    font-family: var(--sans);
    font-size: 16px;
    line-height: 1.7;
    color: var(--fg-2);
    margin: 0 0 18px 0;
  }
  .seo-body__p strong { color: var(--fg); font-weight: 600; }
  .seo-body__p em     { color: var(--fg); font-style: normal; }
  .seo-body__h3 {
    font-family: var(--sans);
    font-weight: 700;
    font-size: 22px;
    color: var(--fg);
    margin: 32px 0 14px 0;
  }
</style>

<script>
  // ─── Live stats fetch ────────────────────────────────────────────
  // Replace SSR placeholders with real /api/stats data once mounted.
  // Stats endpoint is fast (single COUNT query); no loading state needed.
  (async function loadStats() {
    try {
      const res = await fetch('/api/stats', { headers: { accept: 'application/json' }});
      if (!res.ok) return;
      const data = await res.json() as Record<string, number>;
      document.querySelectorAll<HTMLElement>('[data-stat]').forEach((el) => {
        const key = el.dataset.stat;
        if (!key) return;
        const v = data[key];
        if (typeof v !== 'number') return;
        if (key === 'avg_duration_seconds') {
          el.textContent = '~' + (v > 0 ? v.toFixed(1) : '—') + 's';
        } else {
          el.textContent = v.toLocaleString();
        }
      });
    } catch {
      // Silent fallback — stats are non-critical, server hiccups are fine
    }
  })();

  // ─── Permalink paste form ────────────────────────────────────────
  // Accepts: full URL ("https://9bench.com/r/74aa808d") or bare hash ("74aa808d").
  // Validates the hash format (8 hex chars) before navigating to prevent
  // malformed redirects.
  document.getElementById('permalink-form')?.addEventListener('submit', (e) => {
    e.preventDefault();
    const input = (e.target as HTMLFormElement).elements.namedItem('permalink') as HTMLInputElement;
    const raw = (input.value || '').trim();
    // Extract trailing 8-char hex if present in URL form
    const match = raw.match(/([0-9a-fA-F]{8})\/?$/);
    if (match) {
      window.location.href = '/r/' + match[1].toLowerCase() + '/';
    } else {
      input.setCustomValidity('Expected an 8-character hex hash like 74aa808d');
      input.reportValidity();
      setTimeout(() => input.setCustomValidity(''), 3000);
    }
  });
</script>
