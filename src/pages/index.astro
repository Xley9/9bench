---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="9bench — Free Browser CPU GPU RAM Benchmark, No Download"
  description="Test your computer's CPU, GPU, and RAM speed in 15 seconds — directly in your browser. WebGPU + WebAssembly powered. No download, no account, no bias. Free alternative to UserBenchmark."
  keywords="browser hardware benchmark, online cpu gpu ram test, free pc benchmark no download, webgpu benchmark, userbenchmark alternative, instant pc speed test, is my computer fast, online geekbench alternative, browser-based benchmark, sha-256 cpu test"
>
  <main class="max-w-3xl mx-auto px-5 py-12">
    <!-- Hero -->
    <header class="text-center mb-12">
      <div class="inline-block px-3 py-1 bg-brand-light/10 text-brand rounded-full text-xs font-bold tracking-wider uppercase mb-4">
        ⚡ Truth Series · Hardware
      </div>
      <h1 class="text-5xl md:text-6xl font-extrabold tracking-tight mb-4">9bench</h1>
      <p class="text-xl text-slate-400 mb-2">The honest browser benchmark.</p>
      <p class="text-base text-slate-500 max-w-xl mx-auto">
        Test your CPU + GPU + RAM in 15 seconds. No download. No bias.
        Runs entirely in your browser via WebGPU + WebAssembly.
      </p>
    </header>

    <!-- Run Button -->
    <div class="text-center mb-12">
      <button id="run-btn" class="run-btn">
        <span id="run-btn-icon">▶</span>
        <span id="run-btn-text">Test my hardware</span>
      </button>
      <p class="text-xs text-slate-500 mt-3">~15 seconds · No login · Privacy-first</p>
    </div>

    <!-- Progress Stages (hidden until test starts) -->
    <div id="progress" hidden>
      <div class="progress-stage" id="stage-gpu">
        <div class="progress-icon">🎮</div>
        <div class="progress-label">GPU compute</div>
        <div class="progress-detail" id="stage-gpu-detail">waiting…</div>
      </div>
      <div class="progress-stage" id="stage-cpu">
        <div class="progress-icon">⚙️</div>
        <div class="progress-label">CPU single + multi-core</div>
        <div class="progress-detail" id="stage-cpu-detail">waiting…</div>
      </div>
      <div class="progress-stage" id="stage-ram">
        <div class="progress-icon">💾</div>
        <div class="progress-label">RAM bandwidth</div>
        <div class="progress-detail" id="stage-ram-detail">waiting…</div>
      </div>
    </div>

    <!-- Result Card -->
    <div id="result" hidden></div>

    <!-- Capability check -->
    <div id="caps" class="mt-12 text-center text-xs text-slate-500"></div>

    <!-- SEO content section — keyword-rich, AI-citable -->
    <section class="mt-20 prose-content max-w-none">
      <h2 class="text-2xl font-bold text-brand mb-4">What 9bench measures</h2>
      <p class="text-slate-300 leading-relaxed mb-4">
        9bench is a free, open browser-based hardware benchmark that tests your
        <strong>CPU</strong>, <strong>GPU</strong>, and <strong>RAM</strong> speed in about 15 seconds — no download,
        no installation, no account required. The entire benchmark runs locally in your browser using
        <strong>WebGPU compute shaders</strong>, <strong>WebAssembly</strong>, <strong>Web Workers</strong>,
        and the <strong>Web Crypto API</strong>.
      </p>

      <h3 class="text-lg font-bold mt-6 mb-2">How it differs from UserBenchmark and Geekbench</h3>
      <p class="text-slate-300 leading-relaxed mb-4">
        <a href="https://www.reddit.com/r/pcmasterrace/" rel="external" class="text-brand hover:underline">r/pcmasterrace</a> and
        <a href="https://www.reddit.com/r/hardware/" rel="external" class="text-brand hover:underline">r/hardware</a> have banned
        <em>UserBenchmark.com</em> due to documented anti-AMD bias. <em>Geekbench</em>, <em>Cinebench</em>, <em>3DMark</em>, and
        <em>PassMark</em> all require 500MB–8GB downloads and admin rights — unusable in corporate networks, schools, and
        on shared computers. 9bench fills the gap: instant, transparent, no install, fair scoring.
      </p>

      <h3 class="text-lg font-bold mt-6 mb-2">What gets tested</h3>
      <ul class="text-slate-300 list-disc list-inside leading-relaxed mb-4 space-y-1">
        <li><strong>GPU compute</strong> — 1024×1024 floating-point matrix multiplication via WebGPU compute shader. Output: GFLOPS.</li>
        <li><strong>CPU single-core</strong> — 200,000 SHA-256 hashes computed serially. Output: hashes/sec + score.</li>
        <li><strong>CPU multi-core</strong> — Same workload across all cores via Web Workers. Output: hashes/sec + speedup efficiency.</li>
        <li><strong>RAM bandwidth</strong> — 256 MB working set tested for sequential read, write, copy, plus random-access latency.</li>
      </ul>

      <h3 class="text-lg font-bold mt-6 mb-2">How to use 9bench</h3>
      <ol class="text-slate-300 list-decimal list-inside leading-relaxed mb-4 space-y-1">
        <li>Open <a href="https://9bench.com/" class="text-brand hover:underline">9bench.com</a> in any modern browser (Chrome 113+, Firefox 147+, Safari 26+, Edge 113+).</li>
        <li>Click <em>"Test my hardware"</em>. The benchmark runs automatically in ~15 seconds.</li>
        <li>Your score, percentile ranking, and detailed component breakdown appear instantly.</li>
        <li>Optionally share your result via permalink, copy link, or tweet.</li>
      </ol>

      <h3 class="text-lg font-bold mt-6 mb-2">Browser compatibility (April 2026)</h3>
      <ul class="text-slate-300 list-disc list-inside leading-relaxed mb-4 space-y-1">
        <li>✅ <strong>Chrome 113+</strong> on Windows, macOS, Linux, Android — full support since 2023</li>
        <li>✅ <strong>Edge 113+</strong> — full support</li>
        <li>✅ <strong>Safari 26+</strong> on macOS Tahoe, iOS 26, iPadOS 26, visionOS 26 — full WebGPU support</li>
        <li>✅ <strong>Firefox 147+</strong> on Windows + macOS Tahoe (ARM64)</li>
      </ul>

      <p class="text-slate-300 leading-relaxed mt-6">
        Read the full <a href="/methodology" class="text-brand hover:underline font-semibold">scoring methodology</a> for every formula and bracket,
        or check the <a href="/faq" class="text-brand hover:underline font-semibold">FAQ</a> for common questions.
        Source code on <a href="https://github.com/atillakuruk/9bench" class="text-brand hover:underline" rel="external">GitHub</a>.
      </p>
    </section>

    <!-- HowTo schema for AEO/GEO -->
    <script slot="head" type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'HowTo',
      name: 'How to test your computer\'s CPU, GPU, and RAM speed in 15 seconds',
      description: 'Use 9bench, a free browser-based hardware benchmark, to measure your CPU, GPU, and RAM performance with no download.',
      totalTime: 'PT15S',
      tool: [{ '@type': 'HowToTool', name: 'Modern web browser (Chrome 113+, Firefox 147+, Safari 26+, Edge 113+)' }],
      step: [
        { '@type': 'HowToStep', position: 1, name: 'Open 9bench.com', text: 'Open https://9bench.com in any modern web browser.' },
        { '@type': 'HowToStep', position: 2, name: 'Click "Test my hardware"', text: 'Click the green "Test my hardware" button to start the benchmark.' },
        { '@type': 'HowToStep', position: 3, name: 'Wait 15 seconds', text: 'The benchmark runs CPU, GPU, and RAM tests automatically in about 15 seconds.' },
        { '@type': 'HowToStep', position: 4, name: 'View your score', text: 'Your overall 9bench score, component breakdown, percentile ranking, and shareable permalink appear instantly.' }
      ]
    })} />

    <!-- Trust footer -->
    <footer class="mt-20 pt-8 border-t border-slate-800 text-center text-xs text-slate-500">
      <nav class="mb-4 flex justify-center gap-6 text-sm">
        <a href="/methodology" class="text-brand hover:underline">Methodology</a>
        <a href="/faq" class="text-brand hover:underline">FAQ</a>
        <a href="https://github.com/atillakuruk/9bench" class="text-brand hover:underline" rel="external">GitHub</a>
      </nav>
      <p class="mb-2">
        9bench is built by <a href="https://toololis.com/atilla/" class="text-brand hover:underline">Atilla Kürük</a> · sister-product of
        <a href="https://toololis.com" class="text-brand hover:underline">Toololis</a>
      </p>
      <p>
        Open methodology · No data leaves your browser unless you submit · No account · No ads
      </p>
    </footer>
  </main>

  <script>
    import { runFullBench, type Stage } from '../bench/runner.ts';

    const runBtn = document.getElementById('run-btn') as HTMLButtonElement;
    const runBtnIcon = document.getElementById('run-btn-icon')!;
    const runBtnText = document.getElementById('run-btn-text')!;
    const progress = document.getElementById('progress')!;
    const result = document.getElementById('result')!;
    const caps = document.getElementById('caps')!;

    // Capability check
    const hasWebGPU = 'gpu' in navigator;
    const hasWebWorkers = 'Worker' in window;
    const hasCrypto = 'crypto' in window && 'subtle' in crypto;
    const cores = navigator.hardwareConcurrency || '?';
    caps.innerHTML = `
      <div class="inline-flex gap-3 flex-wrap justify-center">
        <span>${hasWebGPU ? '✓' : '✗'} WebGPU</span>
        <span>${hasWebWorkers ? '✓' : '✗'} Workers</span>
        <span>${hasCrypto ? '✓' : '✗'} Web Crypto</span>
        <span>${cores} cores reported</span>
      </div>
    `;

    // Rotating status messages per stage — gives impression of multi-step computation
    // Even though the actual bench function is one blocking call, the user sees
    // realistic sub-step feedback every 700ms.
    const STAGE_MESSAGES: Record<string, string[]> = {
      gpu: [
        'Probing WebGPU adapter…',
        'Compiling compute shader…',
        'Allocating 12 MB GPU buffers…',
        'Running matrix multiplication…',
        'Synchronizing GPU pipeline…',
        'Reading back results…',
        'Computing GFLOPS…'
      ],
      cpu: [
        'Warming up CPU caches…',
        'Single-core SHA-256 chain…',
        'Spawning Web Workers…',
        'Parallel SHA-256 across cores…',
        'Measuring multi-core scaling…',
        'Computing efficiency ratio…'
      ],
      ram: [
        'Allocating 256 MB working set…',
        'Sequential read pass…',
        'Sequential write pass…',
        'Memory copy throughput…',
        'Random-access latency probe…',
        'Computing bandwidth…'
      ]
    };

    const stageIntervals: Record<string, number> = {};

    function updateStage(id: string, percent: number, message: string) {
      const stage = document.getElementById('stage-' + id);
      const detail = document.getElementById('stage-' + id + '-detail');
      if (!stage || !detail) return;

      if (percent >= 100) {
        // Stage done — clear cycling, show real result
        stage.classList.add('done');
        stage.classList.remove('active');
        if (stageIntervals[id]) {
          clearInterval(stageIntervals[id]);
          delete stageIntervals[id];
        }
        detail.textContent = message;
      } else {
        // Stage active — start cycling messages
        stage.classList.add('active');
        stage.classList.remove('done');

        const msgs = STAGE_MESSAGES[id] || [message];
        let i = 0;
        detail.textContent = msgs[0];
        if (stageIntervals[id]) clearInterval(stageIntervals[id]);
        stageIntervals[id] = window.setInterval(() => {
          i = (i + 1) % msgs.length;
          if (detail) detail.textContent = msgs[i];
        }, 700);
      }
    }

    // Wake Lock — keep screen on during test (mobile especially)
    let wakeLock: any = null;
    async function requestWakeLock() {
      try {
        if ('wakeLock' in navigator) {
          wakeLock = await (navigator as any).wakeLock.request('screen');
        }
      } catch {}
    }
    async function releaseWakeLock() {
      try { if (wakeLock) { await wakeLock.release(); wakeLock = null; } } catch {}
    }

    runBtn.addEventListener('click', async () => {
      runBtn.disabled = true;
      runBtnIcon.textContent = '⟳';
      runBtnText.textContent = 'Scanning…';
      progress.hidden = false;
      result.hidden = true;
      result.innerHTML = '';

      // Activate global scanning state (scanlines + top status bar)
      document.body.classList.add('scanning');

      await requestWakeLock();

      try {
        const r = await runFullBench((stage, percent, message) => {
          if (stage === 'done') return;
          updateStage(stage, percent, message);
        });

        // Auto-submit to global ranking + get persistent URL
        let submitted: { id?: string; url?: string; percentile?: number; total?: number } = {};
        try {
          const submitRes = await fetch('/api/submit', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({
              scores: r.scores,
              gpu: { gflops: r.gpu.gflops, adapterName: r.hardware.gpu },
              cpu: r.cpu,
              ram: r.ram,
              hardware: r.hardware,
              durationMs: r.durationMs
            })
          });
          if (submitRes.ok) {
            submitted = await submitRes.json() as any;
            // Override local percentile estimate with real one from server
            if (typeof submitted.percentile === 'number') {
              r.verdict.percentileEstimate = submitted.percentile;
            }
          }
        } catch (e) {
          console.warn('Submit failed (offline?):', e);
        }

        // Save to local history (privacy-respecting)
        try {
          const hist = JSON.parse(localStorage.getItem('9bench:history') || '[]');
          hist.push({
            timestamp: Date.now(),
            resultId: submitted.id || null,
            score: r.scores.overall,
            scores: r.scores,
            gpu: r.hardware.gpu,
            cores: r.cpu.cores
          });
          // Keep last 50 entries
          localStorage.setItem('9bench:history', JSON.stringify(hist.slice(-50)));
        } catch {}

        // Render result card
        const fmt = (n: number) => n.toLocaleString();
        const pct = (n: number, max: number) => Math.min(100, Math.round((n / max) * 100));

        result.innerHTML = `
          <div class="result-card">
            <div class="result-header">
              <span>⚡ TRUTH SERIES · HARDWARE</span>
              <span>9bench.com</span>
            </div>
            <div class="result-statement">your 9bench score</div>
            <div class="result-big">${fmt(r.scores.overall)}</div>
            <div class="result-verdict" style="color: ${r.verdict.color}">
              ${r.verdict.label}
            </div>
            <div class="result-snark">${r.verdict.snark}</div>

            <h3 class="text-sm font-bold tracking-wider uppercase text-slate-400 mb-3">Component breakdown</h3>
            <div class="mb-5">
              <div class="score-component">
                <div class="score-component-label">🎮 GPU</div>
                <div class="score-component-bar"><div class="score-component-fill" style="width:${pct(r.scores.gpu, 5000)}%"></div></div>
                <div class="score-component-value">${fmt(r.scores.gpu)}</div>
              </div>
              <div class="score-component">
                <div class="score-component-label">⚙️ CPU·1</div>
                <div class="score-component-bar"><div class="score-component-fill" style="width:${pct(r.scores.cpuSingle, 1500)}%"></div></div>
                <div class="score-component-value">${fmt(r.scores.cpuSingle)}</div>
              </div>
              <div class="score-component">
                <div class="score-component-label">⚙️ CPU·M</div>
                <div class="score-component-bar"><div class="score-component-fill" style="width:${pct(r.scores.cpuMulti, 2500)}%"></div></div>
                <div class="score-component-value">${fmt(r.scores.cpuMulti)}</div>
              </div>
              <div class="score-component">
                <div class="score-component-label">💾 RAM</div>
                <div class="score-component-bar"><div class="score-component-fill" style="width:${pct(r.scores.ram, 1500)}%"></div></div>
                <div class="score-component-value">${fmt(r.scores.ram)}</div>
              </div>
            </div>

            <h3 class="text-sm font-bold tracking-wider uppercase text-slate-400 mb-3">Raw measurements</h3>
            <div class="result-rows">
              <div class="result-row"><span class="result-row-label">GPU</span><span class="result-row-value">${r.hardware.gpu}</span></div>
              <div class="result-row"><span class="result-row-label">GPU compute</span><span class="result-row-value">${r.gpu.gflops.toFixed(1)} GFLOPS</span></div>
              <div class="result-row"><span class="result-row-label">CPU cores</span><span class="result-row-value">${r.cpu.cores}</span></div>
              <div class="result-row"><span class="result-row-label">SHA-256 single</span><span class="result-row-value">${fmt(Math.round(r.cpu.hashesPerSecondSingle))} h/s</span></div>
              <div class="result-row"><span class="result-row-label">SHA-256 multi</span><span class="result-row-value">${fmt(Math.round(r.cpu.hashesPerSecondMulti))} h/s</span></div>
              <div class="result-row"><span class="result-row-label">Multi-core speedup</span><span class="result-row-value">${r.cpu.speedup.toFixed(2)}× (${(r.cpu.efficiency * 100).toFixed(0)}% eff)</span></div>
              <div class="result-row"><span class="result-row-label">RAM read</span><span class="result-row-value">${r.ram.readBandwidthGBs.toFixed(1)} GB/s</span></div>
              <div class="result-row"><span class="result-row-label">RAM write</span><span class="result-row-value">${r.ram.writeBandwidthGBs.toFixed(1)} GB/s</span></div>
              <div class="result-row"><span class="result-row-label">RAM random latency</span><span class="result-row-value">${r.ram.randomAccessLatencyNs.toFixed(1)} ns</span></div>
              <div class="result-row"><span class="result-row-label">Total test time</span><span class="result-row-value">${(r.durationMs / 1000).toFixed(1)} s</span></div>
              <div class="result-row"><span class="result-row-label">${submitted.id ? 'Global percentile' : 'Estimated percentile'}</span><span class="result-row-value">${submitted.id ? `<strong>${submitted.percentile}th</strong> of ${submitted.total!.toLocaleString()} tests` : `~${r.verdict.percentileEstimate}th (estimated)`}</span></div>
              ${submitted.id ? `<div class="result-row"><span class="result-row-label">Permalink</span><span class="result-row-value"><a href="/r/${submitted.id}/" class="text-brand underline">9bench.com/r/${submitted.id}</a></span></div>` : ''}
            </div>

            ${submitted.id ? `
            <div class="reaction-bar">
              <button class="reaction-btn share-action" id="copy-share-link">
                <span class="icon">🔗</span><span>Copy link</span>
              </button>
              <button class="reaction-btn share-action" id="share-twitter">
                <span class="icon">🐦</span><span>Tweet</span>
              </button>
              <button class="reaction-btn share-action" id="share-native" hidden>
                <span class="icon">📲</span><span>Share</span>
              </button>
            </div>
            ` : ''}
            <div class="reaction-bar">
              <button class="reaction-btn" data-reaction="match">
                <span class="icon">❤️</span><span>Matches my experience</span>
              </button>
              <button class="reaction-btn" data-reaction="off">
                <span class="icon">🤔</span><span>Felt off</span>
              </button>
              <button class="reaction-btn" data-reaction="surprised">
                <span class="icon">😮</span><span>Surprised me</span>
              </button>
            </div>

            <div class="disclaimer">
              <strong>Methodology:</strong> Score = geometric mean of GPU·CPU-multi·RAM weighted 35·45·20%.
              Measurements are real but bound by browser overhead (typically 5-15% slower than native).
              Cross-platform comparable. Not a replacement for Geekbench/Cinebench for absolute peak measurement —
              optimized for instant, install-free, honest relative ranking.
            </div>
          </div>
        `;

        // Wire up reaction buttons — submit to backend if we have an ID, else LocalStorage
        result.querySelectorAll('.reaction-btn[data-reaction]').forEach((btn) => {
          btn.addEventListener('click', async () => {
            const reaction = (btn as HTMLElement).dataset.reaction!;
            // Visually mark
            result.querySelectorAll('.reaction-btn[data-reaction]').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            // Send to backend if we have an ID
            if (submitted.id) {
              try {
                await fetch('/api/react', {
                  method: 'POST',
                  headers: { 'content-type': 'application/json' },
                  body: JSON.stringify({ id: submitted.id, reaction })
                });
              } catch {}
            }
            // Always also save locally for personal history
            try {
              const stored = JSON.parse(localStorage.getItem('9bench:reactions') || '[]');
              stored.push({
                reaction,
                resultId: submitted.id,
                score: r.scores.overall,
                gpu: r.hardware.gpu,
                timestamp: Date.now()
              });
              localStorage.setItem('9bench:reactions', JSON.stringify(stored.slice(-50)));
            } catch {}
          });
        });

        // Wire up share actions if we have a result ID
        if (submitted.id) {
          const shareUrl = `https://9bench.com/r/${submitted.id}`;
          const cleanLabel = r.verdict.label.replace(/^[^a-zA-Z]+/, '').trim();
          const shareText = `9bench: ${r.scores.overall.toLocaleString()} (${cleanLabel}) — ${submitted.percentile}th percentile globally.`;

          const copyLink = document.getElementById('copy-share-link');
          if (copyLink) {
            copyLink.addEventListener('click', async () => {
              try {
                await navigator.clipboard.writeText(shareUrl);
                copyLink.classList.add('active');
                const span = copyLink.querySelector('span:last-child')!;
                const orig = span.textContent;
                span.textContent = '✓ Copied';
                setTimeout(() => { span.textContent = orig; copyLink.classList.remove('active'); }, 1500);
              } catch {}
            });
          }
          const tw = document.getElementById('share-twitter');
          if (tw) {
            tw.addEventListener('click', () => {
              const u = `https://twitter.com/intent/tweet?text=${encodeURIComponent(shareText)}&url=${encodeURIComponent(shareUrl)}`;
              window.open(u, '_blank');
            });
          }
          // Native share on mobile if supported
          const nativeBtn = document.getElementById('share-native');
          if (nativeBtn && (navigator as any).share) {
            const isMobile = /Android|iPhone|iPad|iPod|Mobile/i.test(navigator.userAgent);
            if (isMobile) {
              nativeBtn.hidden = false;
              nativeBtn.addEventListener('click', async () => {
                try {
                  await (navigator as any).share({
                    title: '9bench score',
                    text: shareText,
                    url: shareUrl
                  });
                } catch {}
              });
            }
          }
        }

        result.hidden = false;
        result.scrollIntoView({ behavior: 'smooth', block: 'start' });
      } catch (e: any) {
        result.innerHTML = `<div class="result-card"><div class="result-snark" style="border-color:#DC2626">Benchmark failed: ${e?.message || e}</div></div>`;
        result.hidden = false;
      } finally {
        document.body.classList.remove('scanning');
        await releaseWakeLock();
        runBtn.disabled = false;
        runBtnIcon.textContent = '↻';
        runBtnText.textContent = 'Run again';
      }
    });
  </script>
</BaseLayout>
