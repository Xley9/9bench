        <div class="article-card-banner" style={`background: linear-gradient(135deg, ${a.from} 0%, ${a.to} 100%);`}>
          <div class="article-card-emoji">{a.emoji}</div>
          <div class="article-card-cat">{a.category}</div>
        </div>
        <div class="article-card-body">
